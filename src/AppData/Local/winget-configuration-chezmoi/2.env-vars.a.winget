## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  # Persists real, user-scoped Windows environment variables under HKCU\Environment -- separate
  # from the PowerShell/Zsh session variables set by powershell/env.ps1.tmpl and dot_zshenv.tmpl,
  # since those aren't visible to GUI apps or anything else launched outside those shells'
  # profiles. Registry writes here don't broadcast WM_SETTINGCHANGE, so already-running processes
  # (including Explorer, and anything it later launches) won't see a change until the next
  # logoff/logon or reboot.
  #
  # TODO: replace this hand-maintained list with a custom DSC resource module once one exists.
  - type: Microsoft.Windows/Registry
    name: CLAUDECONFIGDIR
    properties:
      keyPath: HKEY_CURRENT_USER\Environment
      valueName: CLAUDE_CONFIG_DIR
      valueData:
        String: "C:\\Users\\nate\\.config\\claude"
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DOCKERCONFIGDIR
    properties:
      keyPath: HKEY_CURRENT_USER\Environment
      valueName: DOCKER_CONFIG
      valueData:
        String: "C:\\Users\\nate\\.config\\docker"
      _exist: true
