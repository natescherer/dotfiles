## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.PowerToys/AppSettings
    name: PowerToysDisableElevatedAppWarnings
    properties:
      settings:
        enable_warnings_elevated_apps: false
  # Writes HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Search\SearchboxTaskbarMode -- confirmed
  # by hand this is a per-user key, no elevation needed.
  - type: Microsoft.Windows.Developer/Taskbar
    name: Taskbar
    properties:
      SearchBoxMode: Hide
      RestartExplorer: True
  # Writes HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced (HideFileExt, Hidden) --
  # confirmed by hand this is a per-user key, no elevation needed.
  - type: Microsoft.Windows.Developer/WindowsExplorer
    name: WindowsExplorer
    properties:
      FileExtensions: Show
      HiddenFiles: Show
      RestartExplorer: True
  - type: Microsoft.Windows.Settings/WindowsSettings
    name: WindowsSettings
    properties:
      AppColorMode: Dark
      SystemColorMode: Dark
      TaskbarAlignment: Left
  - type: Microsoft.Windows/Registry
    name: DisableAppLaunchTracking
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: Start_TrackProgs
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableBingSearchInStart
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search
      valueName: BingSearchEnabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableDiagnosticDataForTailoredExperiences
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Privacy
      valueName: TailoredExperiencesWithDiagnosticDataEnabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableEnhancePointerPrecisionMouseSpeed
    properties:
      keyPath: HKEY_CURRENT_USER\Control Panel\Mouse
      valueName: MouseSpeed
      valueData:
        String: "0"
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableEnhancePointerPrecisionMouseThreshold1
    properties:
      keyPath: HKEY_CURRENT_USER\Control Panel\Mouse
      valueName: MouseThreshold1
      valueData:
        String: "0"
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableEnhancePointerPrecisionMouseThreshold2
    properties:
      keyPath: HKEY_CURRENT_USER\Control Panel\Mouse
      valueName: MouseThreshold2
      valueData:
        String: "0"
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableFeedbackPromptsNumberOfSIUFInPeriod
    properties:
      keyPath: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Siuf\Rules
      valueName: NumberOfSIUFInPeriod
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableFeedbackPromptsPeriodInNanoSeconds
    properties:
      keyPath: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Siuf\Rules
      valueName: PeriodInNanoSeconds
      _exist: false
  - type: Microsoft.Windows/Registry
    name: DisableFunFactsInStartMenuRotatingLockScreenOverlay
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: RotatingLockScreenOverlayEnabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableFunFactsInStartMenuSubscribedContent338387
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-338387Enabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableImproveInkingAndTyping
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Input\TIPC
      valueName: Enabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableInkingTypingDictionaryContactHarvesting
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization\TrainedDataStore
      valueName: HarvestContacts
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableInkingTypingDictionaryImplicitInkCollection
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization
      valueName: RestrictImplicitInkCollection
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableInkingTypingDictionaryImplicitTextCollection
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization
      valueName: RestrictImplicitTextCollection
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableInkingTypingDictionaryPrivacyPolicy
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Personalization\Settings
      valueName: AcceptedPrivacyPolicy
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableInkingTypingDictionaryToggle
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CPSS\Store\InkingAndTypingPersonalization
      valueName: Value
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableOptionalDiagnosticDataShowedToastAtLevel
    properties:
      keyPath: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Diagnostics\DiagTrack
      valueName: ShowedToastAtLevel
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableRecentFilesInStartMenu
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: Start_TrackDocs
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableRecommendationsInStartMenu
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: Start_IrisRecommendations
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableSettingsSuggestedContent338393
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-338393Enabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableSettingsSuggestedContent353694
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-353694Enabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableSettingsSuggestedContent353696
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-353696Enabled
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableWebsiteLanguageAccess
    properties:
      keyPath: HKEY_CURRENT_USER\Control Panel\International\User Profile
      valueName: HttpAcceptLanguageOptOut
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: EnableClipboardHistory
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Clipboard
      valueName: EnableClipboardHistory
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: ExplorerFullPathInTitleBar
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\CabinetState
      valueName: FullPath
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: GitCodeFolders
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: NavPaneShowVersionControl
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: StickyKeys
    properties:
      keyPath: HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys
      valueName: Flags
      valueData:
        String: "504"
      _exist: true
  - type: Microsoft.Windows/Registry
    name: TaskbarEndTask
    properties:
      keyPath: HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: TaskbarEndTask
      valueData:
        DWord: 1
      _exist: true
