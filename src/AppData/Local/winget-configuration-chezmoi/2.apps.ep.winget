## WARNING: This file is chezmoi-managed and should not be manually edited!

# There are some non-elevated apps in here, but I'm never going to have a personal computer where I
# don't have admin rights, so there's no reason to split this into two files.

# Microsoft 365 is deliberately NOT installed here via Microsoft.WinGet/Package. The winget-pkgs
# manifest pins a SHA256 against officecdn.microsoft.com's setup.exe, which Microsoft rotates
# independently of the manifest, so installs intermittently fail with "Package hash verification
# failed" until the manifest catches up. It's installed instead by
# .chezmoiscripts/40-windows/run_onchange_after_office-install.ps1, which drives the Office
# Deployment Tool directly against that same setup.exe with no hash pinned against it.

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.WinGet/Package
    name: 1Password
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: AgileBits.1Password
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: 1PasswordCLI
    properties:
      id: AgileBits.1Password.CLI
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: AdobeCreativeCloud
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Adobe.CreativeCloud
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: AppleMusic
    properties:
      id: 9PFHDD62MXS1
      source: msstore
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: AppleTV
    properties:
      id: 9NM4T8B9JQZ1
      source: msstore
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: Claude
    properties:
      id: Anthropic.Claude
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: DockerDesktop
