## WARNING: This file is chezmoi-managed and should not be manually edited!

# It's fine to install these features at the same time as the requirements, as OptionalFeatureList and FeatureOnDemandList are included in DSCv3.2.0+
# Features take a LONG time to install so it's probably good to get out of the way at first anyway

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.Windows/OptionalFeatureList
    name: WindowsOptionalFeatures
    metadata:
      winget:
        securityContext: elevated
    properties:
      features:
        - featureName: NetFx3
          state: Installed
        - featureName: SimpleTCP
          state: Installed
        - featureName: TelnetClient
          state: Installed
        - featureName: TFTP
          state: Installed
        - featureName: VirtualMachinePlatform # For WSL2
          state: Installed
