## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.Windows/OptionalFeatureList
    name: WindowsOptionalFeatures
    metadata:
      winget:
        securityContext: elevated
    properties:
      features:
        - featureName: Containers
          state: Installed
        - featureName: HypervisorPlatform
          state: Installed
        - featureName: Containers-DisposableClientVM
          state: Installed
