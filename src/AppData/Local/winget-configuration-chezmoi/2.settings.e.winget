## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.Windows.Settings/WindowsSettings
    name: WindowsSettingsDeveloperMode
    metadata:
      winget:
        securityContext: elevated
    properties:
      DeveloperMode: true
  - type: Microsoft.Windows/Registry
    name: DisableWeatherAndMoreOnLockScreen
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System
      valueName: DisableLockScreenAppNotifications
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableOptionalDiagnosticDataAllowTelemetry
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection
      valueName: AllowTelemetry
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableOptionalDiagnosticDataMaxTelemetryAllowed
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection
      valueName: MaxTelemetryAllowed
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: EnableUpdatesForOtherMicrosoftProducts
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
      valueName: AllowMUUpdateService
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: Sudo
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo
      valueName: Enabled
      valueData:
        DWord: 3
      _exist: true
  - type: Microsoft.Windows/Registry
    name: LongPaths
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem
      valueName: LongPathsEnabled
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: EdgeNewTab
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
      valueName: NewTabPageLocation
      valueData:
        String: about:blank
      _exist: true
  - type: Microsoft.Windows/Registry
    name: EdgeOOBE
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
      valueName: HideFirstRunExperience
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: WidgetServiceOff
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Dsh
      valueName: AllowNewsAndInterests
      valueData:
        DWord: 0
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableOneDrive
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\OneDrive
      valueName: DisableFileSyncNGSC
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableWindowsBackupNotifications
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsBackup
      valueName: DisableMonitoring
      valueData:
        DWord: 1
      _exist: true
  # HKLM:\SOFTWARE\Policies\* is locked down against unelevated writes (same reasoning as
  # TaskbarStartLayoutFile in 3.taskbarpins.e.winget), so this one-time pointer setup needs to be
  # elevated even though the file it points at is written unelevated. The actual XML content at
  # this path is written by run_after_windows-default-app-associations.ps1.tmpl (unelevated, runs
  # on every `chezmoi apply`) -- see .chezmoidata/windows-default-app-associations.toml for why
  # this indirection (Microsoft's own DefaultAssociationsConfiguration mechanism) replaced a
  # direct UserChoice write. ExpandString (not a literal path) so this isn't tied to this specific
  # user profile -- Windows expands %LOCALAPPDATA% per-user at each sign-in.
  - type: Microsoft.Windows/Registry
    name: DefaultAssociationsConfigurationFile
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System
      valueName: DefaultAssociationsConfiguration
      valueData:
        ExpandString: "%LOCALAPPDATA%\\WindowsWorkstationDSC\\DefaultAppAssociations.xml"
      _exist: true
