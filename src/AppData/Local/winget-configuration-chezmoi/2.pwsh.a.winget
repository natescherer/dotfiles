## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyPwsh
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyWindowsPowerShell
    properties:
      executable: powershell
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  # Persists PSGallery as trusted (Set-PSResourceRepository -Trusted, saved to the
  # PSResourceRepository store) for every later file's Microsoft.PowerShell.PSResourceGet/PSResourceList
  # resources that don't set trustedRepository inline themselves -- e.g. BurntToast in
  # 3.taskbarpins.e.winget. WindowsDscModules in 1.requirements.a.winget runs before this file, so
  # it sets trustedRepository: true on itself instead of depending on this.
  - type: Microsoft.PowerShell.PSResourceGet/Repository
    name: TrustPSGallery
    properties:
      name: PSGallery
      trusted: true
