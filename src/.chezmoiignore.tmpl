{{- if eq .isPersonal false }}
# Personal Configuration
.config/1Password/**
AppData/Local/1Password/**
git/gh/**
## Skip winget configuration tagged as personal
AppData/Local/winget-configuration-chezmoi/*.{p,ep}.winget*
.chezmoiscripts/41-windows/run_onchange_after_pwa-install.ps1.tmpl
{{- end }}

{{- if eq .adminRights false }}
# Skip winget configuration tagged as needed elevation
AppData/Local/winget-configuration-chezmoi/*.{e,ep}.winget*
{{- end }}

{{- if ne .computerModel "Late 2025 Gaming Desktop" }}
AppData/Local/winget-configuration-chezmoi/*late2025gamingdesktop.*.winget*
{{- end }}

{{- if eq .applyOSConfig false }}
{{- if eq .chezmoi.os "windows" }}
# Skip applying WinGet Configuration files
.chezmoiscripts/40-windows/run_onchange_after_winget-configure.ps1.tmpl
# Skip installing PWAs (depends on WinGet Configuration having run)
.chezmoiscripts/41-windows/run_onchange_after_pwa-install.ps1.tmpl
# Skip the setup checklist (depends on Zettlr having been installed by WinGet Configuration)
.chezmoiscripts/49-windows/run_after_setup-checklist.ps1.tmpl
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
# Skip applying Ansible playbook
.chezmoiscripts/30-macos/run_onchange_after_ansible-configure.sh.tmpl
# Skip installing macOS configuration profiles
.chezmoiscripts/30-macos/run_onchange_profiles-importer.sh.tmpl
# Skip the setup checklist (depends on Zettlr having been installed by the Ansible playbook)
.chezmoiscripts/39-macos/run_after_setup-checklist.sh.tmpl
{{- end }}
{{- end }}
