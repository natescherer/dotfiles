#Requires -Version 7.0

# Sets per-user default URL protocol-handler associations (e.g. the default browser) declared in
# .chezmoidata/windows-protocol-associations.toml.
# Plain run_after_ (not run_once_/run_onchange_) so it self-heals every apply -- if an app update
# or reinstall resets an association, or a new entry gets added to the data file, this notices and
# re-applies it -- but each entry's own current-vs-desired check makes that a cheap no-op on the
# common case where nothing has changed.
#
# Depends on run_onchange_after_winget-configure.ps1.tmpl (installs the apps referenced below) in
# 40-windows/ -- sorts before this script and so already ran earlier in this same `chezmoi apply`.
# Also depends on AppData/Local/WindowsWorkstationDSC/Set-ProtocolAssoc.ps1, a regular
# chezmoi-managed file (not a script) guaranteed already on disk by the time any run_after_ script
# executes -- see https://www.chezmoi.io/reference/application-order/ -- same reasoning as
# run_after_desktop-icons.ps1's dependency on desktop-icons.ps1 at the same stable path.

# .chezmoidata files can't be templated -- data has to be loaded before the template engine has
# anything to execute templates with (see https://github.com/twpayne/chezmoi/issues/3526, still
# open) -- so the full chezmoi variable map is embedded below and read once this script actually
# runs, same trick run_onchange_after_windows-ini-patches.ps1.tmpl uses.
#
# get (not plain dot access) tolerates a missing windows_protocol_associations key -- chezmoi's
# strict template mode errors on plain dot access into a map that doesn't have the key, which a
# stripped-down/empty data file would trigger.
$AssociationsJson = @'
{{ get . "windows_protocol_associations" | default (list) | toJson }}
'@
$Associations = $AssociationsJson | ConvertFrom-Json

if (-not $Associations) {
  exit 0
}

# An app's installer registers a Capabilities\URLAssociations key under RegisteredApplications
# listing the ProgId it wants for each protocol it can handle -- resolving it this way avoids
# hardcoding a ProgId string that could drift between app versions/updates.
function Get-AppProgId {
  param([string]$Protocol, [string]$AppNameMatch)
  $RegisteredApps = Get-ItemProperty -Path 'HKLM:\SOFTWARE\RegisteredApplications' -ErrorAction SilentlyContinue
  if (-not $RegisteredApps) { return $null }
  $Entry = $RegisteredApps.PSObject.Properties | Where-Object { $_.Name -match $AppNameMatch } | Select-Object -First 1
  if (-not $Entry) { return $null }
  $CapabilitiesPath = "HKLM:\$($Entry.Value.TrimStart('\'))\URLAssociations"
  return (Get-ItemProperty -Path $CapabilitiesPath -Name $Protocol -ErrorAction SilentlyContinue).$Protocol
}

$SetProtocolAssocScript = Join-Path $env:LOCALAPPDATA 'WindowsWorkstationDSC\Set-ProtocolAssoc.ps1'
$AnyChanged = $false

foreach ($Association in $Associations) {
  $Protocol = $Association.protocol
  $AppNameMatch = $Association.appNameMatch

  $ProgId = Get-AppProgId -Protocol $Protocol -AppNameMatch $AppNameMatch
  if (-not $ProgId) {
    Write-Host "Warning: could not resolve a registered ProgId for $Protocol matching app `"$AppNameMatch`" -- skipping. Set it manually via Settings > Apps > Default Apps." -ForegroundColor Yellow
    continue
  }

  $CurrentProgId = (Get-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Associations\UrlAssociations\$Protocol\UserChoice" -Name 'ProgId' -ErrorAction SilentlyContinue).ProgId
  if ($CurrentProgId -eq $ProgId) {
    continue
  }

  if (-not $AnyChanged) {
    Write-Host "`nSetting Windows protocol associations..." -ForegroundColor Green
  }
  Write-Host "Setting default app for $Protocol (matching `"$AppNameMatch`")..." -ForegroundColor Cyan
  & $SetProtocolAssocScript -Protocol $Protocol -ProgID $ProgId
  $AnyChanged = $true
}

exit 0
