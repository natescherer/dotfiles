# This script applies the WinGet Configuration files that declaratively configure this Windows machine.

# {{ $wingetConfigSourceDir := joinPath .chezmoi.sourceDir "dot_config/windows" }}
# {{/* glob's match order isn't guaranteed, so sort explicitly. Doesn't need to encode apply order
#      (that's the runtime $ConfigFiles discovery's job, mirroring this) -- just needs to be stable
#      so the hash-comment block below doesn't reorder itself (and thus falsely appear "changed")
#      between renders of otherwise-identical content. */}}
# {{ $wingetConfigFiles := joinPath $wingetConfigSourceDir "*.configuration.winget" | glob | sortAlpha }}

# The hashes below ensure this script reruns whenever any of the source files change. Generated
# automatically from whatever *.configuration.winget files currently exist in dot_config/windows/
# -- see $ConfigFiles further down for the matching runtime discovery.
# {{/* The whole range/end block is squeezed onto this one physical line, with literal "\n"s
#      injected in place of real line breaks, specifically so the leading "#" comments out the
#      ENTIRE construct as one line as far as a PowerShell parser is concerned -- a linter sees
#      one (very long) comment line instead of choking on a bare "{{ end }}" token, which it
#      otherwise parses as the reserved `end` block keyword with no statement block following it.
#      A multi-line range/end can't be commented this way: text placed directly before {{ end }}
#      on its own line becomes part of the loop body (repeats every iteration) rather than
#      rendering once, since trim markers only consume whitespace, never the characters added --
#      confirmed the hard way. */}}
# {{ "\n" }}{{ range $wingetConfigFiles }}## {{ base . }} hash: {{ include . | sha256sum }}{{ "\n" }}{{ end -}}
## optional-features-list.ps1 hash: {{ joinPath $wingetConfigSourceDir "optional-features-list.ps1" | include | sha256sum }}

# Windows PowerShell 5.1 defaults [Console]::OutputEncoding to the ANSI code page (1252 on
# en-US), not UTF-8. winget writes UTF-8 (emoji like the elevation shield, spinner glyphs,
# smart quotes), so once that output is piped through a PowerShell cmdlet -- which every winget
# call below is, via Tee-Object/Add-Content for logging -- it gets decoded under the wrong
# codepage and comes out as mojibake before we ever touch it. Match winget's actual encoding up
# front. Safe no-op on pwsh 7 (already defaults to UTF-8) and on hosts that reject the
# assignment (e.g. some CI agents with redirected stdout) -- not worth failing the script over.
try {
  $Utf8NoBom = [System.Text.UTF8Encoding]::new($false)
  [Console]::OutputEncoding = $Utf8NoBom
  $OutputEncoding = $Utf8NoBom
} catch {
  Write-Verbose "Could not force UTF-8 console encoding: $($_.Exception.Message)"
}

# Every *.configuration.winget file in this directory is applied automatically -- no wrapper-script
# edit needed to add a new one. $ConfigFiles below discovers them at runtime and applies them in
# alphabetical order, which is correct by construction: _requirements.configuration.winget is the
# ONLY file any other file depends on (settings.configuration.winget's resources need PowerShell
# modules it installs), and a leading underscore (0x5F) sorts before every other filename here (all
# lowercase, 0x61+). Every other file is independent of every other file, so their relative order
# doesn't matter. If a genuinely new ordering dependency ever appears between two OTHER files
# (not involving _requirements), this discovery approach can't express it -- that would need
# either folding into _requirements-style isolation again, or an explicit dependsOn-style
# mechanism added here.
#
# Note on update cadence: apps.configuration.winget deliberately has no `useLatest: true`
# anywhere -- each package resource only asserts "is this installed at all," not "is it current."
# This file is a one-time provisioning baseline, not a continuous update mechanism, and this
# script only reruns when one of these files' content changes (chezmoi's onchange semantics)
# anyway. Ongoing app updates are UniGetUI's job.
#
# This whole script reruns whenever ANY ONE of these files changes (chezmoi's onchange semantics
# key off the script's own rendered content, which embeds every file's hash above) -- but winget
# configure has real per-invocation overhead, so re-applying every file just because one changed
# would be wasteful. The main loop below skips files whose content hasn't changed since their own
# last successful-enough apply, tracked via a "<file>.chezmoi-hash" sidecar written next to each
# deployed file (see Test-ConfigFileChanged/Set-ConfigFileAppliedHash below) -- so editing just
# fonts.configuration.winget, for example, only reapplies that one file. Editing this script's
# own body (e.g. to change this logic) changes its rendered content too, which forces one
# guaranteed full run on every machine -- exactly the run that seeds every sidecar for the first
# time, so fresh and long-lived machines behave identically on that first run, then diverge to
# incremental thereafter.
$ConfigDir = Join-Path $HOME ".config" "windows"
$ConfigFiles = (Get-ChildItem -Path $ConfigDir -Filter "*.configuration.winget" -File | Sort-Object Name).Name

# winget configure's exit code isn't a reliable success signal (see below), and this script runs
# unattended via chezmoi apply, so full output is captured here rather than only streamed to the
# console -- otherwise a real failure has no record once the terminal that ran chezmoi apply closes.
$LogDir = Join-Path $env:LOCALAPPDATA "chezmoi"
New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
$LogPath = Join-Path $LogDir "winget-configure.log"
"Run started $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" | Set-Content -Path $LogPath

# Retry with exponential backoff to ride out transient network blips. Each attempt's output is
# logged, not just the final outcome. Defined up top so it's available to every winget call below,
# not just the main config-apply loop.
function Invoke-WithRetry {
  param(
    [Parameter(Mandatory)] [scriptblock] $ScriptBlock,
    [string] $Name = "operation",
    [int] $MaxAttempts = 3,
    [int] $InitialDelaySeconds = 5
  )
  $Attempt = 0
  $Delay = $InitialDelaySeconds
  while ($true) {
    $Attempt++
    "[retry] ${Name}: attempt $Attempt/$MaxAttempts" | Add-Content -Path $LogPath
    & $ScriptBlock
    if ($LASTEXITCODE -eq 0 -or $Attempt -ge $MaxAttempts) {
      return
    }
    Write-Host "$Name failed (exit code $LASTEXITCODE), retrying in ${Delay}s (attempt $Attempt/$MaxAttempts)...`n" -ForegroundColor DarkYellow
    "[retry] ${Name}: attempt $Attempt failed with exit code $LASTEXITCODE, retrying in ${Delay}s" | Add-Content -Path $LogPath
    Start-Sleep -Seconds $Delay
    $Delay = $Delay * 2
  }
}

# Per-file change tracking: a sidecar "<file>.chezmoi-hash" written next to each deployed .winget
# file records the hash winget configure was last run against, so the main loop below can skip
# files that haven't changed since their last successful-enough apply -- see that loop for why
# this matters (this script reruns in full whenever ANY tracked file changes, so without this,
# editing just one file still reapplies all of them). Same sidecar-hash convention already used by
# run_onchange_after_vscode-profiles.py.tmpl for VS Code settings.json drift detection.
function Get-ConfigFileHash {
  param([string] $Path)
  if (-not (Test-Path $Path)) { return $null }
  return (Get-FileHash -Path $Path -Algorithm SHA256).Hash
}

function Test-ConfigFileChanged {
  param([string] $Path)
  $HashPath = "$Path.chezmoi-hash"
  if (-not (Test-Path $HashPath)) { return $true }
  $Last = (Get-Content -Path $HashPath -Raw).Trim()
  return (Get-ConfigFileHash -Path $Path) -ne $Last
}

function Set-ConfigFileAppliedHash {
  param([string] $Path)
  $Hash = Get-ConfigFileHash -Path $Path
  if ($null -ne $Hash) {
    Set-Content -Path "$Path.chezmoi-hash" -Value $Hash -NoNewline
  }
}

# Cheap system-state snapshot at the top of the log -- makes the log useful for
# after-the-fact troubleshooting weeks from now, when there's no memory of what
# state the machine was in.
try {
  $Os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
  $OsInfo = "$($Os.Caption) $($Os.Version) build $($Os.BuildNumber)"
} catch {
  $OsInfo = "(unavailable)"
}
try {
  $DiskFreeGB = [math]::Round((Get-PSDrive -Name C -ErrorAction Stop).Free / 1GB, 2)
} catch {
  $DiskFreeGB = "(unavailable)"
}
"Preflight: OS=$OsInfo | PowerShell=$($PSVersionTable.PSVersion) | winget=$((winget --version) 2>$null) | DiskFreeGB(C)=$DiskFreeGB" | Add-Content -Path $LogPath

# Stop-the-world check: if winget configure is disabled by Group Policy, nothing
# below can work. Fail loudly rather than warn -- as a run_onchange script, chezmoi
# only marks this complete on a zero exit, so throwing here means chezmoi retries
# on the next `chezmoi apply` even if none of the source files changed, and this
# self-corrects once the policy is fixed without needing to touch the repo.
$PolicyPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppInstaller'
$PolicyValue = (Get-ItemProperty -Path $PolicyPath -Name 'EnableWindowsPackageManagerConfiguration' -ErrorAction SilentlyContinue).EnableWindowsPackageManagerConfiguration
if ($null -ne $PolicyValue -and [int]$PolicyValue -eq 0) {
  throw "winget configure is disabled by Group Policy ($PolicyPath\EnableWindowsPackageManagerConfiguration = 0). This is the 'Enable Windows Package Manager Configuration' ADMX policy (Computer Configuration > Administrative Templates > Windows Components > App Installer). Fix the policy, then rerun."
}

# On a fresh machine, winget's `configure` subcommand refuses to run at all until its extended
# features flag is turned on -- every winget configure call below fails outright with "Extended
# features are not enabled" until this has run once. `winget configure --enable` is idempotent
# (a safe no-op when already enabled), so just run it unconditionally rather than trying to detect
# the flag's state first -- there's no single reliable settings.json/registry check for it across
# winget versions. Not gated on exit code: winget's own docs note some builds return non-zero even
# when the flag was already enabled, so a bad exit code here isn't trustworthy either way -- if
# enabling it genuinely failed, the config-apply loop below will fail too and get logged there.
Write-Host "Ensuring winget configure extended features are enabled...`n" -ForegroundColor Cyan
"=== winget configure --enable ===" | Add-Content -Path $LogPath
winget configure --enable 2>&1 |
  Tee-Object -FilePath $LogPath -Append

# winget configure depends on the VC++ 2015+ x64 redistributable when invoked from
# a non-elevated environment, and fails with an opaque internal error without it.
# Self-heal by installing it directly rather than just diagnosing the gap.
$VCRedistKey = 'HKLM:\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64'
$VCRedistInstalled = (Get-ItemProperty -Path $VCRedistKey -Name 'Installed' -ErrorAction SilentlyContinue).Installed -eq 1
if (-not $VCRedistInstalled) {
  Write-Host "Microsoft Visual C++ Redistributable 2015+ (x64) not found -- installing (winget configure can fail with an internal error without it)...`n" -ForegroundColor Yellow
  "=== Installing Microsoft.VCRedist.2015+.x64 ===" | Add-Content -Path $LogPath
  Invoke-WithRetry -Name 'Microsoft.VCRedist.2015+.x64 install' -ScriptBlock {
    winget install --id 'Microsoft.VCRedist.2015+.x64' --source winget --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1 |
      Tee-Object -FilePath $LogPath -Append
  }
  if ($LASTEXITCODE -ne 0) {
    throw "Failed to install Microsoft.VCRedist.2015+.x64 (exit code $LASTEXITCODE) -- winget configure is likely to fail without it. See $LogPath and rerun."
  }
}

# _requirements.configuration.winget's WindowsDscModules resource needs
# Microsoft.PowerShell.PSResourceGet/PSResourceList, which only exists starting in PSResourceGet
# 1.3.0-preview1. Installed here directly (plain PowerShell, not a winget configure resource)
# rather than as a RunCommandOnSet resource in a .winget file -- tried that twice and it didn't
# hold up: (1) bootstrapping it via a resource in the SAME file as WindowsDscModules doesn't work,
# since winget's dscv3 processor resolves every resource type in a document up front, before
# executing any resource's Set; and (2) moving it to its own separate winget configure invocation
# (a dedicated 1-init.configuration.winget) didn't reliably work either. Installing it directly
# here, in this script's own process, sidesteps winget's resource resolution entirely.
$PSResourceGetOk = Get-PSResource -Name Microsoft.PowerShell.PSResourceGet -ErrorAction SilentlyContinue |
  Where-Object { $_.Version -ge [version]'1.3.0' }
if (-not $PSResourceGetOk) {
  Write-Host "Installing PSResourceGet 1.3.0+ preview (required by _requirements.configuration.winget)...`n" -ForegroundColor Cyan
  "=== Installing Microsoft.PowerShell.PSResourceGet (prerelease) ===" | Add-Content -Path $LogPath
  try {
    Install-PSResource -Name Microsoft.PowerShell.PSResourceGet -Prerelease -TrustRepository -Scope CurrentUser -ErrorAction Stop *>&1 |
      Add-Content -Path $LogPath
  } catch {
    "PSResourceGet install threw: $($_.Exception.Message)" | Add-Content -Path $LogPath
  }
  $PSResourceGetOk = Get-PSResource -Name Microsoft.PowerShell.PSResourceGet -ErrorAction SilentlyContinue |
    Where-Object { $_.Version -ge [version]'1.3.0' }
  if (-not $PSResourceGetOk) {
    Write-Host "Warning: failed to install PSResourceGet 1.3.0+ preview -- _requirements.configuration.winget's WindowsDscModules resource will likely fail. See $LogPath`n" -ForegroundColor Yellow
  } else {
    "=== PSResourceGet install verified: $($PSResourceGetOk.Version) $($PSResourceGetOk.Prerelease) ===" | Add-Content -Path $LogPath
    # winget configure runs through WindowsPackageManagerServer, an out-of-process COM server that
    # stays resident across invocations rather than restarting fresh each time (confirmed: a real
    # instance on a dev machine had been running for over a week). It resolves PowerShell-module-based
    # DSC resources once and keeps that resolution cached for its own lifetime, so an already-running
    # instance from before this install still won't see the module we just installed --
    # _requirements.configuration.winget's WindowsDscModules resource would then fail with "Resource
    # not found" even though the module is verifiably on disk (confirmed empirically). Killing the
    # server here forces a fresh instance (spawned automatically on the next winget configure call)
    # that re-resolves resources from the current on-disk state.
    Get-Process -Name WindowsPackageManagerServer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    "=== restarted WindowsPackageManagerServer after installing PSResourceGet ===" | Add-Content -Path $LogPath
  }
}

# Bug https://github.com/microsoft/winget-cli/issues/6091 currently prevents winget configure
# from installing Microsoft Store apps for the first time. This is a dirty workaround until
# that bug is fixed that pre-installs every Store app and accepts the agreement
$AppsConfigPath = Join-Path $ConfigDir "apps.configuration.winget"
if (Test-Path $AppsConfigPath) {
  # This whole block only matters when apps.configuration.winget itself changed -- skip it
  # entirely otherwise, same reasoning as the per-file skip check in the main loop below.
  if (-not (Test-ConfigFileChanged -Path $AppsConfigPath)) {
    "=== apps.configuration.winget unchanged, skipping msstore pre-install pass ===" | Add-Content -Path $LogPath
  } else {
    $MsstoreIds = [System.Collections.Generic.List[string]]::new()
    $PendingId = $null
    foreach ($Line in Get-Content -Path $AppsConfigPath) {
      if ($Line -match '^\s*id:\s*(\S+)\s*$') {
        $PendingId = $Matches[1]
      } elseif ($Line -match '^\s*source:\s*msstore\s*$' -and $PendingId) {
        $MsstoreIds.Add($PendingId)
        $PendingId = $null
      }
    }
    foreach ($Id in $MsstoreIds) {
      # Some Store apps come pre-provisioned on Windows out of the box, and on a rerun every one of
      # these is already installed from the previous apply -- winget install then fails with
      # 0x8A15002B (APPINSTALLER_CLI_ERROR_UPDATE_NOT_APPLICABLE, "no applicable update found") since
      # it's effectively an upgrade check against an already-current package, not a real failure.
      # Checking install state first and skipping silently avoids 3 retries per already-installed app.
      winget list --id $Id -e --accept-source-agreements 2>&1 | Add-Content -Path $LogPath
      if ($LASTEXITCODE -eq 0) {
        "=== $Id already installed, skipping pre-install ===" | Add-Content -Path $LogPath
        continue
      }
      Write-Host "Pre-installing Store app $Id...`n" -ForegroundColor Cyan
      "=== winget install $Id (msstore pre-install) ===" | Add-Content -Path $LogPath
      Invoke-WithRetry -Name "msstore agreement accept: $Id" -ScriptBlock {
        # Log-only, not Tee-Object'd to console: winget has no flag to suppress its own per-package
        # "Found X / Agreements / License terms" narration (--disable-interactivity only suppresses
        # prompts), and with 9 msstore apps that's a wall of text with little value on-screen given
        # the Write-Host line above already reports which app is being processed, and the warning
        # below already surfaces failures.
        winget install --id $Id --source msstore --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1 |
          Add-Content -Path $LogPath
      }
      if ($LASTEXITCODE -ne 0) {
        Write-Host "Warning: pre-accepting $Id failed (exit code $LASTEXITCODE) -- its winget configure resource will likely fail too. See $LogPath`n" -ForegroundColor Yellow
      }
    }
  }
}

foreach ($File in $ConfigFiles) {
  $Path = Join-Path $ConfigDir $File
  if (-not (Test-ConfigFileChanged -Path $Path)) {
    Write-Host "Skipping $File -- unchanged since last successful apply.`n" -ForegroundColor DarkGray
    "=== ${File}: unchanged, skipping ===" | Add-Content -Path $LogPath
    continue
  }
  Write-Host "Applying $File via 'winget configure'...`n" -ForegroundColor Cyan
  "=== $File ===" | Add-Content -Path $LogPath
  Invoke-WithRetry -Name $File -ScriptBlock {
    # winget configure has no flag to suppress its "You are responsible for understanding..."
    # legal disclaimer -- --accept-configuration-agreements only avoids the interactive prompt,
    # per winget's own docs, and it prints unconditionally otherwise. Filtered out of the console
    # specifically (still written to the log in full via Add-Content below) since it's identical
    # boilerplate on every single one of the files here.
    winget configure -f $Path --accept-configuration-agreements --disable-interactivity --suppress-initial-details 2>&1 |
      ForEach-Object {
        Add-Content -Path $LogPath -Value $_
        if ($_ -notmatch '^You are responsible for understanding') { $_ }
      }
  }
  "--- exit code: $LASTEXITCODE ---" | Add-Content -Path $LogPath
  if ($LASTEXITCODE -ne 0) {
    Write-Host "Warning: $File exited with code $LASTEXITCODE after retries. This may be a benign warning (e.g. 'module not provided') or a real failure -- see $LogPath`n" -ForegroundColor Yellow
  }
  # Updated regardless of exit code, matching the warning above: winget configure's exit code isn't
  # a reliable success signal (see the comment at the bottom of this script), so gating this on a
  # clean exit would mean any file that routinely emits a benign non-zero warning never gets its
  # hash recorded -- permanently defeating the skip check above on every future run.
  # Invoke-WithRetry already spent 3 attempts with backoff on this before we get here.
  Set-ConfigFileAppliedHash -Path $Path
}

# optional-features.configuration.winget enables Windows optional features (e.g. Hyper-V, WSL) that typically
# need a reboot before they take effect, but winget configure gives no indication of this on its own.
$RebootPending = (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') `
  -or (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired') `
  -or ($null -ne (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue))
if ($RebootPending) {
  Write-Host "A reboot is pending. Reboot and rerun 'chezmoi apply' again to finish applying the configuration.`n" -ForegroundColor Yellow

  # Without this, "rerun chezmoi apply" above wouldn't actually do anything: this script always
  # exits 0 (see below), so chezmoi would consider it already successfully applied and, per its
  # run_onchange_ semantics, wouldn't even re-invoke it on a bare rerun with no other file changes
  # -- confirmed empirically. Two things are needed to make the rerun genuinely effective:
  #
  # 1. Remove the applied-hash sidecar for the specific files whose resources can be left
  #    incomplete by a pending reboot, so the main loop above doesn't skip them next time even
  #    though their content hasn't changed. Only wsl.configuration.winget's InstallUbuntu
  #    resource is confirmed to actually fail its Set operation until after reboot (it depends on
  #    Virtual Machine Platform, enabled moments earlier in the same run, actually being active);
  #    optional-features.configuration.winget's Enable-WindowsOptionalFeature call reports success
  #    immediately regardless of reboot state, so retrying it doesn't change anything -- included
  #    here anyway since it's cheap and idempotent, in case that ever stops being true.
  foreach ($RebootAffectedFile in @("optional-features.configuration.winget", "wsl.configuration.winget")) {
    Remove-Item -Path (Join-Path $ConfigDir "$RebootAffectedFile.chezmoi-hash") -Force -ErrorAction SilentlyContinue
  }

  # 2. Exit non-zero so chezmoi retries this whole script on the next apply even if nothing else
  #    changed -- not one of winget's own unreliable exit codes, but our own deterministic
  #    registry-based reboot check, so it's safe to act on directly here.
  exit 1
}

# winget configure returns a non-zero exit code even on a fully successful apply (e.g. for
# benign "module not provided" warnings), so its exit code isn't a reliable success signal here.
# Real failures are still visible above and logged to $LogPath for later inspection.
exit 0
