#Requires -Version 7.0

# Applies the WinGet Configuration files that declaratively configure this Windows machine.
# Flow: preflight checks (pending reboot, Group Policy), prerequisite installs and upstream-bug
# workarounds, then one `winget configure` run per changed *.configuration.winget file, with
# applied-hash sidecars so unchanged files are skipped on later runs.

# {{ $wingetConfigDirName := "winget-configuration-chezmoi" }}
# {{ $wingetConfigSourceDir := joinPath .chezmoi.sourceDir "AppData/Local" $wingetConfigDirName }}
# {{/* Two globs, not one: templated config files (e.g. 8.pwas.configuration.winget.tmpl) live in
#      the source tree with a .tmpl suffix that glob's literal "*.configuration.winget" pattern
#      won't match, and would otherwise silently never trigger a rerun when their *source*
#      content changes (chezmoi still keeps the applied target file itself in sync either way --
#      only this script's own rerun-on-change gate would miss it). sortAlpha keeps the hash list
#      below stable across renders -- glob's match order isn't guaranteed. */}}
# {{ $wingetConfigFiles := concat (joinPath $wingetConfigSourceDir "*.configuration.winget" | glob) (joinPath $wingetConfigSourceDir "*.configuration.winget.tmpl" | glob) | sortAlpha }}

# {{/* Hashes below make this run_onchange_ script rerun when any *.configuration.winget[.tmpl] file
#      changes. Squeezed onto one line (literal "\n"s instead of real line breaks) so a single
#      leading "#" comments out the whole range/end for PowerShell -- a bare {{ end }} on its own
#      line is a parse error, and text before a same-line {{ end }} repeats every iteration
#      instead of trailing once.
#      IMPORTANT: `include` returns a file's raw, unrendered source -- for a .tmpl file that's the
#      literal "{{ ... }}" template text, not its evaluated output, so hashing a .tmpl file's own
#      bytes alone does NOT change when the *data it renders from* changes. 8.pwas.configuration.winget.tmpl
#      renders from .chezmoidata/pwas.toml, so that file is hashed explicitly below too -- add
#      another line here for any future templated config file's own external data dependency. */}}
# {{ "\n" }}{{ range $wingetConfigFiles }}## {{ base . }} hash: {{ include . | sha256sum }}{{ "\n" }}{{ end -}}
## optional-features-list.ps1 hash: {{ joinPath $wingetConfigSourceDir "optional-features-list.ps1" | include | sha256sum }}
## pwas.toml hash: {{ joinPath .chezmoi.sourceDir ".chezmoidata/pwas.toml" | include | sha256sum }}

# chezmoi apply runs many scripts back to back with no indication which is running -- announce
# this one, since it can take a while.
Write-Host "`nApplying Windows configuration via winget configure..." -ForegroundColor Green

#region Paths and logging

$ConfigDir = Join-Path $env:LOCALAPPDATA "{{ $wingetConfigDirName }}"
New-Item -ItemType Directory -Path $ConfigDir -Force | Out-Null

# Discovered at runtime from the target dir -- the template block above hashes the *source*
# copies only to trigger reruns.
$ConfigFiles = (Get-ChildItem -Path $ConfigDir -Filter "*.configuration.winget" -File | Sort-Object Name).Name

# winget's exit code isn't reliable (see bottom of script) and this runs unattended, so log
# everything -- otherwise a real failure leaves no record once the terminal closes.
$LogPath = Join-Path $ConfigDir "winget-configure.log"
"Run started $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" | Set-Content -Path $LogPath

# Where winget writes its own diagnostic logs -- pointed to from failure log lines.
$WingetLogDir = Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\LocalState\DiagOutputDir'

# Appends to this script's log; accepts pipeline input so command output can stream into it.
function Write-Log {
  param([Parameter(ValueFromPipeline)] $Message)
  process { Add-Content -Path $LogPath -Value $Message }
}

#endregion

#region Helpers

# Retries with exponential backoff to ride out transient network blips; every attempt is logged.
# Success is signaled through $LASTEXITCODE (0 = success): native commands set it themselves, and
# cmdlet-only script blocks succeed unless they throw. Callers inspect $LASTEXITCODE afterwards.
function Invoke-WithRetry {
  param(
    [Parameter(Mandatory)] [scriptblock] $ScriptBlock,
    [string] $Name = "operation",
    [int] $MaxAttempts = 3,
    [int] $InitialDelaySeconds = 5
  )
  $Delay = $InitialDelaySeconds
  for ($Attempt = 1; $Attempt -le $MaxAttempts; $Attempt++) {
    Write-Log "[retry] ${Name}: attempt $Attempt/$MaxAttempts"
    $global:LASTEXITCODE = 0  # don't inherit a stale value from an earlier native command
    try {
      & $ScriptBlock
    } catch {
      Write-Log "[retry] ${Name}: attempt $Attempt threw: $($_.Exception.Message)"
      $global:LASTEXITCODE = 1
    }
    if ($LASTEXITCODE -eq 0 -or $Attempt -ge $MaxAttempts) { return }
    Write-Host "`n$Name failed (exit code $LASTEXITCODE), retrying in ${Delay}s (attempt $Attempt/$MaxAttempts)..." -ForegroundColor DarkYellow
    Write-Log "[retry] ${Name}: attempt $Attempt failed with exit code $LASTEXITCODE, retrying in ${Delay}s"
    Start-Sleep -Seconds $Delay
    $Delay *= 2
  }
}

# "<file>.chezmoi-hash" sidecars record the hash each config file was last applied against, so
# the apply loop can skip unchanged files.
function Get-ConfigFileHash {
  param([string] $Path)
  if (-not (Test-Path $Path)) { return $null }
  return (Get-FileHash -Path $Path -Algorithm SHA256).Hash
}

function Test-ConfigFileChanged {
  param([string] $Path)
  $HashPath = "$Path.chezmoi-hash"
  if (-not (Test-Path $HashPath)) { return $true }
  return (Get-ConfigFileHash -Path $Path) -ne (Get-Content -Path $HashPath -Raw).Trim()
}

function Set-ConfigFileAppliedHash {
  param([string] $Path)
  $Hash = Get-ConfigFileHash -Path $Path
  if ($null -ne $Hash) {
    Set-Content -Path "$Path.chezmoi-hash" -Value $Hash -NoNewline
  }
}

# winget configure gives no indication a resource left a reboot pending, so infer it from the
# registry. Backs both the upfront check and the per-file check in the apply loop.
function Test-RebootPending {
  return (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') `
    -or (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired') `
    -or ($null -ne (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue))
}

# Queues `chezmoi apply` to rerun automatically at next logon, so applying the rest of the
# configuration doesn't wait on remembering to rerun it by hand. HKCU RunOnce (not a Scheduled
# Task) because it needs no elevation -- this script already runs unelevated -- and Windows
# deletes the value itself once it fires, so there's nothing to clean up on success. Fires at
# the next *interactive logon of this user*, which matches how this script itself is invoked.
function Register-ChezmoiApplyOnNextLogon {
  $ChezmoiExe = (Get-Command chezmoi -ErrorAction SilentlyContinue).Source
  if (-not $ChezmoiExe) {
    Write-Log "=== could not resolve chezmoi.exe on PATH -- skipping RunOnce registration ==="
    return $false
  }
  $WtExe = (Get-Command wt -ErrorAction SilentlyContinue).Source
  $PwshExe = (Get-Command pwsh -ErrorAction SilentlyContinue).Source
  $Command = if ($WtExe -and $PwshExe) {
    "`"$WtExe`" -- `"$PwshExe`" -NoExit -Command `"& '$ChezmoiExe' apply`""
  } else {
    "powershell.exe -NoExit -Command `"& '$ChezmoiExe' apply`""
  }
  Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce' -Name 'ChezmoiApply' -Value $Command
  Write-Log "=== registered RunOnce 'ChezmoiApply' to rerun 'chezmoi apply' at next logon ==="
  return $true
}

# Stops the script when a reboot is pending: queues the RunOnce rerun, tells the user what to do,
# and exits non-zero so chezmoi retries this run_onchange_ script on the next apply even if
# nothing else changed -- the script always exits 0 otherwise (see bottom), which would make
# chezmoi treat it as already-successful and skip a bare rerun.
function Stop-ForPendingReboot {
  param(
    [Parameter(Mandatory)] [string] $Reason,
    [Parameter(Mandatory)] [string] $LogMessage
  )
  if (Register-ChezmoiApplyOnNextLogon) {
    Write-Host "`n$Reason Reboot -- 'chezmoi apply' will rerun automatically at next logon to finish applying the configuration." -ForegroundColor Yellow
  } else {
    Write-Host "`n$Reason Reboot, then rerun 'chezmoi apply' to finish applying the configuration." -ForegroundColor Yellow
  }
  Write-Log $LogMessage
  exit 1
}

# Locates dsc.exe under an extracted DSC ZIP-release directory (see the DSC ZIP workaround below).
function Find-DscZipExe {
  param([string] $Dir)
  if (-not (Test-Path $Dir)) { return $null }
  return (Get-ChildItem -Path $Dir -Filter 'dsc.exe' -Recurse -ErrorAction SilentlyContinue |
    Select-Object -First 1).FullName
}

# Emits package ids whose source is msstore from a configuration file (see the msstore
# pre-install workaround below). Line-based scan: an "id:" followed later by "source: msstore".
function Get-MsstoreIds {
  param([string] $Path)
  $PendingId = $null
  foreach ($Line in Get-Content -Path $Path) {
    if ($Line -match '^\s*id:\s*(\S+)\s*$') {
      $PendingId = $Matches[1]
    } elseif ($Line -match '^\s*source:\s*msstore\s*$' -and $PendingId) {
      $PendingId
      $PendingId = $null
    }
  }
}

# The newest installed PSResourceGet, if it satisfies the 1.3.0-preview1+ requirement of the
# Microsoft.PowerShell.PSResourceGet/PSResourceList resource; nothing otherwise.
function Get-SufficientPSResourceGet {
  Get-PSResource -Name Microsoft.PowerShell.PSResourceGet -ErrorAction SilentlyContinue |
    Where-Object { $_.Version -ge [version]'1.3.0' }
}

#endregion

#region Preflight

# System-state snapshot for the log, useful for troubleshooting later.
try {
  $Os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
  $OsInfo = "$($Os.Caption) $($Os.Version) build $($Os.BuildNumber)"
} catch {
  $OsInfo = "(unavailable)"
}
try {
  $DiskFreeGB = [math]::Round((Get-PSDrive -Name C -ErrorAction Stop).Free / 1GB, 2)
} catch {
  $DiskFreeGB = "(unavailable)"
}
Write-Log "Preflight: OS=$OsInfo | PowerShell=$($PSVersionTable.PSVersion) | winget=$((winget --version) 2>$null) | DiskFreeGB(C)=$DiskFreeGB | WingetLogDir=$WingetLogDir"

# A reboot already pending (e.g. from Windows Update) before this script even runs makes
# applying configuration unreliable -- bail out now.
if (Test-RebootPending) {
  Stop-ForPendingReboot -Reason "A reboot is already pending." `
    -LogMessage "=== reboot already pending before any configuration was applied -- exiting ==="
}

# If winget configure is disabled by Group Policy, nothing below can work. Throw rather than
# warn -- the non-zero exit makes chezmoi retry on every `chezmoi apply` until the policy is
# fixed, with no repo change needed.
$PolicyPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppInstaller'
$PolicyValue = (Get-ItemProperty -Path $PolicyPath -Name 'EnableWindowsPackageManagerConfiguration' -ErrorAction SilentlyContinue).EnableWindowsPackageManagerConfiguration
if ($null -ne $PolicyValue -and [int]$PolicyValue -eq 0) {
  throw "winget configure is disabled by Group Policy ($PolicyPath\EnableWindowsPackageManagerConfiguration = 0). This is the 'Enable Windows Package Manager Configuration' ADMX policy (Computer Configuration > Administrative Templates > Windows Components > App Installer). Fix the policy, then rerun."
}

#endregion

#region Prerequisites and upstream workarounds

# Fresh machines refuse `winget configure` until its extended-features flag is enabled once.
# `--enable` is idempotent, so run it unconditionally rather than probe for the flag's state --
# there's no reliable cross-version check for it. Exit code isn't gated on: some winget builds
# return non-zero even when already enabled, and a real failure here surfaces in the apply loop.
# `--enable`/`--disable` must be passed alone -- newer winget rejects it combined with any other
# argument (including --verbose-logs) with "Option '--enable' and '--disable' cannot be used with
# other arguments."
Write-Host "`nEnsuring winget configure extended features are enabled..." -ForegroundColor Cyan
Write-Log "=== winget configure --enable ==="
winget configure --enable

# winget configure needs the VC++ 2015+ x64 redistributable when run non-elevated, and fails
# with an opaque internal error without it -- self-heal by installing it directly.
$VCRedistKey = 'HKLM:\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64'
if ((Get-ItemProperty -Path $VCRedistKey -Name 'Installed' -ErrorAction SilentlyContinue).Installed -ne 1) {
  Write-Host "Microsoft Visual C++ Redistributable 2015+ (x64) not found -- installing (winget configure can fail with an internal error without it)..." -ForegroundColor Yellow
  Write-Log "=== Installing Microsoft.VCRedist.2015+.x64 ==="
  Invoke-WithRetry -Name 'Microsoft.VCRedist.2015+.x64 install' -ScriptBlock {
    winget install --id 'Microsoft.VCRedist.2015+.x64' --source winget --accept-package-agreements --accept-source-agreements --disable-interactivity --verbose-logs
  }
  if ($LASTEXITCODE -ne 0) {
    Write-Log "=== winget's own diagnostic logs for this failure: $WingetLogDir ==="
    throw "Failed to install Microsoft.VCRedist.2015+.x64 (exit code $LASTEXITCODE) -- winget configure is likely to fail without it. See $LogPath and rerun."
  }
}

# The Microsoft.PowerShell.PSResourceGet/PSResourceList resource needs PSResourceGet 1.3.0-preview1+.
if (-not (Get-SufficientPSResourceGet)) {
  Write-Host "`nInstalling PSResourceGet 1.3.0+..." -ForegroundColor Cyan
  Write-Log "=== Installing Microsoft.PowerShell.PSResourceGet (prerelease) ==="
  try {
    Install-PSResource -Name Microsoft.PowerShell.PSResourceGet -Prerelease -TrustRepository -Scope CurrentUser -ErrorAction Stop *>&1 | Write-Log
  } catch {
    Write-Log "PSResourceGet install threw: $($_.Exception.Message)"
  }
  $PSResourceGetInstalled = Get-SufficientPSResourceGet
  if (-not $PSResourceGetInstalled) {
    Write-Host "Warning: failed to install PSResourceGet 1.3.0+ . See $LogPath" -ForegroundColor Yellow
  } else {
    Write-Log "=== PSResourceGet install verified: $($PSResourceGetInstalled.Version) $($PSResourceGetInstalled.Prerelease) ==="
    # winget configure runs through WindowsPackageManagerServer, a COM server that stays resident
    # across invocations (confirmed: one ran for over a week) and caches its DSC resource
    # resolution -- an already-running instance won't see the just-installed module, so
    # WindowsDscModules would fail with "Resource not found" despite it being on disk. Kill it
    # to force a fresh instance.
    Get-Process -Name WindowsPackageManagerServer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    Write-Log "=== restarted WindowsPackageManagerServer after installing PSResourceGet ==="
  }
}

# Workaround for https://github.com/PowerShell/DSC/issues/1653: Microsoft.Windows/OptionalFeatureList
# errors outright ("This resource currently is not supported when installed via Appx") under the
# Appx-packaged dsc.exe that winget configure uses by default; per DSC v3.2.0's release notes the
# resource "requires using the ZIP package of DSC for now". Downloading that ZIP release once and
# pointing every `winget configure` call at it via --processor-path sidesteps the limitation for
# all files, not just the one that needs it -- there's no per-resource processor override. Always
# resolved to GitHub's "latest" release (which already excludes pre-releases/drafts) rather than
# pinned, so this self-updates. Remove this block, Find-DscZipExe above, and the --processor-path
# argument in the apply loop once the linked issue is fixed upstream.
$DscZipRoot = Join-Path $ConfigDir 'dsc-zip'
try {
  $DscLatestRelease = Invoke-RestMethod -Uri 'https://api.github.com/repos/PowerShell/DSC/releases/latest' -ErrorAction Stop
  $DscZipDir = Join-Path $DscZipRoot $DscLatestRelease.tag_name.TrimStart('v')
} catch {
  # The GitHub API can be down or rate-limited -- an already-downloaded copy beats failing.
  $DscLatestRelease = $null
  $DscZipDir = (Get-ChildItem -Path $DscZipRoot -Directory -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending | Select-Object -First 1).FullName
  Write-Log "=== GitHub latest-release lookup failed ($($_.Exception.Message)) -- falling back to cached DSC ZIP package at: $DscZipDir ==="
}
$DscZipExe = if ($DscZipDir) { Find-DscZipExe -Dir $DscZipDir }

if (-not $DscZipExe) {
  if (-not $DscLatestRelease) {
    throw "Could not resolve the latest DSC release from GitHub and no cached DSC ZIP package exists -- Microsoft.Windows/OptionalFeatureList resources will fail. See $LogPath and rerun."
  }
  $DscZipAsset = $DscLatestRelease.assets | Where-Object { $_.name -match 'x86_64-pc-windows-msvc\.zip$' } | Select-Object -First 1
  if (-not $DscZipAsset) {
    throw "Could not find an x86_64-pc-windows-msvc.zip asset in the latest DSC release ($($DscLatestRelease.tag_name)) -- release layout may have changed. See $LogPath."
  }
  Write-Host "Downloading DSC $($DscLatestRelease.tag_name) ZIP package..." -ForegroundColor Cyan
  Write-Log "=== Downloading DSC $($DscLatestRelease.tag_name) ZIP package ==="
  $DscZipDownloadPath = Join-Path $env:TEMP "dsc-$($DscLatestRelease.tag_name.TrimStart('v')).zip"
  Invoke-WithRetry -Name 'DSC ZIP download' -ScriptBlock {
    Invoke-WebRequest -Uri $DscZipAsset.browser_download_url -OutFile $DscZipDownloadPath -ErrorAction Stop
  }
  if ($LASTEXITCODE -ne 0) {
    throw "Failed to download DSC $($DscLatestRelease.tag_name) ZIP package after retries -- Microsoft.Windows/OptionalFeatureList resources will fail. See $LogPath and rerun."
  }

  New-Item -ItemType Directory -Path $DscZipDir -Force | Out-Null
  Expand-Archive -Path $DscZipDownloadPath -DestinationPath $DscZipDir -Force
  Remove-Item -Path $DscZipDownloadPath -Force -ErrorAction SilentlyContinue
  $DscZipExe = Find-DscZipExe -Dir $DscZipDir
  if (-not $DscZipExe) {
    throw "dsc.exe not found after extracting the DSC $($DscLatestRelease.tag_name) ZIP package -- release layout may have changed. See $LogPath."
  }
  Write-Log "=== DSC $($DscLatestRelease.tag_name) ZIP package extracted to $DscZipExe ==="
}

# winget refuses --processor-path without this admin setting enabled first ("This feature needs
# to be enabled by administrators"). `winget settings export` gives a reliable unelevated read of
# its current state; enabling it needs its own elevated process (a plain `winget settings
# --enable` from this unelevated script fails the same way), so this only prompts UAC the first
# time -- or after whatever store backs admin settings gets reset.
$AdminSettings = (winget settings export 2>$null | ConvertFrom-Json).adminSettings
if (-not $AdminSettings.ConfigurationProcessorPath) {
  Write-Host "`nEnabling winget's ConfigurationProcessorPath admin setting (requires elevation -- expect a UAC prompt)..." -ForegroundColor Cyan
  Write-Log "=== Enabling ConfigurationProcessorPath admin setting (elevated) ==="
  $Proc = Start-Process -FilePath 'winget' -ArgumentList 'settings', '--enable', 'ConfigurationProcessorPath' -Verb RunAs -Wait -PassThru
  if ($Proc.ExitCode -ne 0) {
    throw "Failed to enable ConfigurationProcessorPath admin setting (exit code $($Proc.ExitCode)) -- Microsoft.Windows/OptionalFeatureList resources will fail. Enable it manually by running 'winget settings --enable ConfigurationProcessorPath' as administrator, then rerun."
  }
  Write-Log "=== ConfigurationProcessorPath admin setting enabled ==="
}

# Workaround for https://github.com/microsoft/winget-cli/issues/6091, which prevents winget
# configure from installing Store apps for the first time: pre-install them here instead. Scans
# every *.configuration.winget file
$MsstoreIds = [System.Collections.Generic.HashSet[string]]::new()
foreach ($File in $ConfigFiles) {
  $Path = Join-Path $ConfigDir $File
  if (Test-ConfigFileChanged -Path $Path) {
    Get-MsstoreIds -Path $Path | ForEach-Object { [void]$MsstoreIds.Add($_) }
  }
}
if ($MsstoreIds.Count -eq 0) {
  Write-Log "=== no changed *.configuration.winget files reference msstore ids, skipping pre-install pass ==="
}

# Already-installed Store apps make winget install fail with 0x8A15002B (no applicable update) --
# not a real failure, just an upgrade check against a current package. Filter them out first so
# the header below only announces a pre-install pass when one will actually happen.
$MsstoreIdsToInstall = [System.Collections.Generic.List[string]]::new()
foreach ($Id in $MsstoreIds) {
  winget list --id $Id -e --accept-source-agreements 2>&1 | Write-Log
  if ($LASTEXITCODE -eq 0) {
    Write-Log "=== $Id already installed, skipping pre-install ==="
    continue
  }
  $MsstoreIdsToInstall.Add($Id)
}

if ($MsstoreIdsToInstall.Count -gt 0) {
  Write-Host "`nPre-installing Store apps referenced in configuration files..." -ForegroundColor Cyan
  Write-Log "=== Pre-installing Store apps referenced in configuration files: $($MsstoreIdsToInstall -join ', ') ==="
}
foreach ($Id in $MsstoreIdsToInstall) {
  Write-Host "Pre-installing Store app $Id..." -ForegroundColor Cyan
  Write-Log "=== winget install $Id (msstore pre-install) ==="
  Invoke-WithRetry -Name "msstore pre-install: $Id" -ScriptBlock {
    # Log-only: winget can't suppress its per-package "Found X / Agreements" narration, and with
    # many Store apps that's console noise the Write-Host above and warning below already cover.
    winget install --id $Id --source msstore --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1 | Write-Log
  }
  if ($LASTEXITCODE -ne 0) {
    Write-Host "Warning: pre-installing $Id failed (exit code $LASTEXITCODE) -- its winget configure resource will likely fail too. See $LogPath" -ForegroundColor Yellow
  }
}

#endregion

#region Apply configuration files

foreach ($File in $ConfigFiles) {
  $Path = Join-Path $ConfigDir $File
  if (-not (Test-ConfigFileChanged -Path $Path)) {
    Write-Host "`nSkipping $File -- unchanged since last successful apply." -ForegroundColor DarkGray
    Write-Log "=== ${File}: unchanged, skipping ==="
    continue
  }

  Write-Host "`nApplying $File via 'winget configure'..." -ForegroundColor Cyan
  Write-Log "=== $File ==="
  Invoke-WithRetry -Name $File -ScriptBlock {
    # If https://github.com/microsoft/winget-cli/issues/6419) is ever implemented, we'll want to add its flag here
    # When https://github.com/PowerShell/DSC/issues/1653 is fixed, remove the --processor-path argument and the DSC ZIP workaround above
    winget configure -f $Path --processor-path $DscZipExe --accept-configuration-agreements --disable-interactivity --suppress-initial-details --verbose-logs
  }
  Write-Log "--- exit code: $LASTEXITCODE ---"
  if ($LASTEXITCODE -ne 0) {
    Write-Log "=== winget's own diagnostic logs for this failure: $WingetLogDir ==="
    Write-Host "Warning: $File exited with code $LASTEXITCODE after retries. This may be a benign warning (e.g. 'module not provided') or a real failure -- see $LogPath" -ForegroundColor Yellow
  }

  # A file's resources (e.g. enabling a feature, WSL setup) can leave a reboot pending that
  # winget configure won't report -- checked fresh after every file, since any could trigger one.
  # Checked before recording the hash below: if this file caused it, its effects may not be fully
  # in place yet, so its hash (and every later file's, never reached this run) stays unrecorded
  # -- the skip check re-picks them up once chezmoi retries.
  if (Test-RebootPending) {
    Stop-ForPendingReboot -Reason "A reboot is pending after applying $File." `
      -LogMessage "=== reboot pending after ${File}: not recording applied-hash, exiting ==="
  }

  # Recorded regardless of winget's exit code (unreliable, see bottom of script) -- gating on a
  # clean exit would permanently defeat the skip check for files with benign non-zero warnings.
  Set-ConfigFileAppliedHash -Path $Path
}

#endregion

Write-Host "`nWindows configuration applied -- no reboot needed." -ForegroundColor Green

# winget's exit code isn't reliable even on success (e.g. benign "module not provided" warnings)
# -- real failures are already visible above and logged to $LogPath.
exit 0
