#!/usr/bin/env bash

# Drops a Markdown checklist of manual post-setup steps on the Desktop, opening it the first time
# it's created. Plain run_after_ (not run_once_/run_onchange_) so it self-heals if the checklist
# file is deleted -- same reasoning as the Windows run_after_desktop-icons.ps1 -- but idempotency
# for the file write is handled inside this script (a test -f check), not via chezmoi's own
# once/onchange hash tracking, since that hash would otherwise re-fire (and overwrite the user's
# checked-off progress) the moment this script's own content changes in a future commit.
#
# Setting Zettlr as the default .md handler is a separate concern, handled by the app_associations
# Ansible role (roles/app_associations/tasks/main.yml) as part of
# run_onchange_after_ansible-configure.sh.tmpl in 30-macos/ -- 30-macos/ sorts before this script's
# 31-macos-late/ directory, so it already ran earlier in this same `chezmoi apply`.

set -euo pipefail

SourceChecklist='{{ joinPath .chezmoi.sourceDir ".scriptdata/setup-checklist/macos.md" }}'
DesktopChecklist="$HOME/Desktop/SETUP-CHECKLIST.md"

if [ -f "$DesktopChecklist" ]; then
  echo -e "\033[2;37m\nSetup checklist already exists on Desktop -- leaving it (and any checked-off progress) alone.\033[0m"
  exit 0
fi

echo -e "\033[1;32m\nCreating setup checklist on Desktop...\033[0m"
cp "$SourceChecklist" "$DesktopChecklist"

echo -e "\033[1;32m\nOpening setup checklist...\033[0m"
open -a Zettlr "$DesktopChecklist" || open "$DesktopChecklist"
