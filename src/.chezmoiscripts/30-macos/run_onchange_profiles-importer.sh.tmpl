#!/usr/bin/env bash

# Opens any *.mobileconfig files in .scriptdata/macos-profiles that are new or have changed
# since they were last installed, so the user can install/update them. This is the generic
# landing spot for any macOS setting that's only configurable via an MDM configuration
# profile (notification permissions, PPPC/privacy grants, Screen Time, etc.) -- add a new
# .mobileconfig here for the next one, no script changes needed. There's no headless/CLI
# install path for any of these -- Apple removed silent `profiles install` in Big Sur, so
# System Settings' own "Install" click is unavoidable.
#
# The run_onchange_ content hash below only controls whether chezmoi bothers running this
# script at all (it changes whenever ANY profile's content changes). Which profile(s) actually
# get a prompt is decided at runtime via a per-profile content-hash sidecar file under
# $XDG_STATE_HOME -- same idea as the settings.json.chezmoi-hash sidecar in
# run_onchange_after_vscode-profiles.py.tmpl, adapted to shell. Without this, adding or
# changing one profile would re-prompt for every other unchanged profile too, since they all
# share this one script.
#
# Known limitation: if you manually remove an already-handled profile via System Settings,
# this won't notice and won't re-prompt -- delete its sidecar file under $XDG_STATE_HOME to
# force a re-prompt, or just edit the .mobileconfig to bump its content.

{{- $profilesDir := print .chezmoi.sourceDir "/.scriptdata/macos-profiles" -}}
{{- $profiles := list -}}
{{- range joinPath $profilesDir "*.mobileconfig" | glob | sortAlpha -}}
{{- $profiles = append $profiles (dict "path" . "name" (base .) "hash" (include . | sha256sum)) -}}
{{- end }}
#
{{ range $profiles -}}
## {{ .name }} hash: {{ .hash }}
{{ end -}}

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi-macos-profiles"
mkdir -p "$STATE_DIR"

{{ range $profiles }}
HASH_FILE="$STATE_DIR/{{ .name }}.sha256"
if [ -f "$HASH_FILE" ] && [ "$(cat "$HASH_FILE")" = "{{ .hash }}" ]; then
  echo -e "\033[0;90m'{{ .name }}' is unchanged since it was last installed; skipping.\033[0m"
else
  echo -e "\033[0;36m\nThis machine needs a one-time install of the '{{ .name }}' configuration profile\nto pre-approve some app permissions. After you press Enter, System Settings will\nopen -- click 'Install' there, then close System Settings.\033[0m\n"
  read -r -p "Press Enter to continue... "
  open "{{ .path }}"
  read -r -p "Press Enter once you've clicked Install and closed System Settings... "
  echo "{{ .hash }}" > "$HASH_FILE"
fi
{{ end -}}
