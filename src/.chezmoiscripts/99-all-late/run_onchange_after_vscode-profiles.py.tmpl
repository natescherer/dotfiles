#!/usr/bin/env python3
# Installs each VS Code profile's extensions (from .chezmoidata/vscode.toml) and syncs its
# settings.json into VS Code's own profile folder - user_dir itself for Default, or the
# machine-generated User/profiles/<hash>/ folder for named profiles.
#
# A profile's settings.json is only overwritten if it's untouched since the last time this
# script wrote it (tracked via a settings.json.chezmoi-hash sidecar file), so local customizations
# never get clobbered; if drift is detected, it warns instead of overwriting.

# Why is this in a folder called '99-all-late' instead of one of the OS-specific script folders?
# Directory order is what determines script execution order, and 99 is higher than every OS-specific
# folder (10-linux, 20-linux-and-macos, 30-macos, 40-windows, 41-windows-late), so this always runs
# last across every platform, after whatever those installed.

import hashlib
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
import time

{{/* The section below embeds the content of .chezmoiscript/vscode.toml as well as the files under
.chezmoitemplates/vscode, ensuring changes to those files will cause the hash of this files to change,
triggering the run_onchange_. */}}
{{- $profiles := list }}
{{- $extensionSetDefns := .vscode.extension_sets | default (dict) }}
{{- range .vscode.profiles }}
{{- $icon := "" }}
{{- if ne .name "Default" }}
{{- $icon = .icon }}
{{- end }}
{{- $merged := dict }}
{{- range $settingsFile := .settings_files | default (list) }}
{{- $fileContent := include $settingsFile | fromJsonc }}
{{- $merged = merge $fileContent $merged }}
{{- end }}
{{- $settings := $merged | toPrettyJson }}
{{- $extensions := list }}
{{- range $extensionSetName := .extension_sets | default (list) }}
{{- $extensionSetExtensions := index $extensionSetDefns $extensionSetName | default (list) }}
{{- range $extension := $extensionSetExtensions }}
{{- $extensions = append $extensions $extension }}
{{- end }}
{{- end }}
{{- range $extension := .extensions | default (list) }}
{{- $extensions = append $extensions $extension }}
{{- end }}
{{- $profiles = append $profiles (dict "name" .name "extensions" $extensions "settings" $settings "icon" $icon) }}
{{- end }}
PROFILES = {{ $profiles | toJson }}

IS_WINDOWS = platform.system() == "Windows"

if IS_WINDOWS:
    # winget/MSI installs earlier in this same apply run write straight to the registry, but this
    # process's inherited os.environ["PATH"] was captured before those writes happened (env var
    # changes never propagate from a child process backward into an already-running parent).
    # Rebuilding PATH from the registry (Machine + User, same precedence Windows itself uses)
    # picks up anything installed this run -- see main()'s shutil.which("code") check below.
    import winreg

    def _registry_path(hive, subkey):
        try:
            with winreg.OpenKey(hive, subkey) as key:
                value, _ = winreg.QueryValueEx(key, "Path")
                return value
        except FileNotFoundError:
            return ""

    _machine_path = _registry_path(winreg.HKEY_LOCAL_MACHINE, r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment")
    _user_path = _registry_path(winreg.HKEY_CURRENT_USER, "Environment")
    os.environ["PATH"] = _machine_path + os.pathsep + _user_path

# Normally, a profile's settings.json that has drifted from what chezmoi last wrote is left alone
# (see write_profile_settings) so local customizations never get silently clobbered. Setting this
# opts back into always overwriting it with what chezmoi wants instead.
CHEZMOI_VSCODE_CLOBBER = os.environ.get("CHEZMOI_VSCODE_CLOBBER", "").lower() in ("1", "true", "yes")

# Setting an env var for a single command differs by shell, so give the warning below a copy-pasteable
# example matching however this script itself is actually being run.
CLOBBER_COMMAND = (
    '$env:CHEZMOI_VSCODE_CLOBBER = "true"; chezmoi apply'
    if IS_WINDOWS
    else "CHEZMOI_VSCODE_CLOBBER=true chezmoi apply"
)

CYAN_TERM_COLOR = "\033[0;36m"
BRIGHT_GREEN_TERM_COLOR = "\033[1;32m"
RED_TERM_COLOR = "\033[0;31m"
YELLOW_TERM_COLOR = "\033[1;33m"
RESET_TERM_STYLE = "\033[0m"


def vscode_user_dir():
    system = platform.system()
    if system == "Windows":
        return os.path.join(os.environ["APPDATA"], "Code", "User")
    if system == "Darwin":
        return os.path.join(os.path.expanduser("~"), "Library", "Application Support", "Code", "User")
    return os.path.join(os.path.expanduser("~"), ".config", "Code", "User")


def run_code(*args):
    # 'code' needs launched through a shell on Windows.
    cmd = ["cmd", "/c", "code", *args] if IS_WINDOWS else ["code", *args]
    return subprocess.run(cmd, capture_output=True, text=True)


def list_extensions(profile_name):
    profile_args = () if profile_name == "Default" else ("--profile", profile_name)
    result = run_code(*profile_args, "--list-extensions")
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def install_extension(profile_name, extension_id):
    profile_args = () if profile_name == "Default" else ("--profile", profile_name)
    print(f"{CYAN_TERM_COLOR}Installing '{extension_id}' into VS Code profile '{profile_name}'...{RESET_TERM_STYLE}")
    result = run_code(*profile_args, "--install-extension", extension_id)
    if result.returncode != 0:
        print(
            f"{RED_TERM_COLOR}Error: failed to install '{extension_id}' into VS Code profile "
            f"'{profile_name}' (exit code {result.returncode}). Re-run 'chezmoi apply' to try "
            f"again.{RESET_TERM_STYLE}\n{result.stdout}{result.stderr}",
            file=sys.stderr,
        )
        return False
    return True


def sync_extensions(profile_name, desired_extensions):
    desired = set(desired_extensions)
    installed = list_extensions(profile_name)

    all_succeeded = True
    for extension_id in sorted(desired - installed):
        if not install_extension(profile_name, extension_id):
            all_succeeded = False

    extra = installed - desired
    if extra:
        print(
            f"{YELLOW_TERM_COLOR}Warning: VS Code profile '{profile_name}' has the following extensions "
            f"installed that aren't tracked by chezmoi. They have not been uninstalled, but you "
            f"should consider adding them to '.chezmoidata/vscode.toml': "
            f"{', '.join(sorted(extra))}{RESET_TERM_STYLE}\n",
            file=sys.stderr,
        )

    return all_succeeded


def hash_string(value):
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def find_code_processes():
    # Best-effort snapshot of every currently-running VS Code process (main window(s) plus
    # helpers), used by provision_profile to decide whether auto-closing a provisioning window is
    # safe. Returns None -- treated by callers the same as "VS Code is already running" -- if the
    # platform's process-listing tool isn't available, since being wrong in that direction just
    # means falling back to the manual prompt below, not risking killing something we shouldn't.
    try:
        if IS_WINDOWS:
            result = subprocess.run(
                ["tasklist", "/FO", "CSV", "/FI", "IMAGENAME eq Code.exe", "/NH"],
                capture_output=True, text=True,
            )
            pids = set()
            for line in result.stdout.splitlines():
                # CSV row shape is "Image Name","PID","Session Name","Session#","Mem Usage" -- the
                # Mem Usage field itself contains a comma (e.g. "123,456 K"), but that's past the
                # PID we care about so a naive split still lands on the right field.
                fields = line.strip().split(",")
                if len(fields) >= 2 and fields[0].strip('"') == "Code.exe":
                    pids.add(fields[1].strip('"'))
            return pids

        # On macOS every VS Code process -- main window and helpers alike -- has the .app bundle
        # path somewhere in its full command line, even though their process names differ. Linux
        # Electron helper processes re-exec the same "code" binary, so matching the bare name
        # catches those too.
        pattern = (
            "Visual Studio Code.app/Contents/MacOS"
            if platform.system() == "Darwin"
            else r"/code(\s|$)"
        )
        result = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
        return {line.strip() for line in result.stdout.splitlines() if line.strip()}
    except FileNotFoundError:
        return None


def kill_pids(pids):
    if not pids:
        return
    for pid in pids:
        try:
            if IS_WINDOWS:
                subprocess.run(["taskkill", "/PID", pid, "/F"], capture_output=True, text=True)
            else:
                os.kill(int(pid), signal.SIGKILL)
        except (ProcessLookupError, ValueError, OSError):
            pass


def wait_for_profile_registration(user_dir, profile_name, retries=30, delay=2):
    for attempt in range(retries):
        if get_profile_location(user_dir, profile_name) is not None:
            return True
        if attempt and attempt % 10 == 0:
            print(f"{CYAN_TERM_COLOR}Still waiting for VS Code profile '{profile_name}' to register "
                  f"({attempt * delay}s elapsed)...{RESET_TERM_STYLE}")
        time.sleep(delay)
    return False


def provision_profile(user_dir, profile_name):
    # VS Code only registers a new profile in storage.json when it's opened as a real window, so
    # there's no way to create one headlessly. If no VS Code window is open anywhere on the
    # machine, we can launch one ourselves, wait for the registration to land, and close exactly
    # what we opened -- the same launch/wait/close-it-ourselves pattern
    # run_onchange_after_pwa-install.ps1.tmpl uses for Chromium. But if VS Code is already
    # running (or we can't tell), a new profile just opens as another window inside that same
    # instance -- there's no way to single out and close only our new window without risking the
    # user's other open windows and unsaved work, so fall back to asking them to close it
    # themselves.
    preexisting_processes = find_code_processes()
    if preexisting_processes is None or preexisting_processes:
        print(
            f"\n{YELLOW_TERM_COLOR}VS Code profile '{profile_name}' needs to be provisioned before chezmoi can manage "
            f"it. After you press Enter, VS Code will open with this profile. Close it once it appears. "
            f"This is a one-time process on this machine.{RESET_TERM_STYLE}"
        )
        input("Press Enter to continue... ")
        run_code("--profile", profile_name, "--wait")
        return

    print(
        f"\n{CYAN_TERM_COLOR}VS Code profile '{profile_name}' needs to be provisioned before chezmoi can manage "
        f"it; no VS Code window is currently open, so provisioning it automatically (one-time process on this "
        f"machine)...{RESET_TERM_STYLE}"
    )
    run_code("--profile", profile_name)
    if not wait_for_profile_registration(user_dir, profile_name):
        print(f"{YELLOW_TERM_COLOR}VS Code profile '{profile_name}' still hasn't registered after waiting; "
              f"closing the window anyway and leaving the retry to the caller.{RESET_TERM_STYLE}")
    kill_pids(find_code_processes())


def get_profile_location(user_dir, profile_name):
    storage_path = os.path.join(user_dir, "globalStorage", "storage.json")
    if not os.path.exists(storage_path):
        return None
    with open(storage_path, "r", encoding="utf-8") as f:
        storage = json.load(f)
    return next(
        (p.get("location") for p in storage.get("userDataProfiles", []) if p.get("name") == profile_name),
        None,
    )


def set_profile_icon(user_dir, profile_name, icon):
    # `code --profile "Name"` creates the profile but doesn't set its icon (it defaults to VS
    # Code's generic profile icon), so this patches it into storage.json to match vscode.toml.
    if not icon:
        return

    storage_path = os.path.join(user_dir, "globalStorage", "storage.json")
    with open(storage_path, "r", encoding="utf-8") as f:
        storage = json.load(f)

    changed = False
    for p in storage.get("userDataProfiles", []):
        if p.get("name") == profile_name:
            if p.get("icon") != icon:
                p["icon"] = icon
                changed = True
            break

    if not changed:
        return

    # Write to a temp file and rename over the original (atomic on both Windows and POSIX) rather
    # than writing storage.json in place, so a crash mid-write can't leave it corrupted.
    tmp_path = storage_path + ".chezmoi-tmp"
    with open(tmp_path, "w", encoding="utf-8", newline="") as f:
        json.dump(storage, f, indent=4)
    os.replace(tmp_path, storage_path)


def write_profile_settings(profile_name, profile_dir, settings_content):
    os.makedirs(profile_dir, exist_ok=True)
    settings_path = os.path.join(profile_dir, "settings.json")
    hash_path = os.path.join(profile_dir, "settings.json.chezmoi-hash")
    desired_path = os.path.join(profile_dir, "settings.json.chezmoi-desired")
    desired_hash = hash_string(settings_content)

    def write_settings():
        with open(settings_path, "w", encoding="utf-8", newline="") as f:
            f.write(settings_content)
        with open(hash_path, "w", encoding="utf-8", newline="") as f:
            f.write(desired_hash)
        if os.path.exists(desired_path):
            os.remove(desired_path)

    def warn_drifted(reason):
        # We're writing a copy of the contents here in case the source file is a template, which
        # couldn't be directly compared against. The copy will be cleaned up by future runs.
        with open(desired_path, "w", encoding="utf-8", newline="") as f:
            f.write(settings_content)
        print(
            f"{YELLOW_TERM_COLOR}Warning: VS Code profile '{profile_name}' {reason}.\n"
            f"\n"
            f"Compare it against what chezmoi would write with:\n"
            f"    code --diff \"{settings_path}\" \"{desired_path}\"\n"
            f"\n"
            f"Then either reconcile the differences manually, or run the following to have chezmoi\n"
            f"overwrite it automatically:\n"
            f"    {CLOBBER_COMMAND}{RESET_TERM_STYLE}\n",
            file=sys.stderr,
        )

    if not os.path.exists(settings_path):
        write_settings()
        return

    if not os.path.exists(hash_path):
        if CHEZMOI_VSCODE_CLOBBER:
            print(f"{CYAN_TERM_COLOR}VS Code profile '{profile_name}' had an untracked settings.json; "
                  f"overwriting it since CHEZMOI_VSCODE_CLOBBER is set.{RESET_TERM_STYLE}\n")
            write_settings()
            return
        warn_drifted("has a settings.json that is not chezmoi-managed")
        return

    with open(hash_path, "r", encoding="utf-8", newline="") as f:
        last_written_hash = f.read().strip()
    with open(settings_path, "r", encoding="utf-8", newline="") as f:
        live_hash = hash_string(f.read())

    if live_hash != last_written_hash:
        if CHEZMOI_VSCODE_CLOBBER:
            print(f"{CYAN_TERM_COLOR}VS Code profile '{profile_name}' had local changes to settings.json; "
                  f"overwriting them since CHEZMOI_VSCODE_CLOBBER is set.{RESET_TERM_STYLE}\n")
            write_settings()
            return
        warn_drifted("has local changes to settings.json that aren't tracked in chezmoi; leaving it as-is")
        return

    if os.path.exists(desired_path):
        os.remove(desired_path)

    if live_hash != desired_hash:
        write_settings()


def main():
    print(f"{BRIGHT_GREEN_TERM_COLOR}Starting VS Code profile sync...{RESET_TERM_STYLE}\n")

    if shutil.which("code") is None:
        # Exiting non-zero (not just returning) is deliberate: chezmoi only records a
        # run_onchange_ script as applied when it exits 0, so a non-zero exit here means chezmoi
        # retries this script on every future `chezmoi apply` -- even with this file's content
        # otherwise unchanged -- until VS Code is actually on PATH. That's a more reliable "run
        # once VS Code becomes available" trigger than a chezmoi-template-time lookPath check
        # would be, since chezmoi's own process can't see a PATH change from a script it spawned
        # earlier in this same apply run (confirmed empirically: a template-time check here
        # would wrongly skip the sync on the very run that just installed VS Code).
        print(f"{YELLOW_TERM_COLOR}VS Code ('code' command) not found; skipping VS Code profile/extension sync.{RESET_TERM_STYLE}\n", file=sys.stderr)
        sys.exit(1)

    user_dir = vscode_user_dir()

    all_succeeded = True

    for profile in PROFILES:
        name = profile["name"]

        if name == "Default":
            # Default always exists at a fixed path - no storage.json lookup, provisioning, or
            # icon needed (it's not one of the entries in storage.json's userDataProfiles).
            profile_dir = user_dir
        else:
            location = get_profile_location(user_dir, name)
            if location is None:
                provision_profile(user_dir, name)
                # On macOS, `code --wait` resolves to a shell script that polls for the Electron
                # process to exit; it can return a moment before VS Code's debounced write of
                # storage.json (where profile registration lands) actually reaches disk. Windows'
                # wait mechanism blocks until the process fully exits, so it doesn't race this --
                # empirically this retry is only ever needed on macOS, but it's harmless elsewhere.
                # The automatic path in provision_profile already polls for registration itself,
                # so this loop mainly exists for that macOS lag on the manual-close fallback.
                for attempt in range(10):
                    location = get_profile_location(user_dir, name)
                    if location is not None:
                        break
                    time.sleep(1)

            if location is None:
                print(
                    f"{RED_TERM_COLOR}Error: VS Code profile '{name}' still isn't registered; skipping its "
                    f"extension and settings sync this run. Re-run 'chezmoi apply' to try again.{RESET_TERM_STYLE}\n",
                    file=sys.stderr,
                )
                all_succeeded = False
                continue

            set_profile_icon(user_dir, name, profile["icon"])
            profile_dir = os.path.join(user_dir, "profiles", location)

        if not sync_extensions(name, profile["extensions"]):
            all_succeeded = False
        write_profile_settings(name, profile_dir, profile["settings"])

    if not all_succeeded:
        # Exiting non-zero (see the shutil.which("code") check above for why) so chezmoi retries
        # this script on the next apply instead of marking it done despite unsynced extensions.
        print(f"{RED_TERM_COLOR}VS Code profile sync finished with errors; re-run 'chezmoi apply' to retry.{RESET_TERM_STYLE}\n", file=sys.stderr)
        sys.exit(1)

    print(f"{BRIGHT_GREEN_TERM_COLOR}VS Code profile sync complete!{RESET_TERM_STYLE}\n")


if __name__ == "__main__":
    main()
