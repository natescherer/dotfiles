#Requires -Version 7.0

# Force-installs PWAs into ungoogled-chromium via the WebAppInstallForceList registry policy --
# the Windows equivalent of the macOS chromium_pwas Ansible role. Setting the registry value (in
# 8.pwas.configuration.winget.tmpl) doesn't install anything by itself: like on macOS, Chromium
# only acts on WebAppInstallForceList once it actually runs, so this launches it, waits for the
# installs to land, then quits it again.

# Why is this in a folder called '41-windows-late' instead of '40-windows' with the other Windows
# scripts? This needs to run after run_onchange_after_winget-configure.ps1.tmpl (in 40-windows/),
# which is what applies the WebAppInstallForceList registry policy and installs ungoogled-chromium
# in the first place.

{{/* PWA entries are embedded directly below, so this run_onchange_ script's own rendered content
     changes whenever .chezmoidata/pwas.toml changes -- no separate hash-embedding trick needed
     (same reasoning as run_onchange_after_vscode-profiles.py.tmpl's embedded PROFILES data).
     Entries with ignore_on containing "windows" are dropped here (and the key itself stripped)
     so they're never counted as expected installs on this platform. */}}
{{- $pwas := list }}
{{- range .pwas.entries }}
{{- if not (has "windows" (index . "ignore_on" | default list)) }}
{{- $pwas = append $pwas (omit . "ignore_on") }}
{{- end }}
{{- end }}
$PwaEntries = '{{ $pwas | toJson | replace "'" "''" }}' | ConvertFrom-Json

if ($PwaEntries.Count -eq 0) {
    exit 0
}

Write-Host "`nInstalling PWAs into ungoogled-chromium..." -ForegroundColor Green

# Installers write PATH changes to the registry, but this process's inherited $env:Path was
# captured before those writes happened -- rebuild it so a chromium.exe installed moments ago in
# this same apply run is actually resolvable (same trick as run_after_dependency-checker.ps1).
$env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path', 'User')

# ungoogled-chromium-windows deliberately keeps upstream Chromium's branding/paths (see its
# project docs: "will not modify the Chromium browser outside of the project's goals"), so an
# unbranded Chromium build's defaults apply: binary is chrome.exe, and -- since GOOGLE_CHROME_BUILD
# isn't defined -- its user-data dir is "Chromium", not "Google\Chrome" or "Google\ungoogled-chromium".
function Find-ChromiumExe {
    $Cmd = Get-Command chrome.exe -ErrorAction SilentlyContinue
    if ($Cmd) { return $Cmd.Source }

    # Fall back to the winget/MSI uninstall registry entries, which record where the installer put it.
    $UninstallRoots = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )
    $Entry = Get-ItemProperty -Path $UninstallRoots -ErrorAction SilentlyContinue |
        Where-Object { $_.DisplayName -like '*Chromium*' -and $_.InstallLocation } |
        Select-Object -First 1
    if ($Entry) {
        $Candidate = Join-Path $Entry.InstallLocation 'chrome.exe'
        if (Test-Path $Candidate) { return $Candidate }
    }

    foreach ($Root in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:LOCALAPPDATA)) {
        if (-not $Root) { continue }
        $Candidate = Join-Path $Root 'Chromium\Application\chrome.exe'
        if (Test-Path $Candidate) { return $Candidate }
    }

    return $null
}

$ChromiumExe = Find-ChromiumExe
if (-not $ChromiumExe) {
    Write-Host "Warning: could not find ungoogled-chromium's chrome.exe -- skipping PWA install. It should have been installed by winget configure; rerun 'chezmoi apply' once it is." -ForegroundColor Yellow
    exit 0
}

$ProfileDir = Join-Path $env:LOCALAPPDATA 'Chromium\User Data\Default'
$WebAppsDir = Join-Path $ProfileDir 'Web Applications'

# Chromium is now also this machine's general-purpose backup browser (installed in
# 7.apps-personal.configuration.winget), not a headless PWA host dedicated to just this list -- so
# Web Applications can accumulate folders for apps the user installed by hand, from a URL that
# later got removed from .chezmoidata/pwas.toml, or (during iterative testing of this very
# script) from earlier runs. An absolute folder count conflates all of that with genuinely new
# installs from *this* run, so snapshot what's there before launching and diff against it instead.
$BaselineFolders = if (Test-Path $WebAppsDir) { @((Get-ChildItem -Path $WebAppsDir -Directory -ErrorAction SilentlyContinue).Name) } else { @() }

function Get-NewPwaCount {
    if (-not (Test-Path $WebAppsDir)) { return 0 }
    return (Get-ChildItem -Path $WebAppsDir -Directory -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -notin $BaselineFolders } | Measure-Object).Count
}

# When the hidden background page load behind a forced install fails (timeout, redirect, or the
# browser being quit mid-load), Chromium falls back to installing a manifest-less, iconless
# placeholder app literally named after the install URL (e.g. a "https www.youtube.com" shortcut
# for https://www.youtube.com -- confirmed on-device) -- the Windows equivalent of macOS's
# URL-named `https/www.youtube.com.app` placeholder bundles. Its folder under Web Applications
# looks identical to a real install (opaque app-id name either way), but the Start Menu shortcut
# it creates is not: a real manifest-derived name is never going to start with "http(s) ".
function Get-PlaceholderShortcutCount {
    $StartMenuDir = Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs'
    if (-not (Test-Path $StartMenuDir)) { return 0 }
    return (Get-ChildItem -Path $StartMenuDir -Filter '*.lnk' -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object { $_.BaseName -match '^https?\s' } | Measure-Object).Count
}

# Registry policy is only guaranteed to be read fresh at process *startup* -- a running instance
# reloading WebAppInstallForceList live isn't reliable. Since Chromium is single-instance
# (launching chrome.exe while one is already running just forwards the args via IPC to it rather
# than starting a new process), any already-running instance -- left over from an earlier run of
# this very script, from manual testing, or from the user's own regular browsing, since Chromium
# is also this machine's general backup browser now -- would silently swallow every Start-Process
# call below into its own stale in-memory policy instead of actually picking up the new one. Force
# a truly fresh process by killing anything already running first, not just cleaning up after.
function Stop-ChromiumProcesses {
    $ChromiumDir = Split-Path $ChromiumExe
    Get-Process -Name 'chrome*' -ErrorAction SilentlyContinue |
        Where-Object { $_.Path -and $_.Path.StartsWith($ChromiumDir, [StringComparison]::OrdinalIgnoreCase) } |
        Stop-Process -Force -ErrorAction SilentlyContinue
}
Stop-ChromiumProcesses
Start-Sleep -Seconds 2  # let Windows release the profile's singleton lock before relaunching

# Launch minimized rather than bringing it to the foreground -- same non-disruptive intent as
# `open -g -a Chromium` on macOS. Chromium only actually acts on WebAppInstallForceList --
# downloading each app's manifest/icon and creating the installed web app -- once it's running.
Start-Process -FilePath $ChromiumExe -ArgumentList '--no-first-run' -WindowStyle Minimized

# The very first launch of a brand new profile is much slower than a warm one -- first-run
# component/cert-store setup, and (confirmed via the presence of vk_swiftshader.dll/libEGL.dll in
# the install dir) software-rendered GPU fallback on VMs with no passthrough GPU, which is
# considerably slower than hardware rendering. 10 minutes covers that cold-start case. This script
# can rerun for reasons other than the PWA list actually changing (e.g. an edit to this script's
# own content, which is also what its run_onchange_ gate keys off of) -- so a "warm" rerun where
# everything is already installed is a real case, not a hypothetical one, and is handled below.
$Retries = 120
$DelaySeconds = 5
function Wait-ForCondition {
    param([Parameter(Mandatory)] [scriptblock] $Condition, [string] $ProgressLabel)
    for ($i = 0; $i -lt $Retries; $i++) {
        if (& $Condition) { return }
        if ($i % 12 -eq 0) {
            Write-Host "$ProgressLabel ($($i * $DelaySeconds)s elapsed)..." -ForegroundColor DarkGray
        }
        Start-Sleep -Seconds $DelaySeconds
    }
}

# Get-NewPwaCount only ever counts folders that appeared *after* this run's baseline snapshot, so
# on a warm rerun where everything was already installed by an earlier run, it correctly stays 0
# forever -- that's not a failure, it's nothing left to do. $BaselineFolders.Count already meeting
# the target up front is exactly that case, and is checked first so it short-circuits immediately
# instead of waiting out the full retry budget for installs that were never going to happen.
Wait-ForCondition -Condition { ($BaselineFolders.Count -ge $PwaEntries.Count) -or ((Get-NewPwaCount) -ge $PwaEntries.Count) } -ProgressLabel "Waiting for Chromium's initial install attempt to finish"

# See the placeholder comment above -- re-navigating a tab to the install URL is what makes
# Chromium swap a placeholder for the real manifest-derived app, the same remedy the macOS role
# uses. Re-opening every URL regardless of which one(s) are actually placeholders is cheap and
# idempotent, so there's no need to map a placeholder shortcut back to a specific entry.
if ((Get-PlaceholderShortcutCount) -gt 0) {
    foreach ($Entry in $PwaEntries) {
        Start-Process -FilePath $ChromiumExe -ArgumentList '--no-first-run', $Entry.url -WindowStyle Minimized
        Start-Sleep -Seconds 1
    }
    Wait-ForCondition -Condition { (Get-PlaceholderShortcutCount) -eq 0 } -ProgressLabel "Waiting for placeholder installs to be replaced by real apps"
}

Stop-ChromiumProcesses

$PlaceholderCount = Get-PlaceholderShortcutCount
# Capped at $PwaEntries.Count so this doesn't reintroduce the earlier "3/1" confusion from
# unrelated pre-existing folders (the browser is also a general daily-use browser now) -- this is
# still just an estimate, not per-URL verification, since folder names are opaque app ids.
$AccountedForCount = [Math]::Min($PwaEntries.Count, $BaselineFolders.Count + (Get-NewPwaCount))
Write-Host "PWA install pass complete ($AccountedForCount/$($PwaEntries.Count) accounted for under $WebAppsDir -- $(Get-NewPwaCount) newly installed this run, $PlaceholderCount still placeholder)." -ForegroundColor Green
