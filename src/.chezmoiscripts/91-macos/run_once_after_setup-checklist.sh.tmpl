#!/usr/bin/env bash

# Drops a Markdown checklist of manual post-setup steps on the Desktop -- nothing opens it, since
# anyone using this to deploy their own OS config can be trusted to know how to open a Markdown
# file.
#
# run_once_ (not run_after_): chezmoi tracks completion in its own persistent state, so once this
# has run it never runs again on this machine, even if the checklist file is later deleted -- no
# self-healing. The test -f check below is just a defensive guard against ever clobbering an
# existing file, not the idempotency mechanism.
#
# Lives in 91-macos, past every other OS-specific script folder and past 90-all (which holds every
# cross-platform script), so directory sort order makes this the literal last thing `chezmoi apply`
# does whenever the OS config gets applied at all.

set -euo pipefail

SourceChecklist='{{ joinPath .chezmoi.sourceDir ".scriptdata/setup-checklist/macos.md" }}'
DesktopChecklist="$HOME/Desktop/SETUP-CHECKLIST.md"

if [ -f "$DesktopChecklist" ]; then
  echo -e "\033[2;37m\nSetup checklist already exists on Desktop -- leaving it (and any checked-off progress) alone.\033[0m"
  exit 0
fi

echo -e "\033[1;32m\nCreating setup checklist on Desktop...\033[0m"
cp "$SourceChecklist" "$DesktopChecklist"
