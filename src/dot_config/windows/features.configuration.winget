## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  ### Windows Optional Features Start
  - type: Microsoft.Windows/OptionalFeatureList
    name: WindowsOptionalFeatures
    metadata:
      winget:
        securityContext: elevated
    properties:
      features:
        - featureName: Containers
          state: Installed
        - featureName: NetFx3
          state: Installed
        - featureName: Microsoft-Hyper-V-All
          state: Installed
        - featureName: HypervisorPlatform
          state: Installed
        - featureName: Containers-DisposableClientVM
          state: Installed
        - featureName: SimpleTCP
          state: Installed
        - featureName: TelnetClient
          state: Installed
        - featureName: TFTP
          state: Installed
        - featureName: VirtualMachinePlatform
          state: Installed
        - featureName: Microsoft-Windows-Subsystem-Linux
          state: Installed
  ### Windows Optional Features End
  ### WSL Setup Start
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: WSLUpdate
    metadata:
      description: wsl --update is not idempotent-checkable, so this runs unconditionally on every apply; the command itself is a cheap no-op when already current.
    properties:
      executable: wsl
      arguments:
        - --update
  ### WSL Setup End
