## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyWindowsPowerShell
    properties:
      executable: powershell
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyPwsh
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  - type: Microsoft.PowerShell.PSResourceGet/PSResourceList
    name: WindowsDscModules
    metadata:
      winget:
        description: >-
          Requires PSResourceGet 1.3.0-preview1+ to already be installed before winget configure
          applies this file -- see the plain PowerShell install step in
          run_onchange_after_winget-configure.ps1.tmpl (not a winget configure resource). Tried
          two resource-based approaches first and both failed: an in-file RunCommandOnSet bootstrap
          doesn't work since winget's dscv3 processor resolves every declared resource type up
          front, before executing any resource's Set (confirmed via a real failure on a fresh
          machine); and a separate 1-init.configuration.winget file also didn't reliably work,
          since winget configure runs through WindowsPackageManagerServer, an out-of-process COM
          server that stays resident across invocations and caches its own resource resolution, so
          an already-running instance from before the install still wouldn't see the newly
          installed module.
    properties:
      repositoryName: PSGallery
      resources:
        - name: Microsoft.Windows.Settings
          preRelease: true
        - name: Microsoft.Windows.Developer
          preRelease: true
