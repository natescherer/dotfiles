## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  {{- $otfFonts := joinPath .chezmoi.homeDir ".local" "share" "chezmoifonts" "**.otf" | glob }}
  {{- $ttfFonts := joinPath .chezmoi.homeDir ".local" "share" "chezmoifonts" "**.ttf" | glob }}
  {{- range $fontPath := concat $otfFonts $ttfFonts }}
  {{- $fontFile := osBase $fontPath }}
  {{- $fontId := $fontFile | trimSuffix ".otf" | trimSuffix ".ttf" }}
  {{- $fontTypeLabel := "OpenType" }}
  {{- if hasSuffix ".ttf" $fontFile }}
  {{- $fontTypeLabel = "TrueType" }}
  {{- end }}
  - type: Microsoft.DSC.Transitional/PowerShellScript
    name: {{ $fontId }}
    metadata:
      winget:
        securityContext: elevated
      description: The registry value name is read from the font's own name table (family + style), matching what right-click "Install" does, rather than derived from the filename.
    properties:
      getScript: |
        Add-Type -AssemblyName PresentationCore
        $glyphTypeface = New-Object System.Windows.Media.GlyphTypeface((New-Object System.Uri('{{ $fontPath }}')))
        $family = $glyphTypeface.Win32FamilyNames['en-US']
        if (-not $family) { $family = ($glyphTypeface.Win32FamilyNames.Values | Select-Object -First 1) }
        $face = $glyphTypeface.Win32FaceNames['en-US']
        if (-not $face) { $face = ($glyphTypeface.Win32FaceNames.Values | Select-Object -First 1) }
        $registryName = if ($face -and $face -ne 'Regular') { "$family $face ({{ $fontTypeLabel }})" } else { "$family ({{ $fontTypeLabel }})" }
        return @{
          FileExists = (Test-Path "$env:windir\Fonts\{{ $fontFile }}")
          RegistryName = $registryName
        }
      testScript: |
        Add-Type -AssemblyName PresentationCore
        $glyphTypeface = New-Object System.Windows.Media.GlyphTypeface((New-Object System.Uri('{{ $fontPath }}')))
        $family = $glyphTypeface.Win32FamilyNames['en-US']
        if (-not $family) { $family = ($glyphTypeface.Win32FamilyNames.Values | Select-Object -First 1) }
        $face = $glyphTypeface.Win32FaceNames['en-US']
        if (-not $face) { $face = ($glyphTypeface.Win32FaceNames.Values | Select-Object -First 1) }
        $registryName = if ($face -and $face -ne 'Regular') { "$family $face ({{ $fontTypeLabel }})" } else { "$family ({{ $fontTypeLabel }})" }
        $fileOk = Test-Path "$env:windir\Fonts\{{ $fontFile }}"
        $regValue = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $registryName -ErrorAction SilentlyContinue).$registryName
        return ($fileOk -and ($regValue -eq '{{ $fontFile }}'))
      setScript: |
        Add-Type -AssemblyName PresentationCore
        $glyphTypeface = New-Object System.Windows.Media.GlyphTypeface((New-Object System.Uri('{{ $fontPath }}')))
        $family = $glyphTypeface.Win32FamilyNames['en-US']
        if (-not $family) { $family = ($glyphTypeface.Win32FamilyNames.Values | Select-Object -First 1) }
        $face = $glyphTypeface.Win32FaceNames['en-US']
        if (-not $face) { $face = ($glyphTypeface.Win32FaceNames.Values | Select-Object -First 1) }
        $registryName = if ($face -and $face -ne 'Regular') { "$family $face ({{ $fontTypeLabel }})" } else { "$family ({{ $fontTypeLabel }})" }
        Copy-Item -Path '{{ $fontPath }}' -Destination "$env:windir\Fonts\{{ $fontFile }}" -Force
        New-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $registryName -Value '{{ $fontFile }}' -PropertyType String -Force | Out-Null
  {{- end }}
