## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: PSResourceGetPreview
    metadata:
      winget:
        description: >-
          Microsoft.PowerShell.PSResourceGet/PSResourceList (used by 2-pwsh.configuration.winget's
          WindowsDscModules resource) only exists starting in PSResourceGet 1.3.0-preview1. This
          has to live in its own file, applied via its own separate 'winget configure' invocation
          that runs before 2-pwsh.configuration.winget's -- winget's dscv3 processor resolves
          every resource type declared in a single document up front, before executing any
          resource's Set, so bootstrapping this module from a resource inside the SAME file as
          WindowsDscModules doesn't work (confirmed via a real failure on a fresh machine:
          WindowsDscModules failed resource-type resolution before the in-file bootstrap
          resource's Set ever ran). A separate file means a separate resolution pass, by which
          time the module is already on disk.
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "if (-not (Get-Module -ListAvailable -Name Microsoft.PowerShell.PSResourceGet | Where-Object { $_.Version -ge [version]'1.3.0' })) { Install-PSResource -Name Microsoft.PowerShell.PSResourceGet -Prerelease -TrustRepository -Scope CurrentUser }"
