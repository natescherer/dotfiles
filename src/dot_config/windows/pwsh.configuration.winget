## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyWindowsPowerShell
    properties:
      executable: powershell
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: ExecutionPolicyPwsh
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "Set-ExecutionPolicy -ExecutionPolicy Unrestricted -Scope CurrentUser -Force"
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: PSResourceGetPreview
        # DSC Resource Microsoft.PowerShell.PSResourceGet/PSResourceList only exists starting in PSResourceGet 1.3.0-preview1, we need to make sure at least that version is installed here
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - "if (-not (Get-Module -ListAvailable -Name Microsoft.PowerShell.PSResourceGet | Where-Object { $_.Version -ge [version]'1.3.0' })) { Install-PSResource -Name Microsoft.PowerShell.PSResourceGet -Prerelease -TrustRepository }"
  - type: Microsoft.PowerShell.PSResourceGet/PSResourceList
    name: WindowsDscModules
    dependsOn:
      - PSResourceGetPreview # This is valid even though there's a schema error, see https://github.com/microsoft/winget-cli/issues/5906
    properties:
      repositoryName: PSGallery
      resources:
        - name: Microsoft.Windows.Settings
          preRelease: true
        - name: Microsoft.Windows.Developer
          preRelease: true
