{
  "files.associations": {
    "**/dot_ssh/*": "plaintext",
    "**/git/*": "plaintext",
    "**/src/.chezmoitemplates/vscode/**/*.json": "jsonc",
    "*.json.tmpl": "jsonc",
    "*.sh.tmpl": "shellscript",
    "*.ps1.tmpl": "go-template",
    "*.toml.tmpl": "toml",
    "*.winget.tmpl": "yaml",
    "*.yaml.tmpl": "go-template",
    "dot_wslconfig": "ini",
    "dot_zshenv.tmpl": "shellscript",
    "dot_zsh_aliases.tmpl": "shellscript",
    "dot_zshrc.tmpl": "shellscript",
  },
  "git.branchProtection": [],
  "go-template.patterns": [
    "**/*.tmpl",
    "**/.chezmoitemplates/**"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://aka.ms": true
  },
  "yaml.disableSchemaDetection": [
    "**/*.yaml.tmpl",
    "**/*.yml.tmpl",
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
    "azure-pipelines.yml",
    "azure-pipelines.yaml"
  ]
}
