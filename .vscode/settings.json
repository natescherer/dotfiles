{
  "files.associations": {
    "**/dot_ssh/*": "plaintext",
    "**/git/*": "plaintext",
    "**/src/.chezmoitemplates/vscode/**/*.json": "jsonc",
    "*.json.tmpl": "jsonc",
    "*.mobileconfig": "xml",
    "*.sh.tmpl": "shellscript",
    "*.ps1.tmpl": "powershell",
    "*.py.tmpl": "python",
    "*.toml.tmpl": "toml",
    "*.winget.tmpl": "yaml",
    "*.yaml.tmpl": "go-template",
    "dot_wslconfig": "ini",
    "dot_zshenv.tmpl": "shellscript",
    "dot_zsh-aliases.tmpl": "shellscript",
    "dot_zshrc.tmpl": "shellscript",
  },
  "[json]": {
    "files.insertFinalNewline": false, // Windows Terminal is brittle about settings format
    "files.trimFinalNewlines": false // Windows Terminal is brittle about settings format
  },
  "git.branchProtection": [],
  "python.analysis.ignore": [
    "**/*.py.tmpl"
  ],
  "go-template.patterns": [
    "**/*.tmpl",
    "**/.chezmoitemplates/**"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://aka.ms": true
  },
  "yaml.disableSchemaDetection": [
    "**/*.yaml.tmpl",
    "**/*.yml.tmpl",
    "azure-pipelines.yml",
    "azure-pipelines.yaml"
  ]
}
