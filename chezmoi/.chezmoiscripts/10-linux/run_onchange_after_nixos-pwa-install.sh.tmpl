#!/usr/bin/env bash

# Installs the shared PWA list on NixOS, whose flake provides PWAsForFirefox. Other OSes run the same
# installer from their own configuration. The rendered list and installer below make this script
# rerun whenever either changes.

set -euo pipefail

{{ $pwas := list -}}
{{ range .pwas.entries -}}
{{ if not (has "linux" (index . "ignore_on" | default list)) -}}
{{ $pwas = append $pwas (omit . "ignore_on") -}}
{{ end -}}
{{ end -}}
Installer=$(mktemp)
trap 'rm -f "$Installer"' EXIT

cat > "$Installer" <<'INSTALLER'
{{ template "pwa-install.sh" . -}}
INSTALLER

bash "$Installer" {{ $pwas | toJson | squote }}
