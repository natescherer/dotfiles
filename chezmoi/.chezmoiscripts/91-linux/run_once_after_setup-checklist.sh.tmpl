#!/usr/bin/env bash

# Drops a Markdown checklist of manual post-setup steps on the Desktop.
#
# run_once_: chezmoi records completion in its own state, so this never runs again on this machine,
# even if the checklist is later deleted. The test -f check only guards against clobbering an
# existing file.
#
# Lives in 91-linux, past every other script folder, so it's the last thing `chezmoi apply` does.

set -euo pipefail

SourceChecklist='{{ joinPath .chezmoi.sourceDir ".scriptdata/setup-checklist/ubuntu.md" }}'
DesktopDir="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
DesktopChecklist="$DesktopDir/SETUP-CHECKLIST.md"

if [ -f "$DesktopChecklist" ]; then
  echo -e "\033[2;37m\nSetup checklist already exists on Desktop; leaving it (and any checked-off progress) alone.\033[0m"
  exit 0
fi

echo -e "\033[1;32m\nCreating setup checklist on Desktop...\033[0m"
mkdir -p "$DesktopDir"
cp "$SourceChecklist" "$DesktopChecklist"
