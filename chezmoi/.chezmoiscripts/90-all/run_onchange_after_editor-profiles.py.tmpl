#!/usr/bin/env python3
# Installs each profile's extensions (from .chezmoidata/editors.toml) and syncs its settings.json
# into the relevant editor's own profile folder - user_dir itself for Default, or the
# machine-generated User/profiles/<hash>/ folder for named profiles. Drives both VS Code and
# VSCodium, since both are VS Code-family editors with identical profile/extension/settings.json
# mechanics -- just a different binary name and user-data folder.
#
# A profile's settings.json is only overwritten if it's untouched since the last time this
# script wrote it (tracked via a settings.json.chezmoi-hash sidecar file), so local customizations
# never get clobbered; if drift is detected, it warns instead of overwriting.

# Why is this in a folder called '90-all' instead of one of the OS-specific script folders?
# Directory order is what determines script execution order, and 90 is higher than every OS-specific
# install folder (10-linux, 20-linux-and-macos, 30-macos, 40-windows, 41-windows), so this runs
# after whatever those installed -- except the setup checklist, which intentionally sorts after
# this too, since it needs to be the definitive last thing `chezmoi apply` does.

import hashlib
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
import time

{{/* The section below embeds the content of .chezmoidata/editors.toml as well as the files under
.chezmoitemplates/editors, ensuring changes to those files will cause the hash of this file to
change, triggering the run_onchange_. */}}
{{- $editorDataList := list (dict "key" "vscode" "data" .vscode) (dict "key" "vscodium" "data" .vscodium) }}
{{- $editors := list }}
{{- range $editorDataList }}
{{- $editorKey := .key }}
{{- $editorData := .data }}
{{- $profiles := list }}
{{- $extensionSetDefns := $editorData.extension_sets | default (dict) }}
{{- range $editorData.profiles }}
{{- $icon := "" }}
{{- if ne .name "Default" }}
{{- $icon = .icon }}
{{- end }}
{{- $settingsEntries := list }}
{{- range $settingsFile := .settings_files | default (list) }}
{{- $fileContent := include $settingsFile | fromJsonc }}
{{- $settingsEntries = append $settingsEntries (dict "file" $settingsFile "content" $fileContent) }}
{{- end }}
{{- $extensions := list }}
{{- range $extensionSetName := .extension_sets | default (list) }}
{{- $extensionSetExtensions := index $extensionSetDefns $extensionSetName | default (list) }}
{{- range $extension := $extensionSetExtensions }}
{{- $extensions = append $extensions $extension }}
{{- end }}
{{- end }}
{{- range $extension := .extensions | default (list) }}
{{- $extensions = append $extensions $extension }}
{{- end }}
{{- $profiles = append $profiles (dict "name" .name "extensions" $extensions "settings_files" $settingsEntries "icon" $icon) }}
{{- end }}
{{- $editors = append $editors (dict
    "key" $editorKey
    "profiles" $profiles
    "all_profile_extensions" ($editorData.all_profile_extensions | default (list))
    "default_profile_is_placeholder" ($editorData.default_profile_is_placeholder | default false)
) }}
{{- end }}
# toJson renders true/false/null, which aren't valid Python literals (unlike True/False/None) --
# each embed below is wrapped as a raw string and parsed with json.loads instead of splicing it in
# as Python source directly, so booleans and backslashes in the data can't break the syntax.
EDITORS = json.loads(r'''{{ $editors | toJson }}''')

# .chezmoidata files can't be templated (data has to be loaded before the template engine has
# anything to execute templates with), so editors.toml's all_profile_extensions entries express
# their whenTrue/whenFalse gates as top-level chezmoi variable names rather than real template
# conditionals -- same convention windows-ini-patches.toml uses. The full chezmoi variable map is
# embedded here so those gates can be evaluated once this script actually runs.
CHEZMOI_DATA = json.loads(r'''{{ . | toJson }}''')

IS_WINDOWS = platform.system() == "Windows"

if IS_WINDOWS:
    # winget/MSI installs earlier in this same apply run write straight to the registry, but this
    # process's inherited os.environ["PATH"] was captured before those writes happened (env var
    # changes never propagate from a child process backward into an already-running parent).
    # Rebuilding PATH from the registry (Machine + User, same precedence Windows itself uses)
    # picks up anything installed this run -- see main()'s shutil.which() checks below.
    import winreg

    def _registry_path(hive, subkey):
        try:
            with winreg.OpenKey(hive, subkey) as key:
                value, _ = winreg.QueryValueEx(key, "Path")
                return value
        except FileNotFoundError:
            return ""

    _machine_path = _registry_path(winreg.HKEY_LOCAL_MACHINE, r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment")
    _user_path = _registry_path(winreg.HKEY_CURRENT_USER, "Environment")
    os.environ["PATH"] = _machine_path + os.pathsep + _user_path

# Normally, a profile's settings.json that has drifted from what chezmoi last wrote is left alone
# (see write_profile_settings) so local customizations never get silently clobbered. Setting this
# opts back into always overwriting it with what chezmoi wants instead, for both editors.
CHEZMOI_EDITOR_CLOBBER = os.environ.get("CHEZMOI_EDITOR_CLOBBER", "").lower() in ("1", "true", "yes")

# Setting an env var for a single command differs by shell, so give the warning below a copy-pasteable
# example matching however this script itself is actually being run.
CLOBBER_COMMAND = (
    '$env:CHEZMOI_EDITOR_CLOBBER = "true"; chezmoi apply'
    if IS_WINDOWS
    else "CHEZMOI_EDITOR_CLOBBER=true chezmoi apply"
)

CYAN_TERM_COLOR = "\033[0;36m"
BRIGHT_GREEN_TERM_COLOR = "\033[1;32m"
RED_TERM_COLOR = "\033[0;31m"
YELLOW_TERM_COLOR = "\033[1;33m"
RESET_TERM_STYLE = "\033[0m"

# Everything that differs between VS Code and VSCodium: the CLI binary name, the user-data folder
# name, and how to recognize the app's running processes (used by provision_profile to decide
# whether auto-closing a provisioning window is safe). Both editors otherwise share every code path
# below -- profile/extension/settings.json handling is identical VS Code-family machinery.
EDITORS_META = {
    "vscode": {
        "display_name": "VS Code",
        "binary": "code",
        "folder_name": "Code",
        "windows_process_image": "Code.exe",
        "macos_bundle_path": "Visual Studio Code.app/Contents/MacOS",
        "linux_process_pattern": r"/code(\s|$)",
    },
    "vscodium": {
        "display_name": "VSCodium",
        "binary": "codium",
        "folder_name": "VSCodium",
        "windows_process_image": "VSCodium.exe",
        "macos_bundle_path": "VSCodium.app/Contents/MacOS",
        "linux_process_pattern": r"/codium(\s|$)",
    },
}


def editor_user_dir(editor_key):
    folder_name = EDITORS_META[editor_key]["folder_name"]
    system = platform.system()
    if system == "Windows":
        return os.path.join(os.environ["APPDATA"], folder_name, "User")
    if system == "Darwin":
        return os.path.join(os.path.expanduser("~"), "Library", "Application Support", folder_name, "User")
    return os.path.join(os.path.expanduser("~"), ".config", folder_name, "User")


def run_editor(editor_key, *args):
    # The editor's CLI needs launched through a shell on Windows.
    binary = EDITORS_META[editor_key]["binary"]
    cmd = ["cmd", "/c", binary, *args] if IS_WINDOWS else [binary, *args]
    return subprocess.run(cmd, capture_output=True, text=True)


def list_extensions(editor_key, profile_name):
    profile_args = () if profile_name == "Default" else ("--profile", profile_name)
    result = run_editor(editor_key, *profile_args, "--list-extensions")
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def install_extension(editor_key, profile_name, extension_id):
    display_name = EDITORS_META[editor_key]["display_name"]
    profile_args = () if profile_name == "Default" else ("--profile", profile_name)
    print(f"{CYAN_TERM_COLOR}Installing '{extension_id}' into {display_name} profile '{profile_name}'...{RESET_TERM_STYLE}")
    result = run_editor(editor_key, *profile_args, "--install-extension", extension_id)
    if result.returncode != 0:
        print(
            f"{RED_TERM_COLOR}Error: failed to install '{extension_id}' into {display_name} profile "
            f"'{profile_name}' (exit code {result.returncode}). Re-run 'chezmoi apply' to try "
            f"again.{RESET_TERM_STYLE}\n{result.stdout}{result.stderr}",
            file=sys.stderr,
        )
        return False
    return True


def sync_extensions(editor_key, profile_name, desired_extensions):
    display_name = EDITORS_META[editor_key]["display_name"]
    desired = set(desired_extensions)
    installed = list_extensions(editor_key, profile_name)

    # Extension ids are case-insensitive to VS Code itself -- --list-extensions always reports
    # them lowercased regardless of the marketplace's own casing for the id (e.g. GitHub.vscode-
    # pull-request-github comes back as github.vscode-pull-request-github), so comparing raw
    # strings treats an already-installed extension as untracked/missing purely over letter case.
    installed_lower = {ext.lower() for ext in installed}
    desired_lower = {ext.lower() for ext in desired}

    all_succeeded = True
    for extension_id in sorted(desired, key=str.lower):
        if extension_id.lower() not in installed_lower:
            if not install_extension(editor_key, profile_name, extension_id):
                all_succeeded = False

    extra = sorted((ext for ext in installed if ext.lower() not in desired_lower), key=str.lower)
    if extra:
        print(
            f"{YELLOW_TERM_COLOR}Warning: {display_name} profile '{profile_name}' has the following extensions "
            f"installed that aren't tracked by chezmoi. They have not been uninstalled, but you "
            f"should consider adding them to '.chezmoidata/editors.toml': "
            f"{', '.join(extra)}{RESET_TERM_STYLE}\n",
            file=sys.stderr,
        )

    return all_succeeded


def extension_conditions_met(entry):
    # whenTrue requires every named variable to be True; whenFalse requires every named variable
    # to be anything other than True. A variable name missing from CHEZMOI_DATA resolves to None,
    # which satisfies whenFalse (it's not True) but fails whenTrue (it isn't True either) -- an
    # unset variable reads as falsy.
    for var_name in entry.get("whenTrue", []):
        if CHEZMOI_DATA.get(var_name) is not True:
            return False
    for var_name in entry.get("whenFalse", []):
        if CHEZMOI_DATA.get(var_name) is True:
            return False
    return True


class SettingsConflictError(Exception):
    def __init__(self, path, file_a, file_b, value_a, value_b):
        self.path = path
        self.file_a = file_a
        self.file_b = file_b
        self.value_a = value_a
        self.value_b = value_b
        path_str = ".".join(path) if path else "<root>"
        super().__init__(
            f"'{path_str}' is set to {value_a!r} in '{file_a}' and {value_b!r} in '{file_b}'"
        )


def _record_origins(origins, path, value, filename):
    # Tracks which file is responsible for each path in the merged tree, purely so a later
    # conflict can name the two files involved instead of just the two values.
    origins[path] = filename
    if isinstance(value, dict):
        for key, sub_value in value.items():
            _record_origins(origins, path + (key,), sub_value, filename)


def _merge_settings_values(existing, incoming, path, origins, incoming_file):
    if isinstance(existing, dict) and isinstance(incoming, dict):
        merged = dict(existing)
        for key, incoming_value in incoming.items():
            child_path = path + (key,)
            if key in existing:
                merged[key] = _merge_settings_values(
                    existing[key], incoming_value, child_path, origins, incoming_file
                )
            else:
                merged[key] = incoming_value
                _record_origins(origins, child_path, incoming_value, incoming_file)
        return merged

    if isinstance(existing, list) and isinstance(incoming, list):
        return existing + incoming

    if existing == incoming:
        return existing

    raise SettingsConflictError(path, origins.get(path, "<unknown>"), incoming_file, existing, incoming)


def merge_settings(settings_files):
    # Combines a profile's settings_files (in the order settings_files lists them) into one
    # settings.json: objects merge key-by-key (recursively), arrays at the same key concatenate,
    # and a key set to two different, incompatible values (including a type mismatch, like an
    # object in one file and an array in another) raises SettingsConflictError rather than
    # silently letting the later file win.
    merged = {}
    origins = {}
    for entry in settings_files:
        merged = _merge_settings_values(merged, entry["content"], (), origins, entry["file"])
    return merged


def hash_string(value):
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def find_editor_processes(editor_key):
    # Best-effort snapshot of every currently-running process for this editor (main window(s) plus
    # helpers), used by provision_profile to decide whether auto-closing a provisioning window is
    # safe. Returns None -- treated by callers the same as "the editor is already running" -- if
    # the platform's process-listing tool isn't available, since being wrong in that direction just
    # means falling back to the manual prompt below, not risking killing something we shouldn't.
    meta = EDITORS_META[editor_key]
    try:
        if IS_WINDOWS:
            result = subprocess.run(
                ["tasklist", "/FO", "CSV", "/FI", f"IMAGENAME eq {meta['windows_process_image']}", "/NH"],
                capture_output=True, text=True,
            )
            pids = set()
            for line in result.stdout.splitlines():
                # CSV row shape is "Image Name","PID","Session Name","Session#","Mem Usage" -- the
                # Mem Usage field itself contains a comma (e.g. "123,456 K"), but that's past the
                # PID we care about so a naive split still lands on the right field.
                fields = line.strip().split(",")
                if len(fields) >= 2 and fields[0].strip('"') == meta["windows_process_image"]:
                    pids.add(fields[1].strip('"'))
            return pids

        # On macOS every process for this editor -- main window and helpers alike -- has the .app
        # bundle path somewhere in its full command line, even though their process names differ.
        # Linux Electron helper processes re-exec the same CLI binary, so matching the bare name
        # catches those too.
        pattern = meta["macos_bundle_path"] if platform.system() == "Darwin" else meta["linux_process_pattern"]
        result = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
        return {line.strip() for line in result.stdout.splitlines() if line.strip()}
    except FileNotFoundError:
        return None


def kill_pids(pids):
    if not pids:
        return
    for pid in pids:
        try:
            if IS_WINDOWS:
                subprocess.run(["taskkill", "/PID", pid, "/F"], capture_output=True, text=True)
            else:
                os.kill(int(pid), signal.SIGKILL)
        except (ProcessLookupError, ValueError, OSError):
            pass


def wait_for_profile_registration(editor_key, user_dir, profile_name, retries=30, delay=2):
    display_name = EDITORS_META[editor_key]["display_name"]
    for attempt in range(retries):
        if get_profile_location(user_dir, profile_name) is not None:
            return True
        if attempt and attempt % 10 == 0:
            print(f"{CYAN_TERM_COLOR}Still waiting for {display_name} profile '{profile_name}' to register "
                  f"({attempt * delay}s elapsed)...{RESET_TERM_STYLE}")
        time.sleep(delay)
    return False


def provision_profile(editor_key, user_dir, profile_name):
    # The editor only registers a new profile in storage.json when it's opened as a real window, so
    # there's no way to create one headlessly. If no window for this editor is open anywhere on the
    # machine, we can launch one ourselves, wait for the registration to land, and close exactly
    # what we opened -- the same launch/wait/close-it-ourselves pattern
    # run_onchange_after_pwa-install.ps1.tmpl uses for Chromium. But if the editor is already
    # running (or we can't tell), a new profile just opens as another window inside that same
    # instance -- there's no way to single out and close only our new window without risking the
    # user's other open windows and unsaved work, so fall back to asking them to close it
    # themselves.
    display_name = EDITORS_META[editor_key]["display_name"]
    preexisting_processes = find_editor_processes(editor_key)
    if preexisting_processes is None or preexisting_processes:
        print(
            f"\n{YELLOW_TERM_COLOR}{display_name} profile '{profile_name}' needs to be provisioned before chezmoi can manage "
            f"it. After you press Enter, {display_name} will open with this profile. Close it once it appears. "
            f"This is a one-time process on this machine.{RESET_TERM_STYLE}"
        )
        input("Press Enter to continue... ")
        run_editor(editor_key, "--profile", profile_name, "--wait")
        return

    print(
        f"\n{CYAN_TERM_COLOR}{display_name} profile '{profile_name}' needs to be provisioned before chezmoi can manage "
        f"it; no {display_name} window is currently open, so provisioning it automatically (one-time process on this "
        f"machine)...{RESET_TERM_STYLE}"
    )
    run_editor(editor_key, "--profile", profile_name)
    if not wait_for_profile_registration(editor_key, user_dir, profile_name):
        print(f"{YELLOW_TERM_COLOR}{display_name} profile '{profile_name}' still hasn't registered after waiting; "
              f"closing the window anyway and leaving the retry to the caller.{RESET_TERM_STYLE}")
    kill_pids(find_editor_processes(editor_key))


def get_profile_location(user_dir, profile_name):
    storage_path = os.path.join(user_dir, "globalStorage", "storage.json")
    if not os.path.exists(storage_path):
        return None
    with open(storage_path, "r", encoding="utf-8") as f:
        storage = json.load(f)
    return next(
        (p.get("location") for p in storage.get("userDataProfiles", []) if p.get("name") == profile_name),
        None,
    )


def set_profile_icon(user_dir, profile_name, icon):
    # `<editor> --profile "Name"` creates the profile but doesn't set its icon (it defaults to the
    # editor's generic profile icon), so this patches it into storage.json to match editors.toml.
    if not icon:
        return

    storage_path = os.path.join(user_dir, "globalStorage", "storage.json")
    with open(storage_path, "r", encoding="utf-8") as f:
        storage = json.load(f)

    changed = False
    for p in storage.get("userDataProfiles", []):
        if p.get("name") == profile_name:
            if p.get("icon") != icon:
                p["icon"] = icon
                changed = True
            break

    if not changed:
        return

    # Write to a temp file and rename over the original (atomic on both Windows and POSIX) rather
    # than writing storage.json in place, so a crash mid-write can't leave it corrupted.
    tmp_path = storage_path + ".chezmoi-tmp"
    with open(tmp_path, "w", encoding="utf-8", newline="") as f:
        json.dump(storage, f, indent=4)
    os.replace(tmp_path, storage_path)


def write_profile_settings(editor_key, profile_name, profile_dir, settings_content):
    # Returns False when it left drifted/untracked settings.json alone instead of writing (i.e.
    # whenever it printed a warn_drifted message) -- the caller turns that into a non-zero exit,
    # the same "keep retrying every future apply" trick sync_editor's shutil.which() check already
    # uses for a missing editor binary. Without that, CHEZMOI_EDITOR_CLOBBER=true would only take
    # effect on an apply where chezmoi already decided to run this script for some unrelated reason
    # (this script's own content changed) -- a plain, unresolved drift wouldn't by itself cause
    # chezmoi to invoke this run_onchange_ script again to notice the flag.
    meta = EDITORS_META[editor_key]
    display_name = meta["display_name"]
    os.makedirs(profile_dir, exist_ok=True)
    settings_path = os.path.join(profile_dir, "settings.json")
    hash_path = os.path.join(profile_dir, "settings.json.chezmoi-hash")
    desired_path = os.path.join(profile_dir, "settings.json.chezmoi-desired")
    desired_hash = hash_string(settings_content)

    def write_settings():
        with open(settings_path, "w", encoding="utf-8", newline="") as f:
            f.write(settings_content)
        with open(hash_path, "w", encoding="utf-8", newline="") as f:
            f.write(desired_hash)
        if os.path.exists(desired_path):
            os.remove(desired_path)

    def warn_drifted(reason):
        # We're writing a copy of the contents here in case the source file is a template, which
        # couldn't be directly compared against. The copy will be cleaned up by future runs.
        with open(desired_path, "w", encoding="utf-8", newline="") as f:
            f.write(settings_content)
        print(
            f"{YELLOW_TERM_COLOR}Warning: {display_name} profile '{profile_name}' {reason}.\n"
            f"\n"
            f"Compare it against what chezmoi would write with:\n"
            f"{meta['binary']} --diff \"{settings_path}\" \"{desired_path}\"\n"
            f"\n"
            f"Then either reconcile the differences manually, or run the following to have chezmoi\n"
            f"overwrite it automatically:\n"
            f"    {CLOBBER_COMMAND}{RESET_TERM_STYLE}\n",
            file=sys.stderr,
        )

    if not os.path.exists(settings_path):
        write_settings()
        return True

    if not os.path.exists(hash_path):
        if CHEZMOI_EDITOR_CLOBBER:
            print(f"{CYAN_TERM_COLOR}{display_name} profile '{profile_name}' had an untracked settings.json; "
                  f"overwriting it since CHEZMOI_EDITOR_CLOBBER is set.{RESET_TERM_STYLE}\n")
            write_settings()
            return True
        warn_drifted("has a settings.json that is not chezmoi-managed")
        return False

    with open(hash_path, "r", encoding="utf-8", newline="") as f:
        last_written_hash = f.read().strip()
    with open(settings_path, "r", encoding="utf-8", newline="") as f:
        live_hash = hash_string(f.read())

    if live_hash != last_written_hash:
        if CHEZMOI_EDITOR_CLOBBER:
            print(f"{CYAN_TERM_COLOR}{display_name} profile '{profile_name}' had local changes to settings.json; "
                  f"overwriting them since CHEZMOI_EDITOR_CLOBBER is set.{RESET_TERM_STYLE}\n")
            write_settings()
            return True
        warn_drifted("has local changes to settings.json that aren't tracked in chezmoi; leaving it as-is")
        return False

    if os.path.exists(desired_path):
        os.remove(desired_path)

    if live_hash != desired_hash:
        write_settings()

    return True


def sync_editor(editor):
    key = editor["key"]
    meta = EDITORS_META[key]
    display_name = meta["display_name"]

    if shutil.which(meta["binary"]) is None:
        # Returning False (not exiting) here is deliberate: main() exits non-zero at the end if any
        # editor returned False, which is what makes chezmoi retry this script on every future
        # `chezmoi apply` -- even with this file's content otherwise unchanged -- until every editor
        # is actually on PATH. That's a more reliable "run once the editor becomes available"
        # trigger than a chezmoi-template-time lookPath check would be, since chezmoi's own process
        # can't see a PATH change from a script it spawned earlier in this same apply run -- a
        # template-time check here would wrongly skip the sync on the very run that just installed
        # the editor. Other editors still get synced this run regardless.
        print(f"{YELLOW_TERM_COLOR}{display_name} ('{meta['binary']}' command) not found; skipping its profile/extension sync.{RESET_TERM_STYLE}\n", file=sys.stderr)
        return False

    user_dir = editor_user_dir(key)

    # A profile named "Default" whose editor sets default_profile_is_placeholder is deliberately
    # kept minimal (see the comment in editors.toml) to nudge you into picking a real profile, so
    # it's excluded from all_profile_extensions. VSCodium's "Default" is a real, actively-used
    # profile instead, so it doesn't set that flag and gets the full treatment.
    gated_extensions = [
        entry["id"] for entry in editor["all_profile_extensions"] if extension_conditions_met(entry)
    ]

    all_succeeded = True

    for profile in editor["profiles"]:
        name = profile["name"]
        skip_gated_extensions = name == "Default" and editor["default_profile_is_placeholder"]
        extensions = profile["extensions"] if skip_gated_extensions else profile["extensions"] + gated_extensions

        if name == "Default":
            # Default always exists at a fixed path - no storage.json lookup, provisioning, or
            # icon needed (it's not one of the entries in storage.json's userDataProfiles).
            profile_dir = user_dir
        else:
            location = get_profile_location(user_dir, name)
            if location is None:
                provision_profile(key, user_dir, name)
                # On macOS, `<editor> --wait` resolves to a shell script that polls for the
                # Electron process to exit; it can return a moment before the editor's debounced
                # write of storage.json (where profile registration lands) actually reaches disk.
                # Windows' wait mechanism blocks until the process fully exits, so it doesn't race
                # this -- this retry is only ever needed on macOS, but it's harmless elsewhere.
                # The automatic path in provision_profile already polls for registration itself,
                # so this loop mainly exists for that macOS lag on the manual-close fallback.
                for attempt in range(10):
                    location = get_profile_location(user_dir, name)
                    if location is not None:
                        break
                    time.sleep(1)

            if location is None:
                print(
                    f"{RED_TERM_COLOR}Error: {display_name} profile '{name}' still isn't registered; skipping its "
                    f"extension and settings sync this run. Re-run 'chezmoi apply' to try again.{RESET_TERM_STYLE}\n",
                    file=sys.stderr,
                )
                all_succeeded = False
                continue

            set_profile_icon(user_dir, name, profile["icon"])
            profile_dir = os.path.join(user_dir, "profiles", location)

        if not sync_extensions(key, name, extensions):
            all_succeeded = False

        try:
            settings = merge_settings(profile["settings_files"])
        except SettingsConflictError as exc:
            print(
                f"{RED_TERM_COLOR}Error: {display_name} profile '{name}' has conflicting settings -- {exc}. "
                f"Resolve the conflict in the source files, then re-run 'chezmoi apply'.{RESET_TERM_STYLE}\n",
                file=sys.stderr,
            )
            all_succeeded = False
            continue

        settings_content = json.dumps(settings, indent=2, sort_keys=True) + "\n"
        if not write_profile_settings(key, name, profile_dir, settings_content):
            all_succeeded = False

    return all_succeeded


def main():
    print(f"{BRIGHT_GREEN_TERM_COLOR}Starting editor profile sync...{RESET_TERM_STYLE}\n")

    all_succeeded = True
    for editor in EDITORS:
        if not sync_editor(editor):
            all_succeeded = False

    if not all_succeeded:
        # Exiting non-zero (see sync_editor's shutil.which() check for why) so chezmoi retries this
        # script on the next apply instead of marking it done despite unsynced editors/extensions.
        print(f"{RED_TERM_COLOR}Editor profile sync finished with errors; re-run 'chezmoi apply' to retry.{RESET_TERM_STYLE}\n", file=sys.stderr)
        sys.exit(1)

    print(f"{BRIGHT_GREEN_TERM_COLOR}Editor profile sync complete!{RESET_TERM_STYLE}\n")


if __name__ == "__main__":
    main()
