#Requires -Version 7.0

# Real logic lives at the stable path below (a regular chezmoi-managed file, guaranteed already on
# disk by the time any run_after_ script executes) along with the PWA list it reads. The hashes
# below rerun this whenever the list or the script changes.
#
# In its own 41-windows folder so it runs after winget configure (40-windows), which installs
# PWAsForFirefox, and before the taskbar pins (42-windows), which pin some of the apps.

## pwas.toml hash: {{ joinPath .chezmoi.sourceDir ".chezmoidata/pwas.toml" | include | sha256sum }}
## pwa-install.ps1 hash: {{ joinPath .chezmoi.sourceDir "AppData/Local/WindowsWorkstationDSC/pwa-install.ps1" | include | sha256sum }}

# Installers write PATH changes to the registry, but this process's inherited $env:Path predates
# them; rebuild it so a firefoxpwa installed earlier in this same apply run is found.
$env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path', 'User')

& (Join-Path $env:LOCALAPPDATA 'WindowsWorkstationDSC\pwa-install.ps1')
exit $LASTEXITCODE
