#Requires -Version 7.0

# Checks the default app associations declared in .chezmoidata/windows-default-app-associations.toml
# against the defaults Windows actually resolves, and opens Settings > Apps > Default apps on each
# mismatched app's own page so it can be fixed in a couple of clicks. Windows 11 blocks setting
# these unattended on devices that aren't domain joined -- see that data file's header comment.
#
# Plain run_after_ (not run_once_/run_onchange_) so it re-checks every apply: an app update or
# Windows itself can reset a default at any time. Matching defaults make it a silent no-op.
#
# Runs after the winget configure script (40-windows/ sorts before this 41-windows/ script), which
# installs the apps referenced below.

# .chezmoidata files can't be templated -- data has to be loaded before the template engine has
# anything to execute templates with (see https://github.com/twpayne/chezmoi/issues/3526, still
# open) -- so the full chezmoi variable map is embedded below and read once this script actually
# runs, same trick run_onchange_after_windows-ini-patches.ps1.tmpl uses.
#
# get (not plain dot access) tolerates a missing windows_default_app_associations key -- chezmoi's
# strict template mode errors on plain dot access into a map that doesn't have the key, which a
# stripped-down/empty data file would trigger.
$AssociationsJson = @'
{{ get . "windows_default_app_associations" | default (list) | toJson }}
'@
$Associations = $AssociationsJson | ConvertFrom-Json
if (-not $Associations) { exit 0 }

# AssocQueryString returns the ProgId Windows itself resolves for a type, whichever storage format
# (UserChoice or UserChoiceLatest) backs it, so this needn't parse either one.
Add-Type -Namespace ChezmoiAssoc -Name Native -MemberDefinition @'
[DllImport("shlwapi.dll", CharSet = CharSet.Unicode)]
public static extern int AssocQueryString(int flags, int str, string assoc, string extra, System.Text.StringBuilder outBuf, ref int outLen);
'@

function Get-CurrentProgId {
  param([string] $Identifier)
  $ASSOCF_IS_PROTOCOL = 0x1000
  $ASSOCSTR_PROGID = 20
  $Flags = if ($Identifier.StartsWith('.')) { 0 } else { $ASSOCF_IS_PROTOCOL }
  $Length = 512
  $Buffer = [System.Text.StringBuilder]::new($Length)
  if ([ChezmoiAssoc.Native]::AssocQueryString($Flags, $ASSOCSTR_PROGID, $Identifier, $null, $Buffer, [ref]$Length) -ne 0) {
    return $null
  }
  return $Buffer.ToString()
}

# An app's installer registers a Capabilities\FileAssociations (extensions) or \URLAssociations
# (protocols) key under RegisteredApplications listing the ProgId it wants for each identifier it
# can handle. Per-machine installs register under HKLM, per-user installs under HKCU; Scope says
# which, since the Settings deep link below needs to know.
function Find-RegisteredApp {
  param([string] $AppNameMatch)
  foreach ($Scope in 'Machine', 'User') {
    $Hive = if ($Scope -eq 'Machine') { 'HKLM:' } else { 'HKCU:' }
    $RegisteredApps = Get-ItemProperty -Path "$Hive\SOFTWARE\RegisteredApplications" -ErrorAction SilentlyContinue
    if (-not $RegisteredApps) { continue }
    $Entries = @($RegisteredApps.PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' -and $_.Name -match $AppNameMatch })
    if ($Entries.Count -gt 1) {
      Write-Host "Warning: `"$AppNameMatch`" matches more than one registered app ($($Entries.Name -join ', ')) -- make it more specific." -ForegroundColor Yellow
      return $null
    }
    if ($Entries.Count -eq 1) {
      return [pscustomobject]@{
        Name             = $Entries[0].Name
        Scope            = $Scope
        CapabilitiesPath = "$Hive\$($Entries[0].Value.TrimStart('\'))"
      }
    }
  }
  return $null
}

# Mismatches grouped by app, so each app's Settings page opens once however many of its types are off.
$Mismatches = [ordered]@{}
foreach ($Association in $Associations) {
  $Identifier = $Association.identifier
  $App = Find-RegisteredApp -AppNameMatch $Association.appNameMatch
  if (-not $App) {
    Write-Host "Warning: no registered app matches `"$($Association.appNameMatch)`" for $Identifier -- skipping (not installed yet?)." -ForegroundColor Yellow
    continue
  }

  $CapabilitiesKey = if ($Identifier.StartsWith('.')) { 'FileAssociations' } else { 'URLAssociations' }
  $DesiredProgId = (Get-ItemProperty -Path "$($App.CapabilitiesPath)\$CapabilitiesKey" -Name $Identifier -ErrorAction SilentlyContinue).$Identifier
  if (-not $DesiredProgId) {
    Write-Host "Warning: $($App.Name) doesn't register itself as a handler for $Identifier -- skipping." -ForegroundColor Yellow
    continue
  }

  if ((Get-CurrentProgId -Identifier $Identifier) -ne $DesiredProgId) {
    if (-not $Mismatches.Contains($App.Name)) {
      $Mismatches[$App.Name] = [pscustomobject]@{ App = $App; Identifiers = [System.Collections.Generic.List[string]]::new() }
    }
    $Mismatches[$App.Name].Identifiers.Add($Identifier)
  }
}

if ($Mismatches.Count -eq 0) { exit 0 }

Write-Host "`nSome Windows default apps don't match the configuration:" -ForegroundColor Yellow
foreach ($Mismatch in $Mismatches.Values) {
  $App = $Mismatch.App
  Write-Host "  $($App.Name): $($Mismatch.Identifiers -join ', ')" -ForegroundColor Yellow
  # Opens Settings > Apps > Default apps directly on this app's page (Windows 11 23H2 and later).
  $Parameter = if ($App.Scope -eq 'Machine') { 'registeredAppMachine' } else { 'registeredAppUser' }
  Start-Process "ms-settings:defaultapps?$Parameter=$([Uri]::EscapeDataString($App.Name))"
}
Write-Host "Opened Default apps in Settings for each one -- set the types listed above there." -ForegroundColor Yellow
