#Requires -Version 7.0

# Applies the WinGet Configuration files that declaratively configure this Windows machine.
# Flow: preflight checks (Group Policy), prerequisite installs and upstream-bug workarounds, then
# one `winget configure` run per changed *.winget file, with recorded applied hashes so unchanged
# files are skipped on later runs. Files with elevated resources all run through one elevated
# worker process, so a run shows at most one UAC prompt. When a run ends with a reboot pending,
# the files it applied are listed for verification, and the first run after the reboot applies
# them once more.

# {{ $wingetConfigDirName := "winget-configuration-chezmoi" }}
# {{ $wingetConfigSourceDir := joinPath .chezmoi.sourceDir "AppData/Local" (print "exact_" $wingetConfigDirName) }}
# {{ $wingetConfigFiles := concat (joinPath $wingetConfigSourceDir "*.winget" | glob) (joinPath $wingetConfigSourceDir "*.winget.tmpl" | glob) | sortAlpha }}
# {{ if not $wingetConfigFiles }}{{ fail (print "no *.winget files found in " $wingetConfigSourceDir) }}{{ end }}

# {{/* Hashes below make this run_onchange_ script rerun when any *.winget[.tmpl] file
#      changes. Squeezed onto one line so "#" it all out to avoid pwsh parser errors */}}
# {{ "\n" }}{{ range $wingetConfigFiles }}## {{ base . }} hash: {{ include . | sha256sum }}{{ "\n" }}{{ end -}}

# chezmoi apply runs many scripts back to back with no indication which is running -- announce
# this one, since it can take a while.
Write-Host "`nApplying Windows configuration via winget configure..." -ForegroundColor Green
Write-Host "This may pause once for an elevation prompt, and may ask for a reboot at the end.`n" -ForegroundColor Green

# winget writes UTF-8 to stdout, including the shield glyph that marks elevated resources in
# `configure show` output (see Test-ConfigFileRequiresElevation below). Without this the
# console's default OEM code page mangles multi-byte output into unusable bytes when captured.
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

#region Paths and logging

$ConfigDir = Join-Path $env:LOCALAPPDATA "{{ $wingetConfigDirName }}"
New-Item -ItemType Directory -Path $ConfigDir -Force | Out-Null

# Discovered at runtime from the target dir -- the template block above hashes the *source*
# copies only to trigger reruns.
$ConfigFiles = (Get-ChildItem -Path $ConfigDir -Filter "*.winget" -File | Sort-Object Name).Name

# Everything this script writes (logs, applied hashes, the worker queue) lives here, outside
# $ConfigDir, which chezmoi manages in exact mode and so purges of anything it doesn't own.
$StateDir = Join-Path $env:LOCALAPPDATA 'AtomicWingetConfigure'
$AppliedHashesPath = Join-Path $StateDir 'applied-hashes.json'
# Files to apply once more after the next reboot, with the boot time of the run that listed them.
$VerifyListPath = Join-Path $StateDir 'verify-after-reboot.json'
# Runs every elevated configuration file for this script; see its header comment.
$WorkerScript = Join-Path $env:LOCALAPPDATA 'WindowsWorkstationDSC\winget-elevated-worker.ps1'

# winget's exit code isn't reliable (see bottom of script) and this runs unattended, so log
# everything -- otherwise a real failure leaves no record once the terminal closes. Timestamped
# per run, in its own subdirectory, rather than one path every run overwrites -- otherwise the
# evidence for a failure is gone as soon as a second run (even a successful one) happens before
# anyone looks.
$LogDir = Join-Path $StateDir 'Logs'
New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
$LogPath = Join-Path $LogDir "winget-configure_$(Get-Date -Format 'yyyy-MM-dd_HHmmss').log"
"Run started $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" | Set-Content -Path $LogPath

# Where winget writes its own diagnostic logs -- pointed to from failure log lines.
$WingetLogDir = Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\LocalState\DiagOutputDir'

# Appends to this script's log; accepts pipeline input so command output can stream into it.
function Write-Log {
  param([Parameter(ValueFromPipeline)] $Message)
  process { Add-Content -Path $LogPath -Value $Message }
}

#endregion

#region Console progress

# Whether the console can redraw a line in place. When output is redirected, spinners print one
# plain line per step instead.
$CanAnimate = -not [Console]::IsOutputRedirected
$SpinnerFrames = '|', '/', '-', '\'
$SpinnerFrame = 0

# Prints a header for each phase of the run, so the console shows which one is underway.
function Write-Step {
  param([Parameter(Mandatory)] [string] $Text)
  Write-Host "`n==> $Text" -ForegroundColor Green
  Write-Log "##### $Text #####"
}

# Prints an indented one-line result under the current step.
function Write-Detail {
  param([Parameter(Mandatory)] [string] $Text, [string] $Color = 'DarkGray')
  Write-Host "    $Text" -ForegroundColor $Color
}

# Redraws the spinner line in place with the next frame, $Text, and the elapsed seconds. Cut to
# the console width so it never wraps, since a wrapped line can't be redrawn in place.
function Write-SpinnerFrame {
  param([string] $Text, [timespan] $Elapsed)
  if (-not $CanAnimate) { return }
  $Line = "  {0} {1} ({2:N0}s)" -f $SpinnerFrames[$script:SpinnerFrame++ % $SpinnerFrames.Count], $Text, $Elapsed.TotalSeconds
  $Width = [Math]::Max([Console]::WindowWidth - 1, 20)
  if ($Line.Length -gt $Width) { $Line = $Line.Substring(0, $Width) }
  Write-Host -NoNewline ("`r" + $Line.PadRight($Width)) -ForegroundColor DarkGray
}

function Clear-SpinnerLine {
  if (-not $CanAnimate) { return }
  Write-Host -NoNewline ("`r" + ' ' * [Math]::Max([Console]::WindowWidth - 1, 20) + "`r")
}

# Runs $ScriptBlock on a background thread and draws a spinner until it finishes, so a slow step
# that prints nothing doesn't look hung. The block runs in its own runspace and can't see this
# script's variables or functions: pass what it needs through -ArgumentList. Returns the block's
# output, sets $LASTEXITCODE from the block's last native command (0 if none ran), and rethrows
# anything the block throws.
function Invoke-WithSpinner {
  param(
    [Parameter(Mandatory)] [string] $Activity,
    [Parameter(Mandatory)] [scriptblock] $ScriptBlock,
    [object[]] $ArgumentList = @()
  )
  if (-not $CanAnimate) { Write-Host "  $Activity..." -ForegroundColor DarkGray }
  $Job = Start-ThreadJob -ArgumentList $ScriptBlock.ToString(), $ArgumentList -ScriptBlock {
    param($Code, $CodeArgs)
    $global:LASTEXITCODE = 0
    try {
      $Output = & ([scriptblock]::Create($Code)) @CodeArgs
      [pscustomobject]@{ Output = @($Output); ExitCode = $LASTEXITCODE; Error = $null }
    }
    catch {
      [pscustomobject]@{ Output = @(); ExitCode = 1; Error = $_.Exception.Message }
    }
  }
  $Timer = [System.Diagnostics.Stopwatch]::StartNew()
  while (-not $Job.Finished.WaitOne(120)) {
    Write-SpinnerFrame -Text $Activity -Elapsed $Timer.Elapsed
  }
  Clear-SpinnerLine
  $Result = Receive-Job -Job $Job -Wait -AutoRemoveJob
  if ($Result.Error) { throw $Result.Error }
  $global:LASTEXITCODE = $Result.ExitCode
  $Result.Output
}

#endregion

#region Helpers

# Retries with exponential backoff to ride out transient network blips; every attempt is logged.
# Success is signaled through $LASTEXITCODE (0 = success): native commands set it themselves, and
# cmdlet-only script blocks succeed unless they throw. Callers inspect $LASTEXITCODE afterwards.
function Invoke-WithRetry {
  param(
    [Parameter(Mandatory)] [scriptblock] $ScriptBlock,
    [string] $Name = "operation",
    [int] $MaxAttempts = 3,
    [int] $InitialDelaySeconds = 5
  )
  $Delay = $InitialDelaySeconds
  for ($Attempt = 1; $Attempt -le $MaxAttempts; $Attempt++) {
    Write-Log "[retry] ${Name}: attempt $Attempt/$MaxAttempts"
    $global:LASTEXITCODE = 0  # don't inherit a stale value from an earlier native command
    try {
      & $ScriptBlock
    }
    catch {
      Write-Log "[retry] ${Name}: attempt $Attempt threw: $($_.Exception.Message)"
      $global:LASTEXITCODE = 1
    }
    if ($LASTEXITCODE -eq 0 -or $Attempt -ge $MaxAttempts) { return }
    Write-Host "`n$Name failed (exit code $LASTEXITCODE), retrying in ${Delay}s (attempt $Attempt/$MaxAttempts)..." -ForegroundColor DarkYellow
    Write-Log "[retry] ${Name}: attempt $Attempt failed with exit code $LASTEXITCODE, retrying in ${Delay}s"
    Start-Sleep -Seconds $Delay
    $Delay *= 2
  }
}

# $AppliedHashesPath maps each config file's path to the hash it was last applied against, so
# the apply loop can skip unchanged files.
function Get-ConfigFileHash {
  param([string] $Path)
  return (Get-FileHash -Path $Path -Algorithm SHA256).Hash
}

# A missing or unreadable file yields an empty map, i.e. every config file counts as changed.
function Get-AppliedHashes {
  try {
    $Hashes = Get-Content -Path $AppliedHashesPath -Raw -ErrorAction Stop | ConvertFrom-Json -AsHashtable
  }
  catch {
    $Hashes = $null
  }
  if ($Hashes -is [System.Collections.IDictionary]) { return $Hashes }
  return [ordered]@{}
}

function Set-ConfigFileAppliedHash {
  param([string] $Path)
  $Hashes = Get-AppliedHashes
  $Hashes[$Path] = Get-ConfigFileHash -Path $Path
  $Hashes | ConvertTo-Json | Set-Content -Path $AppliedHashesPath
}

# File renames queued for the next boot, each as "source -> destination". Installers queue these
# to replace files in use. The queue also holds deletes (an empty destination), which installers
# use to clean up rollback and temp files; those are left out, since no configuration waits on
# them.
function Get-PendingFileRenames {
  $SessionManager = Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -ErrorAction SilentlyContinue
  foreach ($Name in 'PendingFileRenameOperations', 'PendingFileRenameOperations2') {
    $Entries = @($SessionManager.$Name)
    for ($i = 0; $i + 1 -lt $Entries.Count; $i += 2) {
      if ($Entries[$i + 1]) { "$($Entries[$i]) -> $($Entries[$i + 1])" }
    }
  }
}

# winget configure gives no indication a resource left a reboot pending, so infer it from the
# registry. Checked once, at the end of the run. Two signals count:
# - Component Based Servicing's RebootPending key, set only when servicing (optional features,
#   WSL, Windows updates) can't finish a change until a reboot. Counted even if it was already
#   set when the run started, since a file applied this run may depend on that same reboot.
# - File renames queued during this run, compared against $FileRenamesAtStart, so renames left
#   behind by earlier installs don't count.
# Windows Update's RebootRequired key doesn't count: nothing this script applies sets it, and an
# update that needs a reboot to finish also sets the servicing key.
function Test-RebootPending {
  if (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') {
    Write-Log '=== reboot pending: Component Based Servicing\RebootPending is set ==='
    return $true
  }
  $NewRenames = @(Get-PendingFileRenames | Where-Object { $_ -notin $FileRenamesAtStart })
  if ($NewRenames.Count -gt 0) {
    Write-Log "=== reboot pending: file renames queued this run: $($NewRenames -join '; ') ==="
    return $true
  }
  return $false
}

# Asks winget itself whether applying a config file may prompt for elevation, rather than
# trusting the filename's METADATA convention (AppData/Local/winget-configuration-chezmoi/
# README.md) -- that's just a label a file's author sets, and it can drift out of sync with what
# the file's resources actually declare (e.g. a "personal-only" file that still elevates one
# registry write). `configure show` renders a file's resources without applying them, and winget
# marks each elevated resource with a shield glyph (U+1F6E1) in that output; there's no
# scriptable/JSON form of `show` to check instead. Defaults to $true (assume elevation, so the
# file goes to the elevated worker) if the check itself fails -- running a file elevated
# unnecessarily is safer than running elevated resources without elevation.
function Test-ConfigFileRequiresElevation {
  param([string] $Path)
  try {
    $Output = (Invoke-WithSpinner -Activity "Checking $(Split-Path -Leaf $Path)" -ArgumentList $Path -ScriptBlock {
        param($Path)
        winget configure show -f $Path --disable-interactivity 2>&1
      }) -join "`n"
    if ($LASTEXITCODE -ne 0) {
      Write-Log "=== 'winget configure show' for $Path exited ${LASTEXITCODE}: $Output -- assuming elevation required ==="
      return $true
    }
    return $Output.Contains([char]::ConvertFromUtf32(0x1F6E1))
  }
  catch {
    Write-Log "=== 'winget configure show' for $Path threw: $($_.Exception.Message) -- assuming elevation required ==="
    return $true
  }
}

# Queues `chezmoi apply` to rerun automatically at next logon, so applying the rest of the
# configuration doesn't wait on remembering to rerun it by hand. HKCU RunOnce (not a Scheduled
# Task) because it needs no elevation -- this script already runs unelevated -- and Windows
# deletes the value itself once it fires, so there's nothing to clean up on success. Fires at
# the next *interactive logon of this user*, which matches how this script itself is invoked.
function Register-ChezmoiApplyOnNextLogon {
  $ChezmoiExe = (Get-Command chezmoi -ErrorAction SilentlyContinue).Source
  if (-not $ChezmoiExe) {
    Write-Log "=== could not resolve chezmoi.exe on PATH -- skipping RunOnce registration ==="
    return $false
  }
  $WtExe = (Get-Command wt -ErrorAction SilentlyContinue).Source
  $PwshExe = (Get-Command pwsh -ErrorAction SilentlyContinue).Source
  $Command = if ($WtExe -and $PwshExe) {
    "`"$WtExe`" -- `"$PwshExe`" -NoExit -Command `"& '$ChezmoiExe' apply`""
  }
  else {
    "powershell.exe -NoExit -Command `"& '$ChezmoiExe' apply`""
  }
  Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce' -Name 'ChezmoiApply' -Value $Command
  Write-Log "=== registered RunOnce 'ChezmoiApply' to rerun 'chezmoi apply' at next logon ==="
  return $true
}

# The elevated worker process, started on demand by Start-ElevatedWorker; $null until then.
$Worker = $null
$WorkerQueueDir = $null
$WorkerRequestCount = 0

# Starts the elevated worker, which shows the run's one UAC prompt, and waits until it's polling
# its queue. Each run gets a fresh queue directory under $StateDir, kept afterwards alongside the
# logs.
function Start-ElevatedWorker {
  $script:WorkerQueueDir = Join-Path $StateDir "Worker\$(Get-Date -Format 'yyyy-MM-dd_HHmmss')"
  New-Item -ItemType Directory -Path $WorkerQueueDir -Force | Out-Null
  $ArgumentList = "-NoProfile -ExecutionPolicy Bypass -File `"$WorkerScript`" -QueueDir `"$WorkerQueueDir`" -ConfigDir `"$ConfigDir`" -ParentPid $PID"
  try {
    $script:Worker = Start-Process -FilePath (Get-Process -Id $PID).Path -ArgumentList $ArgumentList -Verb RunAs -WindowStyle Hidden -PassThru
  }
  catch {
    throw "Could not start the elevated worker ($($_.Exception.Message)) -- the UAC prompt may have been declined. Rerun 'chezmoi apply' and approve it."
  }
  $ReadyFile = Join-Path $WorkerQueueDir 'ready'
  $Timer = [System.Diagnostics.Stopwatch]::StartNew()
  while (-not (Test-Path $ReadyFile)) {
    if ($Worker.HasExited) {
      Clear-SpinnerLine
      throw "The elevated worker exited before it was ready (exit code $($Worker.ExitCode)). See $LogPath and rerun."
    }
    Write-SpinnerFrame -Text 'Starting the elevated worker' -Elapsed $Timer.Elapsed
    Start-Sleep -Milliseconds 120
  }
  Clear-SpinnerLine
  Write-Detail 'Elevated worker running.'
  Write-Log "=== elevated worker started (PID $($Worker.Id)), queue: $WorkerQueueDir ==="
}

# Queues one request for the elevated worker. Written by rename so the worker never reads a
# half-written file. Returns the request's id.
function Send-ElevatedRequest {
  param([Parameter(Mandatory)] [hashtable] $Request)
  $script:WorkerRequestCount++
  $Id = '{0:D4}' -f $WorkerRequestCount
  $RequestPath = Join-Path $WorkerQueueDir "request-$Id.json"
  $Request | ConvertTo-Json -Compress | Set-Content -Path "$RequestPath.tmp"
  Move-Item -Path "$RequestPath.tmp" -Destination $RequestPath -Force
  return $Id
}

# Runs one request through the elevated worker and waits for it, echoing the worker's output to
# the console and this script's log as it arrives. Sets $LASTEXITCODE like a native command, so
# Invoke-WithRetry works with it unchanged.
function Invoke-ElevatedRequest {
  param([Parameter(Mandatory)] [hashtable] $Request)
  $Id = Send-ElevatedRequest -Request $Request
  $LogFile = Join-Path $WorkerQueueDir "worker-$Id.log"
  $ResultFile = Join-Path $WorkerQueueDir "result-$Id.json"
  $LinesShown = 0
  # Resets on each new line of output, so the spinner shows how long winget has been quiet.
  $Timer = [System.Diagnostics.Stopwatch]::StartNew()
  while ($true) {
    # Checked before reading the log, so the final read includes every line written before the
    # result.
    $Done = Test-Path $ResultFile
    $Lines = @(Get-Content -Path $LogFile -ErrorAction SilentlyContinue)
    if ($LinesShown -lt $Lines.Count) {
      Clear-SpinnerLine
      $Timer.Restart()
    }
    for (; $LinesShown -lt $Lines.Count; $LinesShown++) {
      Write-Host $Lines[$LinesShown]
      Write-Log $Lines[$LinesShown]
    }
    if ($Done) { break }
    if ($Worker.HasExited) {
      Clear-SpinnerLine
      Write-Log "=== elevated worker exited unexpectedly (exit code $($Worker.ExitCode)) ==="
      $global:LASTEXITCODE = 1
      return
    }
    Write-SpinnerFrame -Text 'winget is working (elevated)' -Elapsed $Timer.Elapsed
    Start-Sleep -Milliseconds 120
  }
  Clear-SpinnerLine
  $global:LASTEXITCODE = [int](Get-Content -Path $ResultFile -Raw | ConvertFrom-Json).ExitCode
}

# Asks the elevated worker to exit. If this script stops early instead (e.g. a throw), the worker
# exits on its own once it sees this process is gone.
function Stop-ElevatedWorker {
  if (-not $Worker -or $Worker.HasExited) { return }
  Send-ElevatedRequest -Request @{ Kind = 'stop' } | Out-Null
  if (-not $Worker.WaitForExit(10000)) {
    Write-Log "=== elevated worker did not exit within 10s of a stop request ==="
  }
}

# Emits one message per use of DISM in a configuration file that is known to fail. DISM starts
# dismhost.exe outside any MSIX package, so a caller running inside one can't see the COM class
# dismhost.exe registers, and fails after a ~30-second hang:
# - DSC's own DISM resources, under the Appx-packaged dsc.exe that winget configure uses
#   (https://github.com/PowerShell/DSC/issues/1653, closed as a Windows limitation).
# - DISM cmdlets run by pwsh (PowerShellScript, or RunCommandOnSet with pwsh as its executable),
#   since PowerShell 7.7+ installs only as MSIX. The error there is "Class not registered"
#   (0x80040154).
# Windows PowerShell is never packaged, so WindowsPowerShellScript with the DISM cmdlets works,
# as does dism.exe. Line-based scan, grouping lines by the resource they belong to.
# Once https://github.com/PowerShell/PowerShell/issues/13866 is fixed, retest both cases: a fix
# in DISM or Windows covers both, but a fix in PowerShell alone covers only the pwsh case.
function Get-ConfigFileDismProblems {
  param([string] $Path)
  $DismResourceTypes = @(
    'Microsoft.Windows/OptionalFeatureList'
    'Microsoft.Windows/FeatureOnDemandList'
    'Microsoft.Windows/WindowsFeatureList'
  )
  $DismCmdletPattern = '\b[a-z]+-Windows(OptionalFeature|Capability|Package|Driver|Image|Edition)\b|\bImport-Module\s+(-Name\s+)?[''"]?Dism\b'
  $Fix = 'use Microsoft.DSC.Transitional/WindowsPowerShellScript with the DISM cmdlets instead'
  $File = Split-Path -Leaf $Path
  $Resources = [System.Collections.Generic.List[object]]::new()
  $Resource = $null
  $LineNumber = 0
  foreach ($Line in Get-Content -Path $Path) {
    $LineNumber++
    if ($Line -match '^\s*-\s*type:\s*[''"]?([^''"\s#]+)') {
      $Resource = [pscustomobject]@{ Type = $Matches[1]; Line = $LineNumber; Executable = $null; Cmdlets = [System.Collections.Generic.List[string]]::new() }
      $Resources.Add($Resource)
    }
    elseif ($Resource -and $Line -notmatch '^\s*#') {
      if ($Line -match '^\s*executable:\s*[''"]?([^''"\s#]+)') {
        $Resource.Executable = $Matches[1]
      }
      elseif ($Line -match $DismCmdletPattern) {
        $Resource.Cmdlets.Add("${File}:${LineNumber}: $($Matches[0])")
      }
    }
  }
  foreach ($Resource in $Resources) {
    if ($Resource.Type -in $DismResourceTypes) {
      "${File}:$($Resource.Line): $($Resource.Type) fails under the Appx-packaged DSC that winget configure uses -- $Fix."
    }
    elseif ($Resource.Type -eq 'Microsoft.DSC.Transitional/PowerShellScript' -or
      ($Resource.Type -eq 'Microsoft.DSC.Transitional/RunCommandOnSet' -and $Resource.Executable -and (Split-Path -Leaf $Resource.Executable) -in 'pwsh', 'pwsh.exe')) {
      $Resource.Cmdlets | ForEach-Object { "$_ in $($Resource.Type) fails under MSIX-packaged pwsh -- $Fix." }
    }
  }
}

# The newest installed PSResourceGet, if it satisfies the 1.3.0-preview1+ requirement of the
# Microsoft.PowerShell.PSResourceGet/PSResourceList resource; nothing otherwise.
function Get-SufficientPSResourceGet {
  Get-PSResource -Name Microsoft.PowerShell.PSResourceGet -ErrorAction SilentlyContinue |
  Where-Object { $_.Version -ge [version]'1.3.0' }
}

#endregion

#region Preflight

Write-Step 'Preflight checks'

# System-state snapshot for the log, useful for troubleshooting later.
try {
  $Os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
  $OsInfo = "$($Os.Caption) $($Os.Version) build $($Os.BuildNumber)"
}
catch {
  $OsInfo = "(unavailable)"
}
try {
  $DiskFreeGB = [math]::Round((Get-PSDrive -Name C -ErrorAction Stop).Free / 1GB, 2)
}
catch {
  $DiskFreeGB = "(unavailable)"
}
$WingetVersionRaw = (winget --version).Trim().TrimStart('v')
Write-Log "Preflight: OS=$OsInfo | PowerShell=$($PSVersionTable.PSVersion) | winget=$WingetVersionRaw | DiskFreeGB(C)=$DiskFreeGB | WingetLogDir=$WingetLogDir"

$MinimumWingetVersion = [version]'1.29.380'
# Preview/prerelease builds report a version like "1.30.140-preview", which [version] can't parse
# -- strip any "-suffix" before casting so those builds are compared on their numeric part alone.
$WingetVersion = [version]($WingetVersionRaw -replace '-.*$', '')
if ($WingetVersion -lt $MinimumWingetVersion) {
  throw "winget $WingetVersionRaw is unsupported -- winget $MinimumWingetVersion or newer is required. Update App Installer, then rerun."
}

# If winget configure is disabled by Group Policy, nothing below can work. Throw rather than
# warn -- the non-zero exit makes chezmoi retry on every `chezmoi apply` until the policy is
# fixed, with no repo change needed.
$PolicyPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppInstaller'
$PolicyValue = (Get-ItemProperty -Path $PolicyPath -Name 'EnableWindowsPackageManagerConfiguration' -ErrorAction SilentlyContinue).EnableWindowsPackageManagerConfiguration
if ($null -ne $PolicyValue -and [int]$PolicyValue -eq 0) {
  throw "winget configure is disabled by Group Policy ($PolicyPath\EnableWindowsPackageManagerConfiguration = 0). This is the 'Enable Windows Package Manager Configuration' ADMX policy (Computer Configuration > Administrative Templates > Windows Components > App Installer). Fix the policy, then rerun."
}
Write-Detail "winget $WingetVersionRaw, PowerShell $($PSVersionTable.PSVersion), $DiskFreeGB GB free on C:"

# Every file, not only changed ones, so a known-broken DISM use fails the run before any UAC
# prompt or install, with the fix, instead of failing partway with DISM's own error.
$DismProblems = @($ConfigFiles | ForEach-Object { Get-ConfigFileDismProblems -Path (Join-Path $ConfigDir $_) })
if ($DismProblems.Count -gt 0) {
  throw "DISM can't run where these configuration files call it (see https://github.com/PowerShell/PowerShell/issues/13866):`n  $($DismProblems -join "`n  ")"
}

# Renames already queued before anything below installs, so the reboot check at the end counts
# only the ones this run queued.
$FileRenamesAtStart = @(Get-PendingFileRenames)
Write-Log "Preflight: $($FileRenamesAtStart.Count) file rename(s) already queued for the next boot"

#endregion

#region Verify-after-reboot list

# A previous run that ended with a reboot pending listed the files it applied. Once the machine
# has rebooted since, those files count as needing apply this run, so their effects are checked
# against the post-reboot state. Before that reboot, the list just carries over to the end of
# this run.
$VerifyFiles = @()
$PendingVerifyFiles = @()
# Derived from uptime, which needs no CIM query. It jitters by milliseconds between runs, hence
# the one-minute margin below.
$BootTime = (Get-Date) - [timespan]::FromMilliseconds([Environment]::TickCount64)
try {
  $VerifyList = Get-Content -Path $VerifyListPath -Raw -ErrorAction Stop | ConvertFrom-Json
}
catch {
  $VerifyList = $null
}
if ($VerifyList) {
  if ($BootTime -gt ([datetime]$VerifyList.BootTime).AddMinutes(1)) {
    $VerifyFiles = @($VerifyList.Files)
    Write-Log "=== rebooted since the verify list was written -- verifying: $($VerifyFiles -join ', ') ==="
  }
  else {
    $PendingVerifyFiles = @($VerifyList.Files)
    Write-Log "=== verify list still waiting on a reboot: $($PendingVerifyFiles -join ', ') ==="
  }
}
if ($VerifyFiles.Count -gt 0) {
  Write-Detail "Rebooted since the last run: verifying $($VerifyFiles.Count) file(s) it applied." -Color Yellow
}
elseif ($PendingVerifyFiles.Count -gt 0) {
  Write-Detail "$($PendingVerifyFiles.Count) file(s) from an earlier run still wait on a reboot to be verified." -Color Yellow
}

# Configuration files to apply this run: changed since their last apply, or listed for
# verification after a reboot. Decided once, before the apply loop records new hashes.
$AppliedHashes = Get-AppliedHashes
$FilesToApply = @($ConfigFiles | Where-Object {
    $Path = Join-Path $ConfigDir $_
    ($Path -in $VerifyFiles) -or ($AppliedHashes[$Path] -ne (Get-ConfigFileHash -Path $Path))
  })
Write-Log "=== files to apply: $($FilesToApply -join ', ') ==="

#endregion

#region Prerequisites and upstream workarounds

Write-Step 'Prerequisites'

# Fresh machines refuse `winget configure` until its extended-features flag is enabled once.
# `--enable`/`--disable` must be passed alone -- newer winget rejects it combined with any other
# argument (including --verbose-logs) with "Option '--enable' and '--disable' cannot be used with
# other arguments."
$AtomicWingetConfigureKey = 'HKCU:\Software\AtomicWingetConfigure'
$ExtendedFeaturesValueName = 'ExtendedFeaturesEnabled'
$ExtendedFeaturesEnabled = (Get-ItemProperty -Path $AtomicWingetConfigureKey -Name $ExtendedFeaturesValueName -ErrorAction SilentlyContinue).$ExtendedFeaturesValueName -eq 1
if ($ExtendedFeaturesEnabled) {
  Write-Log "=== winget configure extended features already enabled ==="
}
else {
  Write-Host "`nEnabling winget configure extended features..." -ForegroundColor Cyan
  Write-Log "=== winget configure --enable ==="
  winget configure --enable
  if ($LASTEXITCODE -ne 0) {
    throw "Failed to enable winget configure extended features (exit code $LASTEXITCODE) -- update App Installer or see $LogPath and rerun."
  }
  New-Item -Path $AtomicWingetConfigureKey -Force | Out-Null
  New-ItemProperty -Path $AtomicWingetConfigureKey -Name $ExtendedFeaturesValueName -Value 1 -PropertyType DWord -Force | Out-Null
  Write-Log "=== recorded winget configure extended-features enablement in $AtomicWingetConfigureKey ==="
}

# winget configure needs the VC++ 2015+ x64 redistributable when run non-elevated, and fails
# with an opaque internal error without it -- self-heal by installing it directly.
$VCRedistKey = 'HKLM:\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64'
if ((Get-ItemProperty -Path $VCRedistKey -Name 'Installed' -ErrorAction SilentlyContinue).Installed -ne 1) {
  Write-Host "Microsoft Visual C++ Redistributable 2015+ (x64) not found -- installing (winget configure can fail with an internal error without it)..." -ForegroundColor Yellow
  Write-Log "=== Installing Microsoft.VCRedist.2015+.x64 ==="
  Invoke-WithRetry -Name 'Microsoft.VCRedist.2015+.x64 install' -ScriptBlock {
    winget install --id 'Microsoft.VCRedist.2015+.x64' --source winget --accept-package-agreements --accept-source-agreements --disable-interactivity --verbose-logs
  }
  if ($LASTEXITCODE -ne 0) {
    Write-Log "=== winget's own diagnostic logs for this failure: $WingetLogDir ==="
    throw "Failed to install Microsoft.VCRedist.2015+.x64 (exit code $LASTEXITCODE) -- winget configure is likely to fail without it. See $LogPath and rerun."
  }
}

# The Microsoft.PowerShell.PSResourceGet/PSResourceList resource needs PSResourceGet 1.3.0-preview1+.
if (-not (Get-SufficientPSResourceGet)) {
  Write-Log "=== Installing Microsoft.PowerShell.PSResourceGet (prerelease) ==="
  try {
    Invoke-WithSpinner -Activity 'Installing PSResourceGet 1.3.0+' -ScriptBlock {
      Install-PSResource -Name Microsoft.PowerShell.PSResourceGet -Prerelease -TrustRepository -Scope CurrentUser -ErrorAction Stop *>&1 | Out-String
    } | Write-Log
  }
  catch {
    Write-Log "PSResourceGet install threw: $($_.Exception.Message)"
  }
  $PSResourceGetInstalled = Get-SufficientPSResourceGet
  if (-not $PSResourceGetInstalled) {
    Write-Host "Warning: failed to install PSResourceGet 1.3.0+ . See $LogPath" -ForegroundColor Yellow
  }
  else {
    Write-Detail "Installed PSResourceGet $($PSResourceGetInstalled.Version) $($PSResourceGetInstalled.Prerelease)"
    Write-Log "=== PSResourceGet install verified: $($PSResourceGetInstalled.Version) $($PSResourceGetInstalled.Prerelease) ==="
    # winget configure runs through WindowsPackageManagerServer, a COM server that stays resident
    # across invocations (confirmed: one ran for over a week) and caches its DSC resource
    # resolution -- an already-running instance won't see the just-installed module, so
    # WindowsDscModules would fail with "Resource not found" despite it being on disk. Kill it
    # to force a fresh instance.
    Get-Process -Name WindowsPackageManagerServer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    Write-Log "=== restarted WindowsPackageManagerServer after installing PSResourceGet ==="
  }
}

Write-Detail 'Prerequisites in place.'

#endregion

#region Elevated worker

Write-Step 'Elevation'

# Files to apply that winget would elevate for. They all run through one elevated worker, so the
# run shows a single UAC prompt instead of one per file.
$ElevatedFiles = @($FilesToApply | Where-Object {
    $RequiresElevation = Test-ConfigFileRequiresElevation -Path (Join-Path $ConfigDir $_)
    Write-Detail "${_}: $(if ($RequiresElevation) { 'elevated' } else { 'unelevated' })"
    $RequiresElevation
  })
Write-Log "=== files to apply elevated: $($ElevatedFiles -join ', ') ==="
if ($ElevatedFiles.Count -eq 0) {
  Write-Detail 'Nothing to apply needs elevation.'
}
else {
  Write-Host "`n$($ElevatedFiles.Count) file(s) need elevation. Expect one UAC prompt for all of it." -ForegroundColor Yellow
  Write-Host "Press Enter once you're ready to approve it..." -ForegroundColor Yellow -NoNewline
  Read-Host | Out-Null
  Start-ElevatedWorker
}

#endregion

#region Apply configuration files

Write-Step 'Applying configuration files'

$AppliedFiles = [System.Collections.Generic.List[string]]::new()
# One row per configuration file for the summary at the end.
$Results = [System.Collections.Generic.List[pscustomobject]]::new()
foreach ($File in $ConfigFiles) {
  $Path = Join-Path $ConfigDir $File
  if ($File -notin $FilesToApply) {
    Write-Detail "Skipping $File -- unchanged since last successful apply."
    Write-Log "=== ${File}: unchanged, skipping ==="
    $Results.Add([pscustomobject]@{ File = $File; Result = 'skipped (unchanged)'; Seconds = $null; Ok = $true })
    continue
  }
  $FileTimer = [System.Diagnostics.Stopwatch]::StartNew()
  if ($Path -in $VerifyFiles) {
    Write-Log "=== ${File}: verifying after reboot ==="
  }
  else {
    Write-Log "=== ${File}: changed ==="
  }

  $Elevated = $File -in $ElevatedFiles
  Write-Host "`nApplying $File via 'winget configure'$(if ($Elevated) { ' (elevated)' })..." -ForegroundColor Cyan
  $ConfigureArgs = @('-f', $Path, '--accept-configuration-agreements', '--disable-interactivity', '--suppress-initial-details', '--verbose-logs', '--ignore-warnings')
  Invoke-WithRetry -Name $File -ScriptBlock {
    if ($Elevated) {
      Invoke-ElevatedRequest -Request @{ Kind = 'configure'; Args = $ConfigureArgs }
    }
    else {
      winget configure @ConfigureArgs
    }
  }
  Write-Log "--- exit code: $LASTEXITCODE ---"
  $Result = if ($Path -in $VerifyFiles) { 'verified after reboot' } else { 'applied' }
  if ($Elevated) { $Result += ' (elevated)' }
  $Ok = $LASTEXITCODE -eq 0
  if (-not $Ok) {
    Write-Log "=== winget's own diagnostic logs for this failure: $WingetLogDir ==="
    Write-Host "Warning: $File exited with code $LASTEXITCODE after retries. This may be a benign warning (e.g. 'module not provided') or a real failure -- see $LogPath" -ForegroundColor Yellow
    $Result += ", exit code $LASTEXITCODE"
  }
  $Results.Add([pscustomobject]@{ File = $File; Result = $Result; Seconds = [int]$FileTimer.Elapsed.TotalSeconds; Ok = $Ok })

  # Recorded regardless of winget's exit code (unreliable, see bottom of script) -- gating on a
  # clean exit would permanently defeat the skip check for files with benign non-zero warnings.
  Set-ConfigFileAppliedHash -Path $Path
  $AppliedFiles.Add($Path)
}

Stop-ElevatedWorker

#endregion

#region Summary

Write-Step 'Summary'
$NameWidth = ($Results.File | Measure-Object -Property Length -Maximum).Maximum
foreach ($Row in $Results) {
  $Time = if ($null -ne $Row.Seconds) { " ($($Row.Seconds)s)" } else { '' }
  $Color = if (-not $Row.Ok) { 'Yellow' } elseif ($null -eq $Row.Seconds) { 'DarkGray' } else { 'Gray' }
  Write-Host "    $($Row.File.PadRight($NameWidth))  $($Row.Result)$Time" -ForegroundColor $Color
  Write-Log "summary: $($Row.File): $($Row.Result)$Time"
}
Write-Detail "Log: $LogPath"

#endregion

#region Reboot check

# Resources such as optional features or WSL can leave a reboot pending that winget configure
# won't report. Files applied this run get listed for one more apply after the reboot, along with
# any listed by an earlier run still waiting on that reboot. Files verified this run aren't listed
# again, so a reboot flag that keeps reappearing (e.g. from Windows Update) can't cause a loop.
$ToVerify = @(@($PendingVerifyFiles) + @($AppliedFiles | Where-Object { $_ -notin $VerifyFiles }) | Select-Object -Unique)
Remove-Item -Path $VerifyListPath -Force -ErrorAction SilentlyContinue

if (Test-RebootPending) {
  if ($ToVerify.Count -gt 0) {
    [ordered]@{ BootTime = $BootTime.ToString('o'); Files = $ToVerify } | ConvertTo-Json | Set-Content -Path $VerifyListPath
    Write-Log "=== reboot pending at end of run -- listed for verification after reboot: $($ToVerify -join ', ') ==="
    if (Register-ChezmoiApplyOnNextLogon) {
      Write-Host "`nWindows configuration applied. Reboot -- 'chezmoi apply' reruns automatically at next logon to verify $($ToVerify.Count) file(s)." -ForegroundColor Yellow
    }
    else {
      Write-Host "`nWindows configuration applied. Reboot, then rerun 'chezmoi apply' to verify $($ToVerify.Count) file(s)." -ForegroundColor Yellow
    }
    # Non-zero so chezmoi reruns this run_onchange_ script on the next apply even if nothing else
    # changed; on success it would record the script as done and skip the verification run.
    exit 1
  }
  Write-Host "`nWindows configuration applied. A reboot is needed to finish putting it into effect." -ForegroundColor Yellow
  Write-Log "=== reboot pending at end of run, nothing left to verify ==="
}
else {
  Write-Host "`nWindows configuration applied -- no reboot needed." -ForegroundColor Green
}

#endregion

# winget's exit code isn't reliable even on success (e.g. benign "module not provided" warnings)
# -- real failures are already visible above and logged to $LogPath.
exit 0
