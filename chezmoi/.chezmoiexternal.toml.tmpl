{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
    {{- $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
    {{- $fontDir = ".local/share/fonts" }}
{{- else if eq .chezmoi.os "windows" }}
    {{- $fontDir = "AppData/Local/chezmoifonts" }} ##@ This is a staging directory, fonts deposited here will be later installed as part of winget configure
{{- end }}
{{- /* renovate: datasource=github-releases depName=microsoft/cascadia-code */ -}}
{{- $cascadiaVersion := "2407.24" }}
{{- /* renovate: datasource=github-releases depName=RedHatOfficial/Overpass */ -}}
{{- $overpassVersion := "3.0.5" }}
{{- if not eq .chezmoi.os "darwin" }}
{{- /* Both of these fonts are Homebrew-installable */ -}}
["{{ $fontDir }}/CascadiaMonoNF-Regular.otf"]
    type = "archive-file"
    url = "https://github.com/microsoft/cascadia-code/releases/download/v{{ $cascadiaVersion }}/CascadiaCode-{{ $cascadiaVersion }}.zip"
    path = "otf/static/CascadiaMonoNF-Regular.otf"
["{{ $fontDir }}/overpass-regular.otf"]
    type = "archive-file"
    url = "https://github.com/RedHatOfficial/Overpass/releases/download/v{{ $overpassVersion }}/overpass-{{ $overpassVersion }}.zip"
    path = "Overpass-{{ $overpassVersion }}/desktop-fonts/overpass/overpass-regular.otf"
{{- end }}
