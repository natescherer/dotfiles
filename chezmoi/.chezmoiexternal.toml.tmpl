{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
    {{- $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
    {{- $fontDir = ".local/share/fonts" }}
{{- else if eq .chezmoi.os "windows" }}
    {{- /* This is a staging directory, fonts will be installed from here as part of WinGet configuration */ -}}
    {{- $fontDir = "AppData/Local/chezmoifonts" }}
{{- end }}
{{- /* renovate: datasource=github-releases depName=ryanoasis/nerd-fonts */ -}}
{{- $nerdFontsVersion := "3.5.1" }}
{{- /* renovate: datasource=github-releases depName=RedHatOfficial/Overpass */ -}}
{{- $overpassVersion := "3.0.5" }}
{{- /* renovate: datasource=github-releases depName=kdeldycke/meta-package-manager */ -}}
{{- $mpmVersion := "8.0.2" }}
{{- if and (ne .chezmoi.os "darwin") .isWorkstation }}
{{- /* Both of these fonts are Homebrew-installable, and only workstations have a desktop to render them */ -}}
{{- /* The Nerd Fonts project's Cascadia Mono build, whose icons are drawn wider than one cell */ -}}
{{- range list "Regular" "Bold" "Italic" "BoldItalic" }}
["{{ $fontDir }}/CaskaydiaMonoNerdFont-{{ . }}.ttf"]
    type = "archive-file"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v{{ $nerdFontsVersion }}/CascadiaMono.zip"
    path = "CaskaydiaMonoNerdFont-{{ . }}.ttf"
{{- end }}
["{{ $fontDir }}/overpass-regular.otf"]
    type = "archive-file"
    url = "https://github.com/RedHatOfficial/Overpass/releases/download/v{{ $overpassVersion }}/overpass-{{ $overpassVersion }}.zip"
    path = "Overpass-{{ $overpassVersion }}/desktop-fonts/overpass/overpass-regular.otf"
{{- end }}
{{- if eq .chezmoi.os "windows" }}
{{- /* Not in the winget catalog; macOS gets it from Homebrew instead */}}
["bin/mpm.exe"]
    type = "file"
    executable = true
    url = "https://github.com/kdeldycke/meta-package-manager/releases/download/v{{ $mpmVersion }}/meta-package-manager-{{ $mpmVersion }}-windows-{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64{{ end }}.exe"
{{- end }}
