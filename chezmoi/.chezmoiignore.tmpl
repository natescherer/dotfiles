# Ignore on Linux
## macOS folders
Library/**
## macOS scripts
.chezmoiscripts/30-macos/**
.chezmoiscripts/91-macos/**
## Windows folders/files
AppData/**
Documents/**
dot_wslconfig
## Windows scripts
.chezmoiscripts/40-windows/**
.chezmoiscripts/41-windows/**
.chezmoiscripts/42-windows/**
.chezmoiscripts/91-windows/**
.chezmoiscripts/00-all/mise-checker.ps1
## Windows data
.chezmoidata/windows-ini-patches.toml
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Ignore on macOS
## Linux folders
.config/mpm/**
.config/systemd/**
.local/libexec/**
.local/share/ansible-configuration-chezmoi/**
## Linux scripts
.chezmoiscripts/10-linux/**
.chezmoiscripts/91-linux/**
## Windows folders/files
AppData/**
Documents/**
dot_wslconfig
## Windows scripts
.chezmoiscripts/40-windows/**
.chezmoiscripts/41-windows/**
.chezmoiscripts/42-windows/**
.chezmoiscripts/91-windows/**
.chezmoiscripts/00-all/mise-checker.ps1
## Windows data
.chezmoidata/windows-ini-patches.toml
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Ignore on Windows
## Ghostty
.config/ghostty/**
## Linux folders
.config/mpm/**
.config/systemd/**
.local/libexec/**
.local/share/ansible-configuration-chezmoi/**
## Linux/macOS scripts
.chezmoiscripts/10-linux/**
.chezmoiscripts/91-linux/**
.chezmoiscripts/20-linux-and-macos/**
.chezmoiscripts/30-macos/**
.chezmoiscripts/91-macos/**
.chezmoiscripts/00-all/mise-checker.sh
## macOS folders
Library/**
## Sheldon config
.config/sheldon/**
## SSH
.ssh/**
## Zsh
.zshenv
.config/zsh/**
{{- end }}

{{- if eq .isPersonal false }}
# Personal Configuration
git/gh/**
## Skip winget configuration tagged as personal
AppData/Local/winget-configuration-chezmoi/*.{p,ep}.winget*
.chezmoiscripts/40-windows/office-install.ps1
## Skip ansible var files tagged as personal
Library/Application Support/ansible-configuration-chezmoi/group_vars/all/*.p.yml*
.local/share/ansible-configuration-chezmoi/group_vars/all/*.p.yml*
{{- end }}

{{- if eq .adminRights false }}
# Skip winget configuration tagged as needed elevation
AppData/Local/winget-configuration-chezmoi/*.{e,ep}.winget*
{{- end }}

{{- if or (not .isPersonal) (not .applyOSConfig) (not .adminRights) }}
# Skip Windows PWAs: personal-only, and PWAsForFirefox is only installed by the winget
# configuration, which needs admin rights. On macOS and Ubuntu, the playbooks install them.
AppData/Local/WindowsWorkstationDSC/pwas.json
.chezmoiscripts/41-windows/pwa-install.ps1
{{- end }}

{{- if ne .computerModel "Late 2025 Gaming Desktop" }}
AppData/Local/winget-configuration-chezmoi/*late2025gamingdesktop.*.winget*
{{- end }}

{{- if eq .applyOSConfig false }}
{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/40-windows/winget-configure.ps1
.chezmoiscripts/40-windows/office-install.ps1
.chezmoiscripts/42-windows/taskbar-pins.ps1
.chezmoiscripts/42-windows/tray-pins.ps1
.chezmoiscripts/42-windows/desktop-icons.ps1
.chezmoiscripts/42-windows/pins-autostart.ps1
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
# Skip applying Ansible playbook
.chezmoiscripts/30-macos/ansible-configure.sh
# Skip installing macOS configuration profiles
.chezmoiscripts/30-macos/profiles-importer.sh
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# Skip the Ansible playbook and applying it
.local/share/ansible-configuration-chezmoi/**
.chezmoiscripts/10-linux/ansible-configure.sh
{{- end }}
# Skip the setup checklist (its manual steps only apply once the rest of the OS config has run)
.chezmoiscripts/91-all/setup-checklist.py
{{- end }}
