# Ignore files that are processed by scripts
.scriptdata/**

{{- if .isNixos }}
# Ignore on NixOS, whose flake handles OS configuration and updates
.local/share/ansible-configuration-chezmoi/**
.config/mpm/**
.config/systemd/**
.local/libexec/**
{{- end }}

{{- if .isDevcontainer }}
# Ignore in devcontainers, which the project's devcontainer.json provisions
.chezmoiscripts/**
{{- end }}

{{- if or .isWorkstation .isNixos }}
# Ignore where OS package lists provide the dotfiles' tools: workstations and NixOS
.config/mise/conf.d/dotfiles-tools.toml
{{- end }}

{{- /* Script folders are named <order>-<platform>[-<scope>], as the README in the scripts folder
explains, so these rules match folders rather than individual scripts */}}
# Ignore scripts for other platforms
{{- if ne .chezmoi.os "linux" }}
.chezmoiscripts/*-linux*/**
{{- end }}
{{- if not .isUbuntuDesktop }}
.chezmoiscripts/*-ubuntu*/**
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
.chezmoiscripts/*-macos*/**
{{- end }}
{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/*-windows*/**
{{- else }}
.chezmoiscripts/*-posix*/**
{{- end }}
# Ignore scripts for scopes this machine doesn't have
{{- if not .isWorkstation }}
.chezmoiscripts/*-workstation/**
{{- end }}
{{- if not (and .applyOSConfig .isWorkstation) }}
.chezmoiscripts/*-osconfig/**
{{- end }}

{{- if not .isWorkstation }}
# Ignore on machines other than workstations (servers, devcontainers, and WSL)
## Global mise tools, which only workstations need
.config/mise/conf.d/tools.toml
## Desktop apps' config and data
.config/ghostty/**
obsidian/**
Pictures/**
## mpm-plan, which reports pending updates as desktop notifications
.config/mpm/**
.config/systemd/**
.local/libexec/**
{{- end }}

{{- if eq .chezmoi.os "linux" }}
# Ignore on Linux
## macOS folders
Library/**
.config/swiftbar/**
## Windows folders/files
AppData/**
Documents/**
.wslconfig
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Ignore on macOS
## Linux folders
.config/mpm/**
.config/systemd/**
.local/libexec/**
.local/share/ansible-configuration-chezmoi/**
## Windows folders/files
AppData/**
Documents/**
.wslconfig
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Ignore on Windows
## Ghostty
.config/ghostty/**
## Linux folders
.config/mpm/**
.config/systemd/**
.local/libexec/**
.local/share/ansible-configuration-chezmoi/**
## macOS folders
Library/**
.config/swiftbar/**
## Sheldon config
.config/sheldon/**
## SSH
.ssh/**
## Zsh
.zshenv
.config/zsh/**
{{- end }}

{{- if eq .isPersonal false }}
# Personal Configuration
git/gh/**
## Skip winget configuration tagged as personal
AppData/Local/winget-configuration-chezmoi/*.{p,ep}.winget*
.chezmoiscripts/40-windows-osconfig/office-install.ps1
## Skip ansible var files tagged as personal
Library/Application Support/ansible-configuration-chezmoi/group_vars/all/*.p.yml*
.local/share/ansible-configuration-chezmoi/group_vars/all/*.p.yml*
{{- end }}

{{- if eq .adminRights false }}
# Skip winget configuration tagged as needed elevation
AppData/Local/winget-configuration-chezmoi/*.{e,ep}.winget*
{{- end }}

{{- if or (not .isPersonal) (not .applyOSConfig) (not .adminRights) }}
# Skip Windows PWAs: personal-only, and PWAsForFirefox is only installed by the winget
# configuration, which needs admin rights. On macOS and Ubuntu, the playbooks install them.
AppData/Local/WindowsWorkstationDSC/pwas.json
.chezmoiscripts/41-windows-osconfig/pwa-install.ps1
{{- end }}

{{- if ne .computerModel "Late 2025 Gaming Desktop" }}
AppData/Local/winget-configuration-chezmoi/*late2025gamingdesktop.*.winget*
{{- end }}

{{- if and (eq .chezmoi.os "linux") (not .applyOSConfig) }}
# Skip the Ansible playbook, which applying OS configuration runs
.local/share/ansible-configuration-chezmoi/**
{{- end }}
