## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  # Runs WindowsWorkstationDSC/mpm-plan.ps1 every 30 days to cache pending winget updates (or at the
  # next opportunity, if the machine was off). A Scheduled Task (not a Run key) because of the
  # repeating trigger. Registered for the current user with limited rights, so no elevation is
  # needed and toasts reach the user's session.
  # A console window still flashes each run: with Windows Terminal as the default terminal,
  # -WindowStyle Hidden can't hide it. Known workarounds (e.g. conhost --headless) are flagged by
  # security software, so the flash is accepted.
  - type: Microsoft.DSC.Transitional/RunCommandOnSet
    name: MpmPlanScheduledTask
    properties:
      executable: pwsh
      arguments:
        - -NoProfile
        - -NoLogo
        - -Command
        - |
          $ErrorActionPreference = 'Stop'
          $Script = Join-Path $env:LOCALAPPDATA 'WindowsWorkstationDSC\mpm-plan.ps1'
          $Action = New-ScheduledTaskAction -Execute (Get-Command pwsh).Source -Argument "-NoProfile -WindowStyle Hidden -File `"$Script`""
          $Trigger = New-ScheduledTaskTrigger -Daily -DaysInterval 30 -At 09:00
          $Principal = New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive -RunLevel Limited
          $Settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
          Register-ScheduledTask -TaskName 'mpm-plan' -Action $Action -Trigger $Trigger -Principal $Principal -Settings $Settings -Force | Out-Null
