## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  # Persists every variable from the shared env var data (the same list Zsh exports) as a real,
  # user-scoped Windows environment variable under HKCU\Environment, so PowerShell, GUI apps, cmd,
  # Git Bash, and everything else see them. Registry writes here don't broadcast
  # WM_SETTINGCHANGE, so already-running processes (including Explorer, and anything it later
  # launches) won't see a change until the next logoff/logon or reboot.
  #
  # Values are fully resolved here rather than stored as %VAR% references, since Windows doesn't
  # reliably expand one user variable inside another. Removing a variable from the data file
  # doesn't delete it from the registry.
{{- $resolved := dict }}
{{- range concat .env_vars_core .env_vars_apps }}
{{- $value := "" }}
{{- if get . "value" }}
{{- $value = .value }}
{{- else if get . "path_part1" }}
{{- $baseName := trimPrefix "$" .path_part1 }}
{{- if not (hasKey $resolved $baseName) }}
{{- fail (printf "%s: path_part1 %s must name a variable defined earlier in the env var data" .name .path_part1) }}
{{- end }}
{{- $value = joinPath (get $resolved $baseName) .path_part2 (get . "path_part3") (get . "path_part4") }}
{{- else if get . "home_subpath_part1" }}
{{- $value = joinPath $.chezmoi.homeDir (get . "home_subpath_part1") (get . "home_subpath_part2") (get . "home_subpath_part3") (get . "home_subpath_part4") }}
{{- end }}
{{- $_ := set $resolved .name $value }}
  - type: Microsoft.Windows/Registry
    name: {{ .name | replace "_" "" }}
    properties:
      keyPath: HKEY_CURRENT_USER\Environment
      valueName: {{ .name }}
      valueData:
        String: '{{ $value | replace "'" "''" }}'
      _exist: true
{{- end }}
