## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  # Force-installs the Proton Pass extension in Edge; users can't remove it. On devices that aren't
  # domain joined, force-install only works for extensions from the Edge Add-ons store.
  # ExtensionInstallForcelist values are numbered; the value name is just a list index and the data is
  # "<extension id>;<update url>" (here, Edge's Add-ons store).
  - type: Microsoft.Windows/Registry
    name: EdgeProtonPassExtensionForcelist
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist
      valueName: "1"
      valueData:
        String: gcllgfdnfnllodcaambdaknbipemelie;https://edge.microsoft.com/extensionwebstorebase/v1/crx
      _exist: true
