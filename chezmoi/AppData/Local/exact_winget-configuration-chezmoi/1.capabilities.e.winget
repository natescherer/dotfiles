## WARNING: This file is chezmoi-managed and should not be manually edited!

# Capabilities (Features on Demand) download from Windows Update, so like optional features they
# take a while and are worth getting out of the way early

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    name: WindowsCapabilities
    metadata:
      description: >-
        Stands in for Microsoft.Windows/FeatureOnDemandList, which fails under the Appx-packaged
        DSC that winget configure uses: DISM's dismhost.exe starts outside the package, so the
        packaged caller can't see the COM class it registers (REGDB_E_CLASSNOTREG). Windows
        PowerShell (powershell.exe in System32) is never packaged, so it and dismhost.exe both
        run outside the package. PowerShell 7.7+ ships only as MSIX, which rules out
        PowerShellScript (pwsh) for the same reason. Each input entry takes the native resource's
        properties: identity, the capability's full name including its ~~~~version suffix (see
        Get-WindowsCapability -Online), and state (Installed or NotPresent). Pending states
        count as done; a capability that needs a reboot sets the CBS RebootPending key, which
        the apply script checks after every run. The resource always runs setScript without
        consulting testScript, so setScript skips capabilities already in their desired state,
        and it checks every entry before changing any.
      winget:
        securityContext: elevated
    properties:
      input:
        # Device discovery and Windows Device Portal. Turning on Developer Mode in Settings
        # installs this, but the WindowsSettings resource only sets its registry value.
        - identity: Tools.DeveloperMode.Core~~~~0.0.1.0
          state: Installed
      getScript: |
        param([object[]] $Capabilities)
        $States = @{}
        Get-WindowsCapability -Online | ForEach-Object { $States[$_.Name] = $_.State.ToString() }
        $Result = [ordered]@{}
        foreach ($C in $Capabilities) { $Result[$C.identity] = if ($States[$C.identity]) { $States[$C.identity] } else { 'NotFound' } }
        [pscustomobject]$Result
      testScript: |
        param([object[]] $Capabilities)
        $Satisfied = @{ Installed = @('Installed', 'InstallPending'); NotPresent = @('NotPresent', 'Removed', 'UninstallPending') }
        foreach ($C in $Capabilities) { if (-not $Satisfied.ContainsKey([string]$C.state)) { throw "$($C.identity): state must be Installed or NotPresent, not '$($C.state)'" } }
        $States = @{}
        Get-WindowsCapability -Online | ForEach-Object { $States[$_.Name] = $_.State.ToString() }
        @($Capabilities | Where-Object { $States[$_.identity] -notin $Satisfied[[string]$_.state] }).Count -eq 0
      setScript: |
        param([object[]] $Capabilities)
        $Satisfied = @{ Installed = @('Installed', 'InstallPending'); NotPresent = @('NotPresent', 'Removed', 'UninstallPending') }
        foreach ($C in $Capabilities) { if (-not $Satisfied.ContainsKey([string]$C.state)) { throw "$($C.identity): state must be Installed or NotPresent, not '$($C.state)'" } }
        $States = @{}
        Get-WindowsCapability -Online | ForEach-Object { $States[$_.Name] = $_.State.ToString() }
        $Unknown = @($Capabilities | Where-Object { -not $States.ContainsKey($_.identity) } | ForEach-Object { $_.identity })
        if ($Unknown.Count -gt 0) { throw "Not capabilities on this system (names include a ~~~~version suffix; see Get-WindowsCapability -Online): $($Unknown -join ', ')" }
        foreach ($C in $Capabilities) {
          if ($States[$C.identity] -in $Satisfied[[string]$C.state]) { continue }
          if ($C.state -eq 'Installed') {
            Write-Verbose "Adding capability $($C.identity)"
            $null = Add-WindowsCapability -Online -Name $C.identity
          }
          else {
            Write-Verbose "Removing capability $($C.identity)"
            $null = Remove-WindowsCapability -Online -Name $C.identity
          }
        }
        Get-WindowsCapability -Online | ForEach-Object { $States[$_.Name] = $_.State.ToString() }
        $Result = [ordered]@{}
        foreach ($C in $Capabilities) { $Result[$C.identity] = $States[$C.identity] }
        [pscustomobject]$Result
