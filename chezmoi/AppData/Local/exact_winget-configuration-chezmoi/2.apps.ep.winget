## WARNING: This file is chezmoi-managed and should not be manually edited!

# Microsoft 365 is deliberately NOT installed here via Microsoft.WinGet/Package. The winget-pkgs
# manifest pins a SHA256 against officecdn.microsoft.com's setup.exe, which Microsoft rotates
# independently of the manifest, so installs intermittently fail with "Package hash verification
# failed" until the manifest catches up. It's installed instead by
# .chezmoiscripts/40-windows/run_onchange_after_office-install.ps1, which drives the Office
# Deployment Tool directly against that same setup.exe with no hash pinned against it.

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.WinGet/Package
    name: AdobeCreativeCloud
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Adobe.CreativeCloud
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: DockerDesktop
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Docker.DockerDesktop
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: FirefoxPWA
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: filips.FirefoxPWA
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: Obsidian
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Obsidian.Obsidian
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: Paprika
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: PaprikaApp.Paprika.3
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: ProtonVPN
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Proton.ProtonVPN
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: Thunderbird
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Mozilla.Thunderbird
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: TickTick
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Appest.TickTick
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: WinRAR
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: RARLab.WinRAR
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: YubicoAuthenticator
    metadata:
      winget:
        securityContext: elevated
    properties:
      id: Yubico.Authenticator
      source: winget
      installMode: silent
