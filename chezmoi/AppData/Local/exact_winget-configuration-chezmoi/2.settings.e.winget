## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  # Developer Mode: allows sideloading unsigned app packages and creating symlinks without elevation.
  # DeveloperMode writes HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock (machine-wide),
  # so only this property needs elevation -- the other WindowsSettings properties (in
  # 2.settings.a.winget) write to per-user HKCU keys instead and don't.
  - type: Microsoft.Windows.Settings/WindowsSettings
    name: WindowsSettingsDeveloperMode
    metadata:
      winget:
        securityContext: elevated
    properties:
      DeveloperMode: true
  # Policy "Turn off display of recent search entries in the File Explorer search box"; it also stops
  # Start menu search from showing Bing web results. A per-user policy key, which only accepts
  # elevated writes.
  - type: Microsoft.Windows/Registry
    name: DisableBingSearchInStart
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Windows\Explorer
      valueName: DisableSearchBoxSuggestions
      valueData:
        DWord: 1
      _exist: true
  # Both values cap diagnostic data at Required only. Levels: 0 Security, 1 Required, 2 Enhanced,
  # 3 Optional.
  - type: Microsoft.Windows/Registry
    name: DisableOptionalDiagnosticDataAllowTelemetry
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection
      valueName: AllowTelemetry
      valueData:
        DWord: 1
      _exist: true
  - type: Microsoft.Windows/Registry
    name: DisableOptionalDiagnosticDataMaxTelemetryAllowed
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection
      valueName: MaxTelemetryAllowed
      valueData:
        DWord: 1
      _exist: true
  # Policy "Turn off app notifications on the lock screen"; with it on, the lock screen's weather and
  # more widgets are suppressed too.
  - type: Microsoft.Windows/Registry
    name: DisableWeatherAndMoreOnLockScreen
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System
      valueName: DisableLockScreenAppNotifications
      valueData:
        DWord: 1
      _exist: true
  # The Edge new tab page policies below work on unmanaged devices (unlike NewTabPageLocation, which
  # needs a domain-joined, Entra-joined, or MDM-enrolled device). The two commented-out ones strip the
  # page further, down to roughly a search box.
  #
  # No background image (3 = disable all types, including Bing's image of the day).
  # - type: Microsoft.Windows/Registry
  #   name: EdgeNewTabBackground
  #   metadata:
  #     winget:
  #       securityContext: elevated
  #   properties:
  #     keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
  #     valueName: NewTabPageAllowedBackgroundTypes
  #     valueData:
  #       DWord: 3
  #     _exist: true
  # Removes the Microsoft news feed and locks the page layout to Custom with content off.
  - type: Microsoft.Windows/Registry
    name: EdgeNewTabContent
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
      valueName: NewTabPageContentEnabled
      valueData:
        DWord: 0
      _exist: true
  # Hides the quick links tiles.
  # - type: Microsoft.Windows/Registry
  #   name: EdgeNewTabQuickLinks
  #   metadata:
  #     winget:
  #       securityContext: elevated
  #   properties:
  #     keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
  #     valueName: NewTabPageQuickLinksEnabled
  #     valueData:
  #       DWord: 0
  #     _exist: true
  # HideFirstRunExperience skips Edge's first-run (out-of-box) setup screens.
  - type: Microsoft.Windows/Registry
    name: EdgeOOBE
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge
      valueName: HideFirstRunExperience
      valueData:
        DWord: 1
      _exist: true
  # AllowMUUpdateService (Microsoft Update): "Receive updates for other Microsoft products".
  - type: Microsoft.Windows/Registry
    name: EnableUpdatesForOtherMicrosoftProducts
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
      valueName: AllowMUUpdateService
      valueData:
        DWord: 1
      _exist: true
  # Lifts the 260-character MAX_PATH limit for apps that opt in through their manifest.
  - type: Microsoft.Windows/Registry
    name: LongPaths
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem
      valueName: LongPathsEnabled
      valueData:
        DWord: 1
      _exist: true
  # Windows sudo mode: 0 disabled, 1 new window, 2 input disabled, 3 inline.
  - type: Microsoft.Windows/Registry
    name: Sudo
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo
      valueName: Enabled
      valueData:
        DWord: 3
      _exist: true
  # "Allow Widgets" policy (the Dsh key); 0 disables the Widgets board and its taskbar entry.
  - type: Microsoft.Windows/Registry
    name: WidgetServiceOff
    metadata:
      winget:
        securityContext: elevated
    properties:
      keyPath: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Dsh
      valueName: AllowNewsAndInterests
      valueData:
        DWord: 0
      _exist: true
