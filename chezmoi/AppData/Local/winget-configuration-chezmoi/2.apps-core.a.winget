## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.WinGet/Package
    name: Brave
    properties:
      id: Brave.Brave
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: chezmoi
    properties:
      id: twpayne.chezmoi
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: delta
    properties:
      id: dandavison.delta
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: fzf
    properties:
      id: junegunn.fzf
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: micro
    properties:
      id: zyedidia.micro
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: mise
    properties:
      id: jdx.mise
      source: winget
      installMode: silent
  # trustedRepository avoids needing a separate Microsoft.PowerShell.PSResourceGet/Repository
  # resource just for this -- PSGallery is trusted globally (persisted to the PSResourceRepository
  # store, not just this process) by TrustPSGallery in 2.pwsh.a.winget, but that file runs after
  # this one (alphabetically "apps-core" < "pwsh"), so this resource can't rely on it yet.
  - type: Microsoft.PowerShell.PSResourceGet/PSResourceList
    name: PSFzf
    properties:
      repositoryName: PSGallery
      trustedRepository: true
      resources:
        - name: PSFzf
          version: "2.5.14"
  - type: Microsoft.WinGet/Package
    name: VSCode
    properties:
      id: Microsoft.VisualStudioCode
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: VSCodium
    properties:
      id: VSCodium.VSCodium
      source: winget
      installMode: silent
  - type: Microsoft.WinGet/Package
    name: WindowsApp
    properties:
      id: Microsoft.WindowsApp
      source: winget
      installMode: silent
