## WARNING: This file is chezmoi-managed and should not be manually edited!

# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.DSC.Transitional/PowerShellScript
    name: InstallFonts
    metadata:
      description: >-
        Discovers fonts under .local/share/chezmoifonts at winget-configure execution time
        (Get-ChildItem), not chezmoi template-render time. This file used to be a .tmpl that
        globbed that directory while chezmoi rendered it, but this file and the
        .chezmoiexternal.toml.tmpl downloads that populate that directory are both regular
        chezmoi targets applied in the same pass, with no guaranteed ordering between them --
        so on a fresh machine the template sometimes rendered before the fonts were actually
        downloaded, globbed an empty directory, and produced an empty (schema-invalid)
        resources list. Discovering fonts when this script actually runs (always after all
        files are applied) sidesteps that ordering race entirely -- and means this file no
        longer needs to be a template at all. The registry value name is read
        from each font's own name table (family + style), matching what right-click "Install"
        does, rather than derived from the filename. Installs per-user (into
        %LOCALAPPDATA%\Microsoft\Windows\Fonts and HKCU, not %windir%\Fonts and HKLM) so this
        needs no elevation -- the same distinction Explorer's right-click "Install" (per-user)
        makes versus "Install for all users" (elevated). Runs via PowerShellScript (pwsh), not
        WindowsPowerShellScript -- nothing here (Add-Type -AssemblyName PresentationCore/GlyphTypeface,
        registry cmdlets, Copy-Item) requires Windows PowerShell 5.1; verified PresentationCore
        loads identically under both hosts.
    properties:
      getScript: |
        $FontsDir = Join-Path $HOME '.local' 'share' 'chezmoifonts'
        $UserFontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft' 'Windows' 'Fonts'
        $Files = @()
        if (Test-Path $FontsDir) {
          $Files = @(Get-ChildItem -Path $FontsDir -Include '*.otf', '*.ttf' -File -Recurse -ErrorAction SilentlyContinue)
        }
        Add-Type -AssemblyName PresentationCore
        $InstalledCount = 0
        foreach ($File in $Files) {
          $TypeLabel = if ($File.Extension -eq '.ttf') { 'TrueType' } else { 'OpenType' }
          $Glyph = New-Object System.Windows.Media.GlyphTypeface($File.FullName)
          $Family = $Glyph.Win32FamilyNames['en-US']
          if (-not $Family) { $Family = ($Glyph.Win32FamilyNames.Values | Select-Object -First 1) }
          $Face = $Glyph.Win32FaceNames['en-US']
          if (-not $Face) { $Face = ($Glyph.Win32FaceNames.Values | Select-Object -First 1) }
          $RegistryName = if ($Face -and $Face -ne 'Regular') { "$Family $Face ($TypeLabel)" } else { "$Family ($TypeLabel)" }
          $DestPath = Join-Path $UserFontsDir $File.Name
          $FileOk = Test-Path $DestPath
          $RegValue = (Get-ItemProperty -Path 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $RegistryName -ErrorAction SilentlyContinue).$RegistryName
          if ($FileOk -and ($RegValue -eq $DestPath)) { $InstalledCount++ }
        }
        return @{ FontsFound = $Files.Count; FontsInstalled = $InstalledCount }
      testScript: |
        $FontsDir = Join-Path $HOME '.local' 'share' 'chezmoifonts'
        $UserFontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft' 'Windows' 'Fonts'
        $Files = @()
        if (Test-Path $FontsDir) {
          $Files = @(Get-ChildItem -Path $FontsDir -Include '*.otf', '*.ttf' -File -Recurse -ErrorAction SilentlyContinue)
        }
        if ($Files.Count -eq 0) { return $true }
        Add-Type -AssemblyName PresentationCore
        foreach ($File in $Files) {
          $TypeLabel = if ($File.Extension -eq '.ttf') { 'TrueType' } else { 'OpenType' }
          $Glyph = New-Object System.Windows.Media.GlyphTypeface($File.FullName)
          $Family = $Glyph.Win32FamilyNames['en-US']
          if (-not $Family) { $Family = ($Glyph.Win32FamilyNames.Values | Select-Object -First 1) }
          $Face = $Glyph.Win32FaceNames['en-US']
          if (-not $Face) { $Face = ($Glyph.Win32FaceNames.Values | Select-Object -First 1) }
          $RegistryName = if ($Face -and $Face -ne 'Regular') { "$Family $Face ($TypeLabel)" } else { "$Family ($TypeLabel)" }
          $DestPath = Join-Path $UserFontsDir $File.Name
          $FileOk = Test-Path $DestPath
          $RegValue = (Get-ItemProperty -Path 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $RegistryName -ErrorAction SilentlyContinue).$RegistryName
          if (-not ($FileOk -and ($RegValue -eq $DestPath))) { return $false }
        }
        return $true
      setScript: |
        $FontsDir = Join-Path $HOME '.local' 'share' 'chezmoifonts'
        if (-not (Test-Path $FontsDir)) { return }
        $UserFontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft' 'Windows' 'Fonts'
        if (-not (Test-Path $UserFontsDir)) { New-Item -Path $UserFontsDir -ItemType Directory -Force | Out-Null }
        $Files = @(Get-ChildItem -Path $FontsDir -Include '*.otf', '*.ttf' -File -Recurse -ErrorAction SilentlyContinue)
        Add-Type -AssemblyName PresentationCore
        # Copying the file and writing the registry value (what the rest of this loop does) is only
        # half of what Explorer's right-click "Install" does -- that's enough for a *future* logon
        # session to pick the font up, but the already-running session's in-memory GDI font table
        # doesn't know about it until AddFontResourceW registers it there too, and already-open apps
        # (which may have cached their font list at startup) won't re-check until they get a
        # WM_FONTCHANGE broadcast. Without both, the file and registry entry are correct but the font
        # stays invisible in every app's font picker until the next logon.
        Add-Type -Language CSharp 'using System; using System.Runtime.InteropServices; public static class ChezmoiFontNotify { [DllImport("gdi32.dll", CharSet = CharSet.Unicode, SetLastError = true)] public static extern int AddFontResourceW(string lpFileName); [DllImport("user32.dll", CharSet = CharSet.Unicode, SetLastError = true)] public static extern IntPtr SendMessageTimeoutW(IntPtr hWnd, uint Msg, UIntPtr wParam, IntPtr lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult); }'
        $AnyInstalled = $false
        foreach ($File in $Files) {
          $TypeLabel = if ($File.Extension -eq '.ttf') { 'TrueType' } else { 'OpenType' }
          $Glyph = New-Object System.Windows.Media.GlyphTypeface($File.FullName)
          $Family = $Glyph.Win32FamilyNames['en-US']
          if (-not $Family) { $Family = ($Glyph.Win32FamilyNames.Values | Select-Object -First 1) }
          $Face = $Glyph.Win32FaceNames['en-US']
          if (-not $Face) { $Face = ($Glyph.Win32FaceNames.Values | Select-Object -First 1) }
          $RegistryName = if ($Face -and $Face -ne 'Regular') { "$Family $Face ($TypeLabel)" } else { "$Family ($TypeLabel)" }
          $DestPath = Join-Path $UserFontsDir $File.Name
          $FileOk = Test-Path $DestPath
          $RegValue = (Get-ItemProperty -Path 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $RegistryName -ErrorAction SilentlyContinue).$RegistryName
          if ($FileOk -and ($RegValue -eq $DestPath)) { continue }
          Write-Host "Installing font: $($File.Name) as '$RegistryName'..."
          Copy-Item -Path $File.FullName -Destination $DestPath -Force
          # HKLM's system-wide font entries store a bare filename, which Windows resolves against
          # the hardcoded %windir%\Fonts -- HKCU per-user entries have no such implicit folder, so
          # Windows only resolves them when the value is the font's full path.
          New-ItemProperty -Path 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -Name $RegistryName -Value $DestPath -PropertyType String -Force | Out-Null
          [void][ChezmoiFontNotify]::AddFontResourceW($DestPath)
          $AnyInstalled = $true
        }
        if ($AnyInstalled) {
          # HWND_BROADCAST/WM_FONTCHANGE, with a timeout so one unresponsive top-level window can't
          # hang this script -- the same signal Explorer itself sends after installing a font.
          $Result = [UIntPtr]::Zero
          [void][ChezmoiFontNotify]::SendMessageTimeoutW([IntPtr]0xffff, 0x1D, [UIntPtr]::Zero, [IntPtr]::Zero, 2, 1000, [ref]$Result)
        }
