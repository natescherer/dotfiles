## WARNING: This file is chezmoi-managed and should not be manually edited!

# Set up shell completions
[ -d "$XDG_CACHE_HOME"/zsh ] || mkdir -p "$XDG_CACHE_HOME"/zsh
autoload -Uz compinit
zcompdump="$XDG_CACHE_HOME"/zsh/zcompdump-$ZSH_VERSION
if [[ $(date +'%Y%j') == $(date -r "$zcompdump" +'%Y%j' 2>/dev/null) ]]; then
  compinit -C -d "$zcompdump"
else
  compinit -d "$zcompdump"
fi
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME"/zsh/zcompcache

# Set history options
[ -d "$XDG_STATE_HOME"/zsh ] || mkdir -p "$XDG_STATE_HOME"/zsh
HISTFILE="$XDG_STATE_HOME"/zsh/history
SAVEHIST=9000
HISTSIZE=9999                   # set HISTSIZE > SAVEHIST
setopt EXTENDED_HISTORY         # include timestamp
setopt HIST_BEEP                # beep if attempting to access a history entry which isn’t there
setopt HIST_EXPIRE_DUPS_FIRST   # trim dupes first if history is full
setopt HIST_FIND_NO_DUPS        # do not display previously found command
setopt HIST_IGNORE_ALL_DUPS     # remove older dupe when a repeated command is added
setopt HIST_IGNORE_DUPS         # do not save duplicate of prior command
setopt HIST_IGNORE_SPACE        # do not save if line starts with space
setopt HIST_NO_STORE            # do not save history commands
setopt HIST_REDUCE_BLANKS       # strip superfluous blanks
setopt HIST_SAVE_NO_DUPS        # do not write duplicate entries to the history file
setopt INC_APPEND_HISTORY       # don't wait for shell to exit to save history lines

# Source aliases
source ${ZDOTDIR}/.zsh-aliases

# Source local aliases (if present)
[[ -r ${ZDOTDIR}/.zsh-aliases-local ]] && source ${ZDOTDIR}/.zsh-aliases-local

{{ if findExecutable "brew" (list "/opt/homebrew/bin" "/home/linuxbrew/.linuxbrew/bin") -}}
# Activate Homebrew
eval "$({{ findExecutable "brew" (list "/opt/homebrew/bin" "/home/linuxbrew/.linuxbrew/bin") }} shellenv)"

{{ end -}}
{{ if lookPath "mise" -}}
# Activate mise
eval "$(mise activate zsh)"

{{ end -}}
# Activate Starship
eval "$(starship init zsh)"

# Activate sheldon
eval "$(sheldon source)"

# Activate fzf
source <(fzf --zsh)
