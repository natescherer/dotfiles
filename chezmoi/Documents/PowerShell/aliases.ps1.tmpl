#Requires -Version 7.0

function Invoke-LsWithOptions {
    $lsPath = (Get-Command ls -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1).Source
    if (-not $lsPath) {
        Write-Error "ll: no 'ls' executable found on PATH"
        return
    }
    & $lsPath -AFGhl --group-directories-first --color=auto @args
}

function mkdircd([string]$Path) {
    mkdir $Path
    cd $Path
}

Set-Alias -Name cl -Value clear
Set-Alias -Name k -Value kubectl
Set-Alias -Name ll -Value Invoke-LsWithOptions
