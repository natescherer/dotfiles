## WARNING: This file is chezmoi-managed and should not be manually edited!

#Requires -Version 7.0

# PATH additions
$env:PATH = "$env:PATH;{{ joinPath .chezmoi.homeDir "bin" }}"


# Fix weird formatting in Get-ChildItem Output
$PSStyle.Formatting.CustomTableHeaderLabel = $PSStyle.Formatting.TableHeader

# Import environment variables
. $(Join-Path $PSScriptRoot "env.ps1")

# Import aliases
. $(Join-Path $PSScriptRoot "aliases.ps1")

# Import local aliases (if present)
if (Test-Path $(Join-Path $PSScriptRoot "aliases-local.ps1")) {
  . $(Join-Path $PSScriptRoot "aliases-local.ps1")
}

# Runtime checks (not template-time {{"{{"}} if lookPath }} gates): winget configure installs
# mise and Starship later in the same chezmoi apply run, so a template-time check would
# bake in "not found" on a fresh machine and require a second apply to pick it up. Checking
# at the moment each shell starts means it self-heals as soon as each tool lands on PATH.

# Activate mise
if (Get-Command mise -ErrorAction SilentlyContinue) {
  mise activate pwsh | Out-String | Invoke-Expression
}

# Activate Starship
if (Get-Command starship -ErrorAction SilentlyContinue) {
  Invoke-Expression (&starship init powershell)
}

# Activate PSFzf (Ctrl+T file search, Ctrl+R history search, fuzzy tab completion --
# mirrors the zsh setup's fzf-tab + fzf --zsh)
if (Get-Module -ListAvailable -Name PSFzf) {
  Import-Module PSFzf
  Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t' -PSReadlineChordReverseHistory 'Ctrl+r'
  Set-PsFzfOption -TabExpansion
}
{{- if eq .chezmoi.os "windows" }}

# Surface how many updates the mpm-plan Scheduled Task found (it only checks; installing is manual)
& {
  $CacheDir = Join-Path $env:LOCALAPPDATA 'mpm-plan'
  $ErrorFile = Join-Path $CacheDir 'plan.error'
  if (Test-Path $ErrorFile) {
    Write-Host "$($PSStyle.Foreground.Red)$($PSStyle.Bold)⚠ mpm-plan check failed$($PSStyle.Reset) $($PSStyle.Foreground.BrightBlack)($((Get-Content $ErrorFile -Raw).Trim()))$($PSStyle.Reset)"
    return
  }

  $PlanFile = Join-Path $CacheDir 'plan.json'
  if (-not (Test-Path $PlanFile)) { return }
  $Total = try {
    (Get-Content $PlanFile -Raw | ConvertFrom-Json).PSObject.Properties.Value |
      ForEach-Object { @($_.packages).Count } | Measure-Object -Sum | Select-Object -ExpandProperty Sum
  } catch { 0 }
  if ($Total -le 0) { return }
  $LastChecked = (Get-Item $PlanFile).LastWriteTime.ToString('ddd HH:mm')
  Write-Host "$($PSStyle.Foreground.Yellow)$($PSStyle.Bold)↑ $Total update(s) available$($PSStyle.Reset) $($PSStyle.Foreground.BrightBlack)· last checked $LastChecked$($PSStyle.Reset)"
  Write-Host "$($PSStyle.Foreground.BrightBlack)  Run 'mpm sync && mpm outdated' to review them and 'mpm upgrade' to install them$($PSStyle.Reset)"
}
{{- end }}
