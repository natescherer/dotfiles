{{- else if get . "path_part1" }}
$env:{{ .name }} = "{{ joinPath (.path_part1 | replace "$" "$env:") .path_part2 (get . "path_part3") (get . "path_part4") }}"{{ if get . "comment" }} # {{ .comment }}{{ end }}
{{- else if get . "home_subpath_part1" }}
