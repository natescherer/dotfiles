---
# PWAs to install in ungoogled-chromium via WebAppInstallForceList policy. Sourced from
# .chezmoidata/pwas.toml, shared with the Windows winget PWA provisioning
# so both platforms force-install the same list.
#
# Name and icon come from the site's web app manifest — don't set
# custom_name/custom_icon here. If Chromium's hidden background install
# can't load the page, it installs a URL-named placeholder app (that's
# what once produced `https/www.youtube.com.app` with no icon); the
# chromium_pwas role detects placeholders and navigates a real tab to the
# install URL, which makes Chromium swap in the real manifest-derived app.
# {{ $pwas := list }}{{ range .pwas.entries }}{{ if not (has "darwin" (index . "ignore_on" | default list)) }}{{ $pwas = append $pwas (omit . "ignore_on") }}{{ end }}{{ end }}
chromium_web_apps:
{{ $pwas | toYaml | trimSuffix "\n" | indent 2 }}
