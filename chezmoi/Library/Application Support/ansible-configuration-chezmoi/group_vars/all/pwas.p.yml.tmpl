---
# PWAs to install in ungoogled-chromium via WebAppInstallForceList policy. Sourced from
# .chezmoidata/pwas.toml (see its header for custom_name/placeholder-repair details), shared with
# the Windows winget PWA provisioning so both platforms force-install the same list.
# Personal-only: excluded on non-personal machines via .chezmoiignore.tmpl.
# {{ $pwas := list }}{{ range .pwas.entries }}{{ if not (has "darwin" (index . "ignore_on" | default list)) }}{{ $pwas = append $pwas (omit . "ignore_on") }}{{ end }}{{ end }}
chromium_web_apps:
{{ $pwas | toYaml | trimSuffix "\n" | indent 2 }}
