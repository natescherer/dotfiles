{{- /* #region Fixed values: the same on every machine */ -}}

# COPIER-ME
{{- $editor := "micro" }}
# COPIER-ME
{{- $gitName := "Nate Scherer" }}

{{- /* #endregion */}}

{{- /* #region Detected values: read from the machine, with no prompts */}}

{{- /* Containers on Docker Desktop for Windows run on WSL's kernel too, so they also match */}}
{{- $isWsl := false }}
{{- if eq .chezmoi.os "linux" }}
{{- if .chezmoi.kernel.osrelease | default "" | lower | contains "microsoft" }}
{{- $isWsl = true }}
{{- end }}
{{- end }}

{{- /* The Linux playbook targets Ubuntu 26.04 Desktop only: not WSL, servers, or other distros */}}
{{- $isUbuntuDesktop := false }}
{{- if eq .chezmoi.os "linux" }}
{{- if and (eq (.chezmoi.osRelease.id | default "") "ubuntu") (eq (.chezmoi.osRelease.versionID | default "") "26.04") (not $isWsl) (lookPath "gnome-shell") }}
{{- $isUbuntuDesktop = true }}
{{- end }}
{{- end }}

{{- /* Machines this repo has OS configuration for. Only these are asked the OS configuration
prompts, since nothing else reads their answers. */}}
{{- $hasOSConfig := or (eq .chezmoi.os "windows") (eq .chezmoi.os "darwin") $isUbuntuDesktop }}

{{- /* Whether this machine looks like a VM, the default for the isVM prompt. Checked only where
that prompt is asked. Windows' own HypervisorPresent flag is true on physical machines that run
virtualization-based security, so the check reads the manufacturer and model instead. */}}
{{- $looksLikeVM := false }}
{{- if $hasOSConfig }}
{{- if eq .chezmoi.os "windows" }}
{{- $looksLikeVM = output "powershell.exe" "-NoProfile" "-NonInteractive" "-Command" "$c = Get-CimInstance Win32_ComputerSystem; \"$($c.Manufacturer) $($c.Model)\"" | regexMatch "(?i)vmware|virtual|qemu|kvm|xen|parallels" }}
{{- else if eq .chezmoi.os "darwin" }}
{{- $looksLikeVM = eq (output "sh" "-c" "sysctl -n kern.hv_vmm_present 2>/dev/null || true" | trim) "1" }}
{{- else }}
{{- /* systemd-detect-virt prints "none" and exits non-zero on bare metal, which would fail output */}}
{{- $virt := output "sh" "-c" "systemd-detect-virt --vm 2>/dev/null || true" | trim }}
{{- $looksLikeVM = not (has $virt (list "" "none")) }}
{{- end }}
{{- end }}

{{- /* NixOS is configured by its flake, which has already run by the time chezmoi does */}}
{{- $isNixos := false }}
{{- if eq .chezmoi.os "linux" }}
{{- if eq (.chezmoi.osRelease.id | default "") "nixos" }}
{{- $isNixos = true }}
{{- end }}
{{- end }}

{{- /* init-devcontainer.sh sets CHEZMOI_DEVCONTAINER; the stored value keeps a later bare `chezmoi init` from clearing it */}}
{{- $isDevcontainer := or (eq (env "CHEZMOI_DEVCONTAINER") "1") (and (hasKey . "isDevcontainer") .isDevcontainer) }}

{{- /* Whether a desktop shell is present, the default for the isWorkstation prompt */}}
{{- $hasDesktop := ne (or (lookPath "gnome-shell") (lookPath "plasmashell") (env "XDG_CURRENT_DESKTOP")) "" }}

{{- /* #endregion */}}

{{- /* #region Prompts: every question `chezmoi init` asks, each with the value used when it isn't asked */}}

# COPIER-ME
{{- $gitEmail := promptStringOnce . "gitEmail" "What email do you want to use for Git on this machine? (Enter for default)" "376408+natescherer@users.noreply.github.com" }}

{{- $isPersonal := promptBoolOnce . "isPersonal" "Is this a a personal computer? (Enter for default)" true }}

{{- /* OS configuration prompts. NixOS's flake has already applied its own OS configuration, and
other machines have none. */}}
{{- $adminRights := false }}
{{- $applyOSConfig := $isNixos }}
{{- $isVM := false }}
{{- if $hasOSConfig }}
{{- $adminRightsPrompt := "Does your regular user account have admin rights on this machine? (Enter for default)" }}
{{- $applyOSConfigPrompt := "Apply WinGet Configuration files to declaratively configure this Windows machine? (Enter for default)" }}
{{- if eq .chezmoi.os "darwin" }}
{{- $applyOSConfigPrompt = "Apply Ansible playbook to declaratively configure this Mac? (Enter for default)" }}
{{- else if eq .chezmoi.os "linux" }}
{{- $adminRightsPrompt = "Does your regular user account have sudo rights on this machine? (Enter for default)" }}
{{- $applyOSConfigPrompt = "Apply Ansible playbook to declaratively configure this Ubuntu desktop? (Enter for default)" }}
{{- end }}
{{- $adminRights = promptBoolOnce . "adminRights" $adminRightsPrompt false }}
{{- $applyOSConfig = promptBoolOnce . "applyOSConfig" $applyOSConfigPrompt false }}
{{- $isVM = promptBoolOnce . "isVM" "Is this a VM? (Enter for default)" $looksLikeVM }}
{{- end }}

{{- $computerModel := "None" }}
{{- if eq .chezmoi.os "windows" }}
{{- $computerModel = promptChoiceOnce . "computerModel" "What model is this computer? (Enter for default)" (list "Late 2025 Gaming Desktop" "None") "None" }}
{{- end }}

{{- /* Whether this is a machine you work at directly. Only workstations get desktop app config,
fonts, keyrings, and the global mise tools; servers, devcontainers, and WSL don't. Windows,
macOS, and Ubuntu desktops are always workstations; other Linux machines are asked. */}}
{{- $isWorkstation := not (or $isDevcontainer $isWsl) }}
{{- if and (eq .chezmoi.os "linux") (not $isUbuntuDesktop) $isWorkstation }}
{{- $isWorkstation = promptBoolOnce . "isWorkstation" "Is this a workstation, a desktop or laptop you work at directly? (Enter for default)" $hasDesktop }}
{{- end }}

{{- /* #endregion */}}

{{- /* #region Config: the chezmoi config file this template renders */}}

{{- if $isDevcontainer }}
# init-devcontainer.sh applies the dotfiles from VS Code's clone of this
# repo, so later chezmoi commands need to know where it is
sourceDir: {{ .chezmoi.workingTree | quote }}
{{- end }}
{{- if eq .chezmoi.os "windows" }}
cd:
    command: pwsh
{{- end }}
data:
    editor: {{ $editor }}
    gitName: {{ $gitName }}
    gitEmail: {{ $gitEmail }}
    applyOSConfig: {{ $applyOSConfig }}
    isPersonal: {{ $isPersonal }}
    adminRights: {{ $adminRights }}
    isVM: {{ $isVM }}
    isDevcontainer: {{ $isDevcontainer }}
    isWorkstation: {{ $isWorkstation }}
    isNixos: {{ $isNixos }}
    isUbuntuDesktop: {{ $isUbuntuDesktop }}
    isWsl: {{ $isWsl }}
    computerModel: {{ $computerModel | quote }}
diff:
    pager: "delta"
    exclude:
        - scripts
edit:
    command: {{ $editor }}
interpreters:
{{- if eq .chezmoi.os "windows" }}
    ps1:
        command: pwsh
{{- end }}
    # Through mise rather than a bare uv: on a first apply, mise installs uv after chezmoi has
    # already started, so uv isn't on chezmoi's own PATH yet
    py:
        command: mise
        args:
        - exec
        - --
        - uv
        - run

{{- /* #endregion */}}
